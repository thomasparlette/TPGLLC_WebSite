@page "/status"
@using System.Text.Json
@inject IWebHostEnvironment Env

<PageTitle>Status</PageTitle>

<h1>Site Status</h1>

@if (_model is null)
{
    <p>Loading...</p>
}
else
{
    <div class="status-grid">
        <div class="status-card">
            <h3>Version</h3>
            <p>@_model.Version</p>
        </div>

        <div class="status-card">
            <h3>Commit</h3>
            <p>@_model.Commit</p>
        </div>

        <div class="status-card">
            <h3>Branch</h3>
            <p>@_model.Branch</p>
        </div>

        <div class="status-card">
            <h3>Deployed</h3>
            <p>@_model.Deployed</p>
        </div>

        <div class="status-card">
            <h3>Runner</h3>
            <p>@_model.Runner</p>
        </div>

        <div class="status-card">
            <h3>Machine</h3>
            <p>@Environment.MachineName</p>
        </div>

        <div class="status-card">
            <h3>Environment</h3>
            <p>@Env.EnvironmentName</p>
        </div>

        <div class="status-card">
            <h3>Uptime</h3>
            <p>@FormatUptime()</p>
        </div>
    </div>

    <h2 style="margin-top:1.5rem;">Recent Logs</h2>

    @if (_recentLogLines.Count == 0)
    {
        <p>No recent log entries found.</p>
    }
    else
    {
        <pre class="log-panel">@string.Join(Environment.NewLine, _recentLogLines)</pre>
    }
}

@code {
    private StatusModel _model = new();
    private List<string> _recentLogLines = new();

    protected override void OnInitialized()
    {
        LoadVersionInfo();
        LoadRecentLogs();
    }

    private void LoadVersionInfo()
    {
        try
        {
            var versionPath = Path.Combine(Env.ContentRootPath, "version.json");

            if (!File.Exists(versionPath))
            {
                _model = new StatusModel
                {
                    Version = "Not deployed yet",
                    Commit = "N/A",
                    Branch = "N/A",
                    Deployed = "N/A",
                    Runner = "N/A"
                };
                return;
            }

            var json = File.ReadAllText(versionPath);
            var model = JsonSerializer.Deserialize<StatusModel>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            _model = model ?? new StatusModel
            {
                Version = "Unknown",
                Commit = "N/A",
                Branch = "N/A",
                Deployed = "N/A",
                Runner = "N/A"
            };
        }
        catch
        {
            _model = new StatusModel
            {
                Version = "Error loading version",
                Commit = "N/A",
                Branch = "N/A",
                Deployed = "N/A",
                Runner = "N/A"
            };
        }
    }

    private void LoadRecentLogs()
    {
        try
        {
            var logDir = Path.Combine(Env.ContentRootPath, "Logs");

            if (!Directory.Exists(logDir))
            {
                return;
            }

            var latestLog = Directory.GetFiles(logDir, "site-*.log")
                .Select(path => new FileInfo(path))
                .OrderByDescending(f => f.LastWriteTimeUtc)
                .FirstOrDefault();

            if (latestLog is null || !latestLog.Exists)
            {
                return;
            }

            var lines = File.ReadAllLines(latestLog.FullName);
            _recentLogLines = lines
                .Skip(Math.Max(0, lines.Length - 30))
                .ToList();
        }
        catch
        {
            _recentLogLines = new List<string>();
        }
    }

    private string FormatUptime()
    {
        var uptime = TimeSpan.FromMilliseconds(Environment.TickCount64);
        return $"{(int)uptime.TotalDays}d {uptime.Hours}h {uptime.Minutes}m {uptime.Seconds}s";
    }

    private sealed class StatusModel
    {
        public string? Version { get; set; }
        public string? Commit { get; set; }
        public string? Branch { get; set; }
        public string? Deployed { get; set; }
        public string? Runner { get; set; }
    }
}