<section id="contact" class="section contact-section">
    <div>
        <p class="section-kicker">Contact</p>
        <h2>Send a message and we will get back to you.</h2>
        <p>
            Use the form below to send a message about your vehicle, the issue you are seeing, or to ask about scheduling.
        </p>
    </div>

    <div class="quote-card contact-form-card animate-card">
        <form class="contact-form" method="post" action="/contact/send">
            <div class="form-grid">
                <div class="form-field">
                    <label>Name</label>
                    <input class="input" name="Name" required />
                </div>

                <div class="form-field">
                    <label>Phone</label>
                    <input class="input" name="Phone" required />
                </div>

                <div class="form-field full">
                    <label>Email</label>
                    <input class="input" name="Email" type="email" required />
                </div>

                <div class="form-field full" style="display:none;">
                    <label>Company</label>
                    <input class="input" name="Company" autocomplete="off" />
                </div>

                <div class="form-field full">
                    <label>Message</label>
                    <textarea class="input textarea" name="Body" rows="6" required></textarea>
                </div>
            </div>

            <button type="submit" class="btn btn-primary full-width">Send Message</button>
        </form>
    </div>
</section>

@code {
    private ContactMessage _message = new();

    private string BuildMailtoLink()
    {
        var subject = Uri.EscapeDataString($"Website message from {_message.Name}");
        var body = Uri.EscapeDataString(
            $"Name: {_message.Name}\nPhone: {_message.Phone}\nEmail: {_message.Email}\n\nMessage:\n{_message.Body}");

        return $"mailto:tomparlette@tomparlettegarage.org?subject={subject}&body={body}";
    }

    private sealed class ContactMessage
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string? Name { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? Phone { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string? Email { get; set; }

        [System.ComponentModel.DataAnnotations.Required]
        public string? Body { get; set; }
    }
}