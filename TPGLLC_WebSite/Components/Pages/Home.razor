@page "/"
<PageTitle>Your Business Name</PageTitle>

<div class="site-shell">
    <header class="topbar">
        <div class="brand">
            <div class="brand-mark">▲</div>
            <div>
                <div class="brand-name">Tom Parlette Garage LLC</div>
                <div class="brand-subtitle">Honest service • Quality work • Trusted locally</div>
            </div>
        </div>

        <nav class="topnav">
            <a href="#services">Services</a>
            <a href="#about">About</a>
            <a href="#hours">Hours</a>
            <a href="#contact">Contact</a>
        </nav>
    </header>

    <main>
        <section class="hero">
            <div class="hero-copy">
                <p class="eyebrow">Locally Owned & Operated</p>
                <h1>Professional service for your business and your customers.</h1>
                <p class="lead">
                    We provide dependable work, clear communication, and the kind of service people come back for.
                </p>

                <div class="hero-actions">
                    <a class="button primary" href="tel:+17653453354">Call Now</a>
                    <a class="button secondary" href="mailto:tomparlettegarage@gmail.com">Email Us</a>
                </div>
            </div>

            <aside class="info-card">
                <h2>Business Info</h2>
                <p><strong>Phone:</strong> (765) 345-3354</p>
                <p><strong>Email:</strong> tomparlettegarage@gmail.com</p>
                <p><strong>Address:</strong> 2203 Mcclennan Ct S, Columbus, IN 47203</p>
                <p><strong>Hours:</strong> Fri–Sun, 6:30 PM – 10:00 PM</p>
            </aside>
        </section>

        <section id="services" class="section">
            <h2>Services</h2>
            <div class="card-grid">
                <article class="card">
                    <h3>Diagnostics</h3>
                    <p>Fast, accurate inspection and troubleshooting.</p>
                </article>
                <article class="card">
                    <h3>Maintenance</h3>
                    <p>Oil changes, filters, fluids, and scheduled service.</p>
                </article>
                <article class="card">
                    <h3>Repairs</h3>
                    <p>Brakes, suspension, engine work, and more.</p>
                </article>
                <article class="card">
                    <h3>Customer Support</h3>
                    <p>Friendly communication and clear next steps.</p>
                </article>
            </div>
        </section>

        <section id="about" class="section split">
            <div>
                <h2>About Us</h2>
                <p>
                    Add a short paragraph here about your company, your experience, and what makes your business different.
                </p>
            </div>

            <div class="quote">
                <p>
                    “Reliable service, honest work, and a strong reputation in the community.”
                </p>
            </div>
        </section>

        <section id="hours" class="section split">
            <div>
                <h2>Hours</h2>
                <ul class="list">
                    <li>Monday: 8:00 AM – 5:00 PM</li>
                    <li>Tuesday: 8:00 AM – 5:00 PM</li>
                    <li>Wednesday: 8:00 AM – 5:00 PM</li>
                    <li>Thursday: 8:00 AM – 5:00 PM</li>
                    <li>Friday: 8:00 AM – 5:00 PM</li>
                    <li>Saturday: Closed</li>
                    <li>Sunday: Closed</li>
                </ul>
            </div>

            <div class="contact-box" id="contact">
                <h2>Contact</h2>
                <p><strong>Phone:</strong> (555) 555-5555</p>
                <p><strong>Email:</strong> info@yourbusiness.com</p>
                <p><strong>Address:</strong> 123 Main Street, Your City, ST 12345</p>
                <a class="button primary full" href="mailto:info@yourbusiness.com">Send a Message</a>
            </div>
        </section>
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year Your Business Name. All rights reserved.</p>
    </footer>
</div>