<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly" NotFoundPage="@typeof(Pages.Public.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <p>You are not authorized. <a href="/Identity/Account/Login">Log in</a>.</p>
                </NotAuthorized>
            </AuthorizeRouteView>
            
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>