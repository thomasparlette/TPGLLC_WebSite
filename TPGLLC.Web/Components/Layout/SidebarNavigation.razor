@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

@inject IPortalSessionState PortalSessionState
@implements IDisposable

<div class="customer-sidebar">
    <div class="sidebar-heading">
        <h3>Navigation</h3>
    </div>

    <AuthorizeView Context="authState">
        <Authorized>
            <div class="nav-user">
                <div class="nav-avatar">@GetInitials(authState.User)</div>
                <div class="nav-user-copy">
                    <div class="nav-user-label">Signed in as</div>
                    <div class="nav-user-name">@GetDisplayName(authState.User)</div>
                </div>
            </div>

            <div class="nav-section">
                <div class="nav-heading">Customer Portal</div>

                <NavLink href="/portal/dashboard" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">
                    Dashboard
                </NavLink>

                <NavLink href="/portal/vehicles" class="nav-link" @onclick="HandleNavigate">
                    Vehicles
                </NavLink>

                <NavLink href="/portal/appointments" class="nav-link" @onclick="HandleNavigate">
                    Appointments
                </NavLink>

                <NavLink href="/portal/history" class="nav-link" @onclick="HandleNavigate">
                    Service History
                </NavLink>

                <NavLink href="/portal/profile" class="nav-link" @onclick="HandleNavigate">
                    Customer Account
                </NavLink>

                <AuthorizeView Roles="Administrator" Context="adminState">
                    <Authorized>
                        <NavLink href="/portal/admin" class="nav-link" @onclick="HandleNavigate">
                            Administration
                        </NavLink>
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="nav-section">
                <div class="nav-heading">Account</div>
                <a href="/logout" class="nav-link danger" @onclick="HandleNavigate">
                    Logout
                </a>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="nav-section">
                <div class="nav-heading">Main</div>

                <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">
                    Home
                </NavLink>

                <NavLink href="/services" class="nav-link" @onclick="HandleNavigate">
                    Services
                </NavLink>

                <NavLink href="/contact" class="nav-link" @onclick="HandleNavigate">
                    Contact
                </NavLink>

                <NavLink href="/portal/dashboard" class="nav-link" @onclick="HandleNavigate">
                    Customer Portal
                </NavLink>
            </div>

            <div class="nav-section">
                <div class="nav-heading">Account</div>

                <a href="/Identity/Account/Login" class="nav-link" @onclick="HandleNavigate">
                    Login
                </a>

                <a href="/Identity/Account/Register" class="nav-link" @onclick="HandleNavigate">
                    Register
                </a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    protected override void OnInitialized()
    {
        PortalSessionState.Changed += HandlePortalSessionChanged;
    }

    private void HandlePortalSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleNavigate()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    public void Dispose()
    {
        PortalSessionState.Changed -= HandlePortalSessionChanged;
    }

    private string GetDisplayName(ClaimsPrincipal user)
    {
        if (!string.IsNullOrWhiteSpace(PortalSessionState.DisplayName))
        {
            return PortalSessionState.DisplayName!;
        }

        var displayName =
            user.FindFirst("display_name")?.Value ??
            user.Identity?.Name ??
            user.FindFirst(ClaimTypes.Email)?.Value ??
            "Customer";

        return string.IsNullOrWhiteSpace(displayName) ? "Customer" : displayName;
    }

    private string GetInitials(ClaimsPrincipal user)
    {
        var name = GetDisplayName(user);
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "C";
        }

        if (parts.Length == 1)
        {
            return parts[0].Substring(0, 1).ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }
}
