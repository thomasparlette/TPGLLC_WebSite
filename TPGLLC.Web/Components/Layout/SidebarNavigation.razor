@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>
        <div class="nav-section">
    <div class="nav-heading">Customer Portal</div>

    <NavLink href="/portal/dashboard"
             Match="NavLinkMatch.All"
             class="nav-link"
             @onclick="HandleNavigate">
        Dashboard
    </NavLink>

    <NavLink href="/portal/vehicles"
             class="nav-link"
             @onclick="HandleNavigate">
        Vehicles
    </NavLink>

    <NavLink href="/portal/appointments"
             class="nav-link"
             @onclick="HandleNavigate">
        Appointments
    </NavLink>

    <NavLink href="/portal/history"
             class="nav-link"
             @onclick="HandleNavigate">
        Service History
    </NavLink>

    <NavLink href="/portal/invoices"
             class="nav-link"
             @onclick="HandleNavigate">
        Invoices
    </NavLink>

    <NavLink href="/portal/profile"
             class="nav-link"
             @onclick="HandleNavigate">
        Customer Account
    </NavLink>
</div>

<div class="nav-section">
    <div class="nav-heading">Account</div>

    <a href="/Identity/Account/Logout"
       class="nav-link danger"
       @onclick="HandleNavigate">
        Logout
    </a>
</div>

        <div class="nav-section">
            <div class="nav-heading">Account</div>
            <a class="nav-link danger" href="/Identity/Account/Logout" @onclick="HandleNavigate">Sign Out</a>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="nav-section">
            <div class="nav-heading">Main</div>
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">Home</NavLink>
            <NavLink href="/services" class="nav-link" @onclick="HandleNavigate">Services</NavLink>
            <NavLink href="/contact" class="nav-link" @onclick="HandleNavigate">Contact</NavLink>
            <NavLink href="/portal/dashboard" class="nav-link" @onclick="HandleNavigate">Customer Portal</NavLink>
        </div>

        <div class="nav-section">
            <div class="nav-heading">Account</div>
            <a class="nav-link" href="/Identity/Account/Login" @onclick="HandleNavigate">Login</a>
            <a class="nav-link" href="/Identity/Account/Register" @onclick="HandleNavigate">Register</a>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public EventCallback OnNavigate { get; set; }

    private async Task HandleNavigate()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }
}