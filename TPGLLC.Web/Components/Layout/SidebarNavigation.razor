@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private Task NavigateAsync() => OnNavigate.InvokeAsync();

    private static string GetInitial(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "U";
        }

        return char.ToUpperInvariant(value.Trim()[0]).ToString();
    }
}

<AuthorizeView>
    <Authorized Context="auth">
        <div class="nav-section">
            <div class="nav-user">
                <div class="nav-avatar">@GetInitial(auth.User.Identity?.Name)</div>
                <div class="nav-user-copy">
                    <div class="nav-user-label">Signed in as</div>
                    <div class="nav-user-name">@(auth.User.Identity?.Name ?? "Customer")</div>
                </div>
            </div>
        </div>

        <div class="nav-section">
            <div class="nav-heading">Main</div>
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" @onclick="NavigateAsync">Home</NavLink>
            <NavLink href="/portal" class="nav-link" @onclick="NavigateAsync">Customer Portal</NavLink>
            <NavLink href="/portal/dashboard" class="nav-link" @onclick="NavigateAsync">Dashboard</NavLink>
            <NavLink href="/portal/vehicles" class="nav-link" @onclick="NavigateAsync">Vehicles</NavLink>
            <NavLink href="/portal/appointments" class="nav-link" @onclick="NavigateAsync">Appointments</NavLink>
            <NavLink href="/portal/history" class="nav-link" @onclick="NavigateAsync">History</NavLink>
            <NavLink href="/portal/invoices" class="nav-link" @onclick="NavigateAsync">Invoices</NavLink>
            <NavLink href="/portal/profile" class="nav-link" @onclick="NavigateAsync">Profile</NavLink>
        </div>

        <div class="nav-section">
            <div class="nav-heading">Account</div>
            <a class="nav-link" href="/Identity/Account/Logout" @onclick="NavigateAsync">Logout</a>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="nav-section">
            <div class="nav-heading">Main</div>
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" @onclick="NavigateAsync">Home</NavLink>
            <NavLink href="/services" class="nav-link" @onclick="NavigateAsync">Services</NavLink>
            <NavLink href="/contact" class="nav-link" @onclick="NavigateAsync">Contact</NavLink>
            <NavLink href="/portal" class="nav-link" @onclick="NavigateAsync">Customer Portal</NavLink>
        </div>

        <div class="nav-section">
            <div class="nav-heading">Account</div>
            <a class="nav-link" href="/Identity/Account/Login" @onclick="NavigateAsync">Login</a>
            <a class="nav-link" href="/Identity/Account/Register" @onclick="NavigateAsync">Register</a>
        </div>
    </NotAuthorized>
</AuthorizeView>