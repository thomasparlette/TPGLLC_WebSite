@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using TPGLLC.Web.Authorization

<div class="customer-sidebar">
    <div class="sidebar-heading">
        <h3>Navigation</h3>
    </div>

    <AuthorizeView Context="authState">
        <Authorized>
            <div class="nav-user">
                <div class="nav-avatar">@authState.User.GetInitials()</div>
                <div class="nav-user-copy">
                    <div class="nav-user-label">Signed in as</div>
                    <div class="nav-user-name">@authState.User.GetDisplayName()</div>
                </div>
            </div>

            @if (authState.User.IsAdministrator())
            {
                <div class="nav-section">
                    <div class="nav-heading">Administration</div>
                    <NavLink href="/portal/admin" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">
                        Dashboard
                    </NavLink>
                    <NavLink href="/portal/admin/user-roles" class="nav-link" @onclick="HandleNavigate">
                        User Roles
                    </NavLink>
                    <NavLink href="/portal/account" class="nav-link" @onclick="HandleNavigate">
                        Account Detail
                    </NavLink>
                </div>
            }
            else if (authState.User.IsEmployeePortalUser())
            {
                @if (authState.User.IsServiceAdvisor())
                {
                    <div class="nav-section">
                        <div class="nav-heading">Service Advisor Portal</div>
                        <NavLink href="/portal/employee/service-advisor" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">
                            Dashboard
                        </NavLink>
                        <NavLink href="/portal/employee/service-advisor/current-requests" class="nav-link" @onclick="HandleNavigate">
                            Current Customer Requests
                        </NavLink>
                        <NavLink href="/portal/employee/service-advisor/calendar" class="nav-link" @onclick="HandleNavigate">
                            Appointment Calendar
                        </NavLink>
                        <NavLink href="/portal/employee/service-advisor/work-orders" class="nav-link" @onclick="HandleNavigate">
                            Work Orders
                        </NavLink>
                        <NavLink href="/portal/employee/service-advisor/customers" class="nav-link" @onclick="HandleNavigate">
                            Customers
                        </NavLink>
                        <NavLink href="/portal/account" class="nav-link" @onclick="HandleNavigate">
                            Account Detail
                        </NavLink>
                    </div>
                }

                @if (authState.User.IsTechnician())
                {
                    <div class="nav-section">
                        <div class="nav-heading">Technician Portal</div>
                        <NavLink href="/portal/employee/technician" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">
                            Dashboard
                        </NavLink>
                        <NavLink href="/portal/employee/technician/work-orders" class="nav-link" @onclick="HandleNavigate">
                            Current Work Orders Assigned
                        </NavLink>
                        <NavLink href="/portal/account" class="nav-link" @onclick="HandleNavigate">
                            Account Detail
                        </NavLink>
                    </div>
                }

                @if (authState.User.IsFinance())
                {
                    <div class="nav-section">
                        <div class="nav-heading">Finance Portal</div>
                        <NavLink href="/portal/employee/finance" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">
                            Dashboard
                        </NavLink>
                        <NavLink href="/portal/employee/finance/completed-work-orders" class="nav-link" @onclick="HandleNavigate">
                            Work Orders Completed
                        </NavLink>
                        <NavLink href="/portal/employee/finance/pending-payment" class="nav-link" @onclick="HandleNavigate">
                            Work Orders Needing Payment
                        </NavLink>
                        <NavLink href="/portal/employee/finance/accounts-receivable" class="nav-link" @onclick="HandleNavigate">
                            Accounts Receivable
                        </NavLink>
                        <NavLink href="/portal/account" class="nav-link" @onclick="HandleNavigate">
                            Account Detail
                        </NavLink>
                    </div>
                }
            }
            else if (authState.User.IsCustomerOnly())
            {
                <div class="nav-section">
                    <div class="nav-heading">Customer Portal</div>

                    <NavLink href="/portal/dashboard" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">
                        Dashboard
                    </NavLink>

                    <NavLink href="/portal/vehicles" class="nav-link" @onclick="HandleNavigate">
                        Vehicles
                    </NavLink>

                    <NavLink href="/portal/appointments" class="nav-link" @onclick="HandleNavigate">
                        Appointments
                    </NavLink>

                    <NavLink href="/portal/history" class="nav-link" @onclick="HandleNavigate">
                        Service History
                    </NavLink>

                    <NavLink href="/portal/work-orders" class="nav-link" @onclick="HandleNavigate">
                        Work Orders &amp; Invoices
                    </NavLink>

                    <NavLink href="/portal/account" class="nav-link" @onclick="HandleNavigate">
                        Account Detail
                    </NavLink>
                </div>
            }

            <div class="nav-section">
                <div class="nav-heading">Account</div>
                <a href="/logout" class="nav-link danger" @onclick="HandleNavigate">
                    Logout
                </a>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="nav-section">
                <div class="nav-heading">Main</div>

                <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">
                    Home
                </NavLink>

                <NavLink href="/services" class="nav-link" @onclick="HandleNavigate">
                    Services
                </NavLink>

                <NavLink href="/contact" class="nav-link" @onclick="HandleNavigate">
                    Contact
                </NavLink>

                <NavLink href="/Identity/Account/Login" class="nav-link" @onclick="HandleNavigate">
                    Login
                </NavLink>

                <NavLink href="/Identity/Account/Register" class="nav-link" @onclick="HandleNavigate">
                    Register
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private async Task HandleNavigate()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }
}
