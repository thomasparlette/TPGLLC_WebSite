@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using TPGLLC.Web.Infrastructure

<div class="customer-sidebar">
    <div class="sidebar-heading">
        <h3>Navigation</h3>
    </div>

    <AuthorizeView Context="authState">
        <Authorized>
            <div class="nav-user">
                <div class="nav-avatar">@GetInitials(authState.User)</div>
                <div class="nav-user-copy">
                    <div class="nav-user-label">Signed in as</div>
                    <div class="nav-user-name">@GetDisplayName(authState.User)</div>
                </div>
            </div>

            @if (authState.User.IsInRole("Administrator"))
            {
                <div class="nav-section">
                    <div class="nav-heading">Administration</div>
                    <NavLink href="/portal/admin" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">Administration Dashboard</NavLink>
                    <NavLink href="/portal/admin/users" class="nav-link" @onclick="HandleNavigate">User Roles</NavLink>
                </div>
            }

            @if (authState.User.IsInRole("ServiceAdvisor"))
            {
                <div class="nav-section">
                    <div class="nav-heading">Service Advisor</div>
                    <NavLink href="/portal/service-advisor" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">Dashboard</NavLink>
                    <NavLink href="/portal/service-advisor/current-requests" class="nav-link" @onclick="HandleNavigate">Current Customer Request</NavLink>
                    <NavLink href="/portal/service-advisor/appointment-calendar" class="nav-link" @onclick="HandleNavigate">Appointment Calendar</NavLink>
                    <NavLink href="/portal/service-advisor/work-orders" class="nav-link" @onclick="HandleNavigate">Workorders</NavLink>
                    <NavLink href="/portal/service-advisor/catalog" class="nav-link" @onclick="HandleNavigate">Parts &amp; Labor Catalog</NavLink>
                    <NavLink href="/portal/service-advisor/customers" class="nav-link" @onclick="HandleNavigate">Customers</NavLink>
                </div>
            }

            @if (authState.User.IsInRole("Technician"))
            {
                <div class="nav-section">
                    <div class="nav-heading">Technician</div>
                    <NavLink href="/portal/technician" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">Dashboard</NavLink>
                    <NavLink href="/portal/technician/work-orders" class="nav-link" @onclick="HandleNavigate">Current Work Orders Assigned</NavLink>
                </div>
            }

            @if (authState.User.IsInRole("Finance"))
            {
                <div class="nav-section">
                    <div class="nav-heading">Finance</div>
                    <NavLink href="/portal/finance" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">Dashboard</NavLink>
                    <NavLink href="/portal/finance/completed-work-orders" class="nav-link" @onclick="HandleNavigate">Work orders completed</NavLink>
                    <NavLink href="/portal/finance/work-orders-needing-payment" class="nav-link" @onclick="HandleNavigate">Work Order Needing Payment</NavLink>
                    <NavLink href="/portal/finance/accounts-received" class="nav-link" @onclick="HandleNavigate">Account Received</NavLink>
                </div>
            }

            @if (authState.User.IsInRole("Customer"))
            {
                <div class="nav-section">
                    <div class="nav-heading">Customer</div>
                    <NavLink href="/portal/customer" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">Dashboard</NavLink>
                    <NavLink href="/portal/customers/vehicles" class="nav-link" @onclick="HandleNavigate">Vehicles</NavLink>
                    <NavLink href="/portal/customers/appointments" class="nav-link" @onclick="HandleNavigate">Appointments</NavLink>
                    <NavLink href="/portal/customers/history" class="nav-link" @onclick="HandleNavigate">Service History</NavLink>
                    <NavLink href="/portal/customers/work-orders" class="nav-link" @onclick="HandleNavigate">Work Orders &amp; Invoices</NavLink>
                </div>
            }

            @if (!authState.User.IsInRole("Administrator")
                && !authState.User.IsInRole("ServiceAdvisor")
                && !authState.User.IsInRole("Technician")
                && !authState.User.IsInRole("Finance")
                && !authState.User.IsInRole("Customer"))
            {
                <div class="nav-section">
                    <div class="nav-heading">Portal</div>
                    <NavLink href="@GetHomeHref(authState.User)" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">Dashboard</NavLink>
                </div>
            }

            <div class="nav-section">
                <div class="nav-heading">Account</div>
                <NavLink href="/portal/account" class="nav-link" @onclick="HandleNavigate">Account Detail</NavLink>
                <a href="/logout" class="nav-link danger" @onclick="HandleNavigate">Logout</a>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="nav-section">
                <div class="nav-heading">Main</div>
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" @onclick="HandleNavigate">Home</NavLink>
                <NavLink href="/services" class="nav-link" @onclick="HandleNavigate">Services</NavLink>
                <NavLink href="/contact" class="nav-link" @onclick="HandleNavigate">Contact</NavLink>
                <NavLink href="/portal" class="nav-link" @onclick="HandleNavigate">Portal</NavLink>
            </div>

            <div class="nav-section">
                <div class="nav-heading">Account</div>
                <a href="/Identity/Account/Login" class="nav-link" @onclick="HandleNavigate">Login</a>
                <a href="/Identity/Account/Register" class="nav-link" @onclick="HandleNavigate">Register</a>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }

    private async Task HandleNavigate()
    {
        if (OnNavigate.HasDelegate)
        {
            await OnNavigate.InvokeAsync();
        }
    }

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        var displayName =
            user.FindFirst("display_name")?.Value ??
            user.Identity?.Name ??
            user.FindFirst(ClaimTypes.Email)?.Value ??
            "Customer";

        return string.IsNullOrWhiteSpace(displayName) ? "Customer" : displayName;
    }

    private static string GetInitials(ClaimsPrincipal user)
    {
        var name = GetDisplayName(user);
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (parts.Length == 0)
        {
            return "C";
        }

        if (parts.Length == 1)
        {
            return parts[0].Substring(0, 1).ToUpperInvariant();
        }

        return string.Concat(parts[0][0], parts[^1][0]).ToUpperInvariant();
    }

    private static string GetHomeHref(ClaimsPrincipal user) => PortalRouteHelper.GetPortalHomeRoute(user);

    private static string GetPortalLabel(ClaimsPrincipal user) => PortalRouteHelper.GetPortalLabel(user);
}
