@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="customer-layout">
    <header class="portal-topbar">
        <a class="portal-brand" href="/portal/dashboard">
            <img src="/images/logo.jpeg" alt="Tom Parlette Garage LLC" />
            <div>
                <div class="portal-brand-name">Tom Parlette Garage LLC</div>
                <div class="portal-brand-subtitle">Customer Portal</div>
            </div>
        </a>

        <div class="portal-topbar-actions">
            <AuthorizeView>
                <Authorized Context="authState">
                    <div class="portal-topbar-welcome">
                        Welcome, @(GetDisplayName(authState.User))
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="portal-topbar-welcome">
                        Welcome
                    </div>
                </NotAuthorized>
            </AuthorizeView>

            <button type="button"
                    class="portal-mobile-menu-toggle"
                    @onclick="ToggleMenu"
                    aria-label="Open navigation menu">
                ☰
            </button>

            <a class="portal-signout-button" href="/Identity/Account/Logout">
                Sign Out
            </a>
        </div>
    </header>

    <div class="customer-layout-shell">
        <div class="portal-sidebar-backdrop @( _mobileMenuOpen ? "show" : "" )"
             @onclick="CloseMenu">
        </div>

        <aside class="portal-sidebar @( _mobileMenuOpen ? "open" : "" )">
            <SidebarNavigation OnNavigate="CloseMenu" />
        </aside>

        <main class="portal-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _mobileMenuOpen;

    private void ToggleMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private void CloseMenu() => _mobileMenuOpen = false;

    private static string GetDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.Identity?.IsAuthenticated != true)
        {
            return "Customer";
        }

        var name =
            user.Identity?.Name ??
            user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ??
            user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ??
            "Customer";

        return string.IsNullOrWhiteSpace(name) ? "Customer" : name;
    }
}