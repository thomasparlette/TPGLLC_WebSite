@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<div class="customer-layout">
    <header class="portal-topbar">
        <AuthorizeView Context="authState">
            <Authorized>
                <a class="portal-brand" href="@GetPortalHomeHref(authState.User)">
                    <img src="/images/logo.jpeg" alt="Tom Parlette Garage LLC" />
                    <div>
                        <div class="portal-brand-name">Tom Parlette Garage LLC</div>
                        <div class="portal-brand-subtitle">Portal</div>
                    </div>
                </a>
            </Authorized>
            <NotAuthorized>
                <a class="portal-brand" href="/">
                    <img src="/images/logo.jpeg" alt="Tom Parlette Garage LLC" />
                    <div>
                        <div class="portal-brand-name">Tom Parlette Garage LLC</div>
                        <div class="portal-brand-subtitle">Portal</div>
                    </div>
                </a>
            </NotAuthorized>
        </AuthorizeView>

        <div class="portal-topbar-actions">
            <AuthorizeView Context="authState">
                <Authorized>
                    <div class="portal-topbar-welcome">
                        Welcome, @(GetDisplayName(authState.User))
                    </div>

                    <a class="portal-admin-link" href="@GetPortalHomeHref(authState.User)">
                        @GetPortalActionLabel(authState.User)
                    </a>
                </Authorized>
                <NotAuthorized>
                    <div class="portal-topbar-welcome">
                        Welcome
                    </div>
                </NotAuthorized>
            </AuthorizeView>

            <button type="button"
                    class="portal-mobile-menu-toggle"
                    @onclick="ToggleMenu"
                    aria-label="Open navigation menu"
                    aria-expanded="@_mobileMenuOpen">
                ☰
            </button>

            <a class="portal-signout-button" href="/logout">
                Sign Out
            </a>
        </div>
    </header>

    <div class="customer-layout-shell">
        <div class="portal-sidebar-backdrop @(_mobileMenuOpen ? "show" : string.Empty)"
             @onclick="CloseMenu">
        </div>

        <aside class="portal-sidebar @(_mobileMenuOpen ? "open" : string.Empty)">
            <SidebarNavigation OnNavigate="CloseMenu" />
        </aside>

        <main class="portal-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _mobileMenuOpen;

    private void ToggleMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private void CloseMenu() => _mobileMenuOpen = false;

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        if (user.Identity?.IsAuthenticated != true)
        {
            return "Portal";
        }

        var displayName =
            user.FindFirst("display_name")?.Value ??
            user.Identity?.Name ??
            user.FindFirst(ClaimTypes.Email)?.Value ??
            "Portal";

        return string.IsNullOrWhiteSpace(displayName) ? "Portal" : displayName;
    }

    private static string GetPortalHomeHref(ClaimsPrincipal user)
    {
        if (user.IsInRole("Administrator"))
        {
            return "/portal/admin";
        }

        if (IsEmployeeUser(user))
        {
            return "/portal/employee/work-orders";
        }

        return "/portal/dashboard";
    }

    private static string GetPortalActionLabel(ClaimsPrincipal user)
    {
        if (user.IsInRole("Administrator"))
        {
            return "Administration";
        }

        if (IsEmployeeUser(user))
        {
            return "Work Orders";
        }

        return "Dashboard";
    }

    private static bool IsEmployeeUser(ClaimsPrincipal user)
    {
        return user.IsInRole("Employee")
            || user.IsInRole("ServiceAdvisor")
            || user.IsInRole("Technician")
            || user.IsInRole("Finance");
    }
}
