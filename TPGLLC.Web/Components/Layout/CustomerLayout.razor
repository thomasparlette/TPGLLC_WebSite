@inherits LayoutComponentBase
@using TPGLLC.Web.Services.Customers

@inject ICurrentCustomerAccessor CurrentCustomerAccessor
@inject ICustomerProfileService CustomerProfileService

<div class="app-shell portal-shell">
    <header class="site-header">
        <a class="brand" href="/portal/dashboard">
            <img class="brand-logo" src="/images/logo.jpeg" alt="Tom Parlette Garage LLC logo" />
            <div class="brand-copy">
                <span class="brand-name">Tom Parlette Garage LLC</span>
                <span class="brand-tagline">Customer Portal</span>
            </div>
        </a>

        <div class="portal-user">
            <div class="brand-tagline">
                Welcome, @_displayName
            </div>
            <a class="btn btn-secondary" href="/Identity/Account/Logout">Sign Out</a>
        </div>
    </header>

    <main class="page-content">
        <div class="customer-shell">
            <aside class="customer-sidebar">
                <div class="sidebar-heading">
                    <p class="section-kicker">Customer Portal</p>
                    <h3>Navigation</h3>
                </div>

                <SidebarNavigation />
            </aside>

            <section class="customer-content">
                @Body
            </section>
        </div>
    </main>
</div>

@code {
    private string _displayName = "Customer";

    protected override async Task OnInitializedAsync()
    {
        var current = CurrentCustomerAccessor.GetCurrentCustomer();
        if (!current.IsAuthenticated)
        {
            return;
        }

        var profile = await CustomerProfileService.GetCurrentAsync();
        var name = $"{profile?.FirstName} {profile?.LastName}".Trim();

        _displayName = string.IsNullOrWhiteSpace(name) ? "Customer" : name;
    }
}