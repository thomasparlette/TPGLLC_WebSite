@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using TPGLLC.Web.Infrastructure

<div class="customer-layout">
    <header class="portal-topbar">
        <a class="portal-brand" href="/portal">
            <img src="/images/logo.jpeg" alt="Tom Parlette Garage LLC" />
            <div>
                <div class="portal-brand-name">Tom Parlette Garage LLC</div>
                <AuthorizeView Context="authState">
                    <Authorized>
                        <div class="portal-brand-subtitle">@GetPortalLabel(authState.User)</div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="portal-brand-subtitle">Portal</div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </a>

        <div class="portal-topbar-actions">
            <AuthorizeView Context="authState">
                <Authorized>
                    <div class="portal-topbar-welcome">
                        Welcome, @(GetDisplayName(authState.User))
                    </div>

                    @if (authState.User.IsInRole("Administrator"))
                    {
                        <a class="portal-admin-link" href="/portal/admin">Administration</a>
                    }

                    @if (authState.User.IsInRole("ServiceAdvisor"))
                    {
                        <a class="portal-admin-link" href="/portal/service-advisor">Service Advisor</a>
                    }

                    @if (authState.User.IsInRole("Technician"))
                    {
                        <a class="portal-admin-link" href="/portal/technician">Technician</a>
                    }

                    @if (authState.User.IsInRole("Finance"))
                    {
                        <a class="portal-admin-link" href="/portal/finance">Finance</a>
                    }

                    @if (authState.User.IsInRole("Customer"))
                    {
                        <a class="portal-admin-link" href="/portal/customer">Customer</a>
                    }
                </Authorized>
                <NotAuthorized>
                    <div class="portal-topbar-welcome">
                        Welcome
                    </div>
                </NotAuthorized>
            </AuthorizeView>

            <button type="button"
                    class="portal-mobile-menu-toggle"
                    @onclick="ToggleMenu"
                    aria-label="Open navigation menu"
                    aria-expanded="@_mobileMenuOpen">
                ☰
            </button>

            <a class="portal-signout-button" href="/logout">
                Sign Out
            </a>
        </div>
    </header>

    <div class="customer-layout-shell">
        <div class="portal-sidebar-backdrop @(_mobileMenuOpen ? "show" : string.Empty)"
             @onclick="CloseMenu">
        </div>

        <aside class="portal-sidebar @(_mobileMenuOpen ? "open" : string.Empty)">
            <SidebarNavigation OnNavigate="CloseMenu" />
        </aside>

        <main class="portal-content">
            @Body
        </main>
    </div>
</div>

@code {
    private bool _mobileMenuOpen;

    private void ToggleMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private void CloseMenu() => _mobileMenuOpen = false;

    private static string GetDisplayName(ClaimsPrincipal user)
    {
        if (user.Identity?.IsAuthenticated != true)
        {
            return "Customer";
        }

        var displayName =
            user.FindFirst("display_name")?.Value ??
            user.Identity?.Name ??
            user.FindFirst(ClaimTypes.Email)?.Value ??
            "Customer";

        return string.IsNullOrWhiteSpace(displayName) ? "Customer" : displayName;
    }

    private static string GetPortalLabel(ClaimsPrincipal user) => PortalRouteHelper.GetPortalLabel(user);

}
