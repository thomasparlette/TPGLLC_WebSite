@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<div class="app-shell">
    <header class="site-header">
        <a class="site-brand" href="/">
            <img class="brand-logo" src="/images/logo.jpeg" alt="Tom Parlette Garage LLC" />
            <div class="brand-copy">
                <div class="brand-name">Tom Parlette Garage LLC</div>
                <div class="brand-tagline">Professional service and customer portal</div>
            </div>
        </a>

        <button type="button"
                class="hamburger"
                @onclick="ToggleNav"
                aria-label="Toggle navigation"
                aria-expanded="@_navOpen">
            ☰
        </button>

        <nav class="site-nav @(_navOpen ? "open" : string.Empty)">
            <PublicNavigation />
        </nav>
    </header>

    <main class="page-content">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-grid">
            <div>
                <div class="footer-brand">TPG LLC</div>
                <p>Reliable automotive service and customer support.</p>
            </div>
            <div>
                <div class="footer-heading">Quick Links</div>
                <a href="/">Home</a><br />
                <a href="/services">Services</a><br />
                <a href="/contact">Contact</a>
            </div>
            <div>
                <div class="footer-heading">Account</div>
                <AuthorizeView>
                    <Authorized>
                        <a href="/portal/dashboard">Customer Portal</a><br />
                        <a href="/logout">Sign Out</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/Identity/Account/Login">Login</a><br />
                        <a href="/Identity/Account/Register">Register</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year TPG LLC</span>
            <span>All rights reserved</span>
        </div>
    </footer>
</div>

@code {
    private bool _navOpen;

    private void ToggleNav()
    {
        _navOpen = !_navOpen;
    }
}
