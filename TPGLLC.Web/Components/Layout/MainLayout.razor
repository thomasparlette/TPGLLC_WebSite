@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="/">
            <img src="/images/logo.jpeg" alt="TPG LLC" class="brand-logo" />
            <div class="brand-copy">
                <div class="brand-name">TPG LLC</div>
                <div class="brand-tagline">Professional service and customer portal</div>
            </div>
        </a>

        <button type="button"
                class="hamburger"
                @onclick="ToggleMenu"
                aria-label="Toggle navigation"
                aria-expanded="@_menuOpen">
            ☰
        </button>

        <nav class="site-nav @(_menuOpen ? "open" : "")">
            <SidebarNavigation />
        </nav>
    </header>

    <main class="page-content">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-grid">
            <div>
                <div class="footer-brand">TPG LLC</div>
                <p>Reliable automotive service and customer support.</p>
            </div>
            <div>
                <div class="footer-heading">Quick Links</div>
                <a href="/">Home</a><br />
                <a href="/services">Services</a><br />
                <a href="/contact">Contact</a>
            </div>
            <div>
                <div class="footer-heading">Account</div>
                <a href="/Identity/Account/Login">Login</a><br />
                <a href="/Identity/Account/Register">Register</a><br />
                <a href="/Identity/Account/Logout">Logout</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year TPG LLC</span>
            <span>All rights reserved</span>
        </div>
    </footer>
</div>

@code {
    private bool _menuOpen;

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }
}