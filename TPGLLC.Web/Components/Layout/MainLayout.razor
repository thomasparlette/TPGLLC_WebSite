@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="/" @onclick="CloseMenu">
            <img src="/images/logo.jpeg" alt="TPG LLC" class="brand-logo" />
            <div class="brand-copy">
                <div class="brand-name">TPG LLC</div>
                <div class="brand-tagline">Professional service and customer portal</div>
            </div>
        </a>

        <button type="button"
                class="hamburger @(_menuOpen ? "open" : "")"
                @onclick="ToggleMenu"
                aria-label="Toggle navigation"
                aria-expanded="@_menuOpen"
                aria-controls="site-nav">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav id="site-nav" class="site-nav @(_menuOpen ? "open" : "")">
            <SidebarNavigation OnNavigate="CloseMenu" />
        </nav>
    </header>

    <main class="page-content">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-grid">
            <div>
                <div class="footer-brand">TPG LLC</div>
                <p>Reliable automotive service and customer support.</p>
            </div>
            <div>
                <div class="footer-heading">Quick Links</div>
                <a href="/">Home</a><br />
                <a href="/services">Services</a><br />
                <a href="/contact">Contact</a>
            </div>
            <div>
                <div class="footer-heading">Account</div>
                <a href="/Identity/Account/Login">Login</a><br />
                <a href="/Identity/Account/Register">Register</a><br />
                <a href="/Identity/Account/Logout">Logout</a>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© @DateTime.Now.Year TPG LLC</span>
            <span>All rights reserved</span>
        </div>
    </footer>
</div>

@code {
    private bool _menuOpen;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }

    private void CloseMenu()
    {
        if (_menuOpen)
        {
            _menuOpen = false;
            StateHasChanged();
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _menuOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}