@inherits LayoutComponentBase

<div class="app-shell">
    <header class="site-header">
        <a class="brand" href="/" @onclick="CloseMenu">
            <img class="brand-logo" src="/images/logo.jpeg" alt="Tom Parlette Garage LLC logo" />
            <div class="brand-copy">
                <span class="brand-name">Tom Parlette Garage LLC</span>
                <span class="brand-tagline">Built on Trust. Driven by Results.</span>
            </div>
        </a>

        <button class="hamburger" type="button" @onclick="ToggleMenu" aria-label="Toggle navigation menu">
            ☰
        </button>

        <nav class="@NavCss">
            <a href="/" @onclick="CloseMenu">Home</a>
            <a href="/#services" @onclick="CloseMenu">Services</a>
            <a href="/#about" @onclick="CloseMenu">About</a>
            <a href="/#process" @onclick="CloseMenu">Our Process</a>
            <a href="/#faq" @onclick="CloseMenu">FAQ</a>
            <a href="/#contact" @onclick="CloseMenu">Contact</a>
            <a href="/#appointment" @onclick="CloseMenu">Request Appointment</a>

            <AuthorizeView>
                <Authorized Context="auth">
                    <a href="/customer/dashboard" @onclick="CloseMenu">My Account</a>
                    <a href="/account/Logout" @onclick="CloseMenu">Sign Out</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/account/login" @onclick="CloseMenu">Sign In</a>
                    <a href="/account/register" @onclick="CloseMenu">Create Account</a>
                </NotAuthorized>
            </AuthorizeView>

            <div class="mobile-buttons">
                <a class="btn btn-primary" href="tel:+17653463354">Call Now</a>
                <a class="btn btn-secondary" href="/#appointment" @onclick="CloseMenu">Request Appointment</a>
            </div>
        </nav>

        <AuthorizeView>
            <Authorized>
                <a class="btn btn-primary header-cta" href="/customer/dashboard">My Account</a>
            </Authorized>
            <NotAuthorized>
                <a class="btn btn-primary header-cta" href="/account/register">Create Account</a>
            </NotAuthorized>
        </AuthorizeView>
    </header>

    <main class="page-content">
        @Body
    </main>

    <footer class="site-footer">
        <div class="footer-grid">
            <div>
                <div class="footer-brand">Tom Parlette Garage LLC</div>
                <p>Complete automotive and motorcycle repair with honest communication and dependable work.</p>
            </div>

            <div>
                <div class="footer-heading">Contact</div>
                <p><a href="tel:+17653463354">(765) 346-3354</a></p>
                <p><a href="mailto:tomparlette@tomparlettegarage.org">tomparlette@tomparlettegarage.org</a></p>
            </div>

            <div>
                <div class="footer-heading">Quick Links</div>
                <p><a href="/#services">Services</a></p>
                <p><a href="/#appointment">Request Appointment</a></p>
                <p><a href="/#faq">FAQ</a></p>
                <p><a href="/account/login">Customer Account</a></p>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; @DateTime.Now.Year Tom Parlette Garage LLC</span>
            <span>Honest service • Quality work • Trusted locally</span>
        </div>
    </footer>
</div>

@code {
    private bool _menuOpen;

    private string NavCss => _menuOpen ? "site-nav open" : "site-nav";

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void CloseMenu() => _menuOpen = false;
}