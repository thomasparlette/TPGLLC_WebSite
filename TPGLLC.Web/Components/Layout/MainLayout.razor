@inherits LayoutComponentBase

<div class="site-shell">
    <header class="site-header">
        <a class="site-brand" href="/">
            <img src="/images/logo.jpeg" alt="Tom Parlette Garage LLC" />
            <div class="brand-copy">
                <div class="brand-name">Tom Parlette Garage LLC</div>
                <div class="brand-tagline">Professional service and customer portal</div>
            </div>
        </a>

        <button type="button"
                class="hamburger @(_navOpen ? "open" : string.Empty)"
                @onclick="ToggleNav"
                aria-label="Toggle navigation"
                aria-expanded="@_navOpen">
            <span></span>
            <span></span>
            <span></span>
        </button>

        <nav class="site-nav @(_navOpen ? "open" : string.Empty)">
            <PublicNavigation />
        </nav>
    </header>

    <main class="site-main">
        @Body
    </main>
</div>

@code {
    private bool _navOpen;

    private void ToggleNav()
    {
        _navOpen = !_navOpen;
    }
}