@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<AuthorizeView Context="authState">
    <Authorized>
        <NavLink href="@GetPortalHomeHref(authState.User)" Match="NavLinkMatch.All">
            @GetPortalLinkText(authState.User)
        </NavLink>
        <a href="/logout">Sign Out</a>
    </Authorized>
    <NotAuthorized>
        <NavLink href="/">Home</NavLink>
        <NavLink href="/services">Services</NavLink>
        <NavLink href="/contact">Contact</NavLink>
        <NavLink href="/Identity/Account/Register">Register</NavLink>
        <NavLink href="/Identity/Account/Login">Login</NavLink>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string GetPortalHomeHref(ClaimsPrincipal user)
    {
        if (user.IsInRole("Administrator"))
        {
            return "/portal/admin";
        }

        if (IsEmployeeUser(user))
        {
            return "/portal/employee/work-orders";
        }

        return "/portal/dashboard";
    }

    private static string GetPortalLinkText(ClaimsPrincipal user)
    {
        if (user.IsInRole("Administrator"))
        {
            return "Administration";
        }

        if (IsEmployeeUser(user))
        {
            return "Employee Portal";
        }

        return "Customer Portal";
    }

    private static bool IsEmployeeUser(ClaimsPrincipal user)
    {
        return user.IsInRole("Employee")
            || user.IsInRole("ServiceAdvisor")
            || user.IsInRole("Technician")
            || user.IsInRole("Finance");
    }
}
