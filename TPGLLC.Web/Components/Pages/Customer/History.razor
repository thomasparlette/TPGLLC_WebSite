@page "/customer/history"
@rendermode InteractiveServer
@inject CustomerPortalStore PortalStore
@attribute [Authorize]

@layout CustomerLayout

<div class="quote-card" style="margin-bottom:1.5rem;">
    <p class="section-kicker">Service History</p>
    <h1 style="margin-top:0;">History</h1>
    <p style="margin-bottom:0;">Completed work and technician notes for your vehicles.</p>
</div>

@if (PortalStore.History.Count == 0)
{
    <div class="quote-card">
        <h3>No service history yet</h3>
        <p>Your completed work orders will appear here.</p>
    </div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:1rem;">
        @foreach (var entry in PortalStore.History)
        {
            <div class="quote-card">
                <div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
                    <div>
                        <p class="section-kicker">@entry.VehicleName</p>
                        <h3 style="margin-top:0;">@entry.Service</h3>
                    </div>

                    <span class="btn btn-secondary" style="pointer-events:none;">@entry.Status</span>
                </div>

                <div style="display:grid;gap:.35rem;margin-top:1rem;">
                    <div><strong>Date:</strong> @entry.Date.ToString("MMM d, yyyy")</div>
                    <div><strong>Mileage:</strong> @entry.Mileage</div>
                    <div><strong>Technician:</strong> @entry.Technician</div>
                </div>
            </div>
        }
    </div>
}