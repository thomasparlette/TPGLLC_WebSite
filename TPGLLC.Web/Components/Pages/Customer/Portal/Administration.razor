@page "/portal/admin"
@layout CustomerLayout
@attribute [Authorize(Policy = PortalPolicies.Administrator)]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TPGLLC.Shared.Identity
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Authorization

@inject UserManager<ApplicationUser> UserManager

<PageTitle>Administration</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Administrator</p>
        <h1>Administration Dashboard</h1>
        <p>Manage portal users, review role assignments, and jump to account security.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading administration</div>
                <div class="portal-loading-text">Please wait while we gather the current user totals.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <PortalNotice Type="danger" Title="Unable to load dashboard">
                @_errorMessage
            </PortalNotice>
        }

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_totalUsers</div>
                <div class="portal-stat-label">Users</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_customerUsers</div>
                <div class="portal-stat-label">Customers</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_serviceUsers</div>
                <div class="portal-stat-label">Service Roles</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_adminUsers</div>
                <div class="portal-stat-label">Administrators</div>
            </div>
        </div>

        <div class="portal-dashboard-grid">
            <a class="portal-card-link" href="/portal/admin/users">
                <div class="portal-card-icon">👥</div>
                <h3>User Roles</h3>
                <p>Assign Customer, Service Advisor, Technician, Finance, and Administrator roles.</p>
            </a>

            <a class="portal-card-link" href="/portal/account">
                <div class="portal-card-icon">🪪</div>
                <h3>Account Detail</h3>
                <p>Review your account profile and update personal information.</p>
            </a>

            <a class="portal-card-link" href="/Identity/Account/Manage/ChangePassword">
                <div class="portal-card-icon">🔒</div>
                <h3>Change Password</h3>
                <p>Update your sign-in password from the standard account security page.</p>
            </a>
        </div>
    }
</section>

@code {
    private int _totalUsers;
    private int _customerUsers;
    private int _serviceUsers;
    private int _adminUsers;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var users = await UserManager.Users
                .AsNoTracking()
                .ToListAsync();

            _totalUsers = users.Count;

            foreach (var user in users)
            {
                var roles = await UserManager.GetRolesAsync(user);
                var roleSet = roles.ToHashSet(StringComparer.OrdinalIgnoreCase);

                if (roleSet.Contains("Customer"))
                {
                    _customerUsers++;
                }

                if (roleSet.Contains("ServiceAdvisor") || roleSet.Contains("Technician") || roleSet.Contains("Finance"))
                {
                    _serviceUsers++;
                }

                if (roleSet.Contains("Administrator"))
                {
                    _adminUsers++;
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
