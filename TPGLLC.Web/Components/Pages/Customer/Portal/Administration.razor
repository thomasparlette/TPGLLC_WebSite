@page "/portal/admin"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrator")]

@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using TPGLLC.Shared.Identity
@using TPGLLC.Web.Components.Shared

@inject UserManager<ApplicationUser> UserManager

<PageTitle>Administration</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Administrator</p>
        <h1>User Management Center</h1>
        <p>Use this area to manage portal users, employee types, and password resets.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading administration</div>
                <div class="portal-loading-text">Please wait while we load user statistics.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <PortalNotice Type="danger" Title="Administration unavailable">
                @_errorMessage
            </PortalNotice>
        }

        <PortalNotice Type="info" Title="Administration scope">
            This dashboard focuses on user management tasks. Use the user manager to assign roles, employee specialties, and password resets.
        </PortalNotice>

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_users.Count</div>
                <div class="portal-stat-label">Users</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_users.Count(x => x.IsCustomer)</div>
                <div class="portal-stat-label">Customers</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_users.Count(x => x.IsEmployee)</div>
                <div class="portal-stat-label">Employees</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_users.Count(x => x.IsAdministrator)</div>
                <div class="portal-stat-label">Administrators</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Administrative Tasks</h2>
                <button type="button" class="portal-action-button" @onclick="ReloadAsync">Refresh</button>
            </div>

            <div class="portal-dashboard-grid">
                <a class="portal-card-link" href="/portal/admin/users">
                    <div class="portal-card-icon">👥</div>
                    <h3>User Roles</h3>
                    <p>Assign customer access, employee specialties, and administrator access.</p>
                </a>

                <a class="portal-card-link" href="/portal/change-password">
                    <div class="portal-card-icon">🔐</div>
                    <h3>Change Password</h3>
                    <p>Update your own password from the administration account.</p>
                </a>

                <a class="portal-card-link" href="/portal/dashboard">
                    <div class="portal-card-icon">🏠</div>
                    <h3>Customer Dashboard</h3>
                    <p>Return to the main portal dashboard.</p>
                </a>
            </div>
        </div>
    }
</section>

@code {
    private sealed class UserSummary
    {
        public bool IsCustomer { get; set; }
        public bool IsEmployee { get; set; }
        public bool IsAdministrator { get; set; }
    }

    private readonly List<UserSummary> _users = [];
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            _users.Clear();

            var users = await UserManager.Users
                .AsNoTracking()
                .ToListAsync();

            foreach (var user in users)
            {
                var roles = await UserManager.GetRolesAsync(user);
                _users.Add(new UserSummary
                {
                    IsCustomer = roles.Contains("Customer", StringComparer.OrdinalIgnoreCase),
                    IsEmployee = roles.Contains("Employee", StringComparer.OrdinalIgnoreCase)
                        || roles.Contains("ServiceAdvisor", StringComparer.OrdinalIgnoreCase)
                        || roles.Contains("Technician", StringComparer.OrdinalIgnoreCase)
                        || roles.Contains("Finance", StringComparer.OrdinalIgnoreCase),
                    IsAdministrator = roles.Contains("Administrator", StringComparer.OrdinalIgnoreCase)
                });
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _users.Clear();
        }
        finally
        {
            _loading = false;
        }
    }
}
