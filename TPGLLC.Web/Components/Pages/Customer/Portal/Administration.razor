@page "/portal/admin"
@page "/portal/admin/dashboard"
@layout CustomerLayout
@attribute [Authorize(Roles = "Administrator")]

@using Microsoft.AspNetCore.Authorization
@using TPGLLC.Web.Authorization

<PageTitle>Administration Dashboard</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Administration</p>
        <h1>Administration Dashboard</h1>
        <p>Manage user access and account details from one place.</p>
    </div>

    <div class="portal-stats">
        <div class="portal-stat">
            <div class="portal-stat-value">User</div>
            <div class="portal-stat-label">Management</div>
        </div>

        <div class="portal-stat">
            <div class="portal-stat-value">Role</div>
            <div class="portal-stat-label">Assignments</div>
        </div>

        <div class="portal-stat">
            <div class="portal-stat-value">Profile</div>
            <div class="portal-stat-label">Detail</div>
        </div>
    </div>

    <div class="portal-dashboard-grid">
        <a class="portal-card-link" href="/portal/admin/user-roles">
            <div class="portal-card-icon">👥</div>
            <h3>User Roles</h3>
            <p>Assign customer access, employee specialties, and administrator access.</p>
        </a>

        <a class="portal-card-link" href="/portal/account">
            <div class="portal-card-icon">👤</div>
            <h3>Account Detail</h3>
            <p>Update your own administrator account details and password.</p>
        </a>
    </div>
</section>
