@page "/portal/dashboard"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using TPGLLC.Web.Services.Portal
@using TPGLLC.Web.ViewModels.Portal
@using TPGLLC.Web.Components.PortalShared.Dashboard

@inject IDashboardService DashboardService

<PageTitle>My Garage</PageTitle>

<section class="portal-dashboard">
    <div class="portal-hero">
        <div>
            <p class="section-kicker">Customer Portal</p>
            <h1>Welcome back, @_model.DisplayName</h1>
            <p>Manage your garage, appointments, service history, and account details in one place.</p>
        </div>

        <div class="portal-hero-badge">
            <span>Live Portal</span>
            <strong>@_model.Vehicles.Count vehicles</strong>
        </div>
    </div>

    <DashboardStats VehicleCount="@_model.Vehicles.Count"
                    AppointmentRequestCount="@_model.Requests.Count"
                    ServiceVisitCount="@_model.History.Count"
                    PrimaryVehicleCount="@_model.Vehicles.Count(v => v.IsPrimary)" />

    <DashboardQuickLinks />

    <div class="portal-grid">
        <DashboardPrimaryVehicleCard Vehicle="@_model.PrimaryVehicle" />
        <DashboardAppointmentCard Request="@_model.NextRequest" />
    </div>

    <div class="portal-grid">
        <DashboardVehicleList Vehicles="@_model.Vehicles" />
        <DashboardActivityTimeline Items="@_model.Activity" />
    </div>

    <DashboardServiceHistoryCard History="@_model.History" />
</section>

@code {
    private DashboardViewModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        _model = await DashboardService.GetAsync();
    }
}