@page "/portal/dashboard"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Globalization
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Services.Portal

@inject IDashboardService DashboardService

<PageTitle>Dashboard</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>Welcome back, @_model.DisplayName</h1>
        <p>Manage your vehicles, appointments, work orders, invoices, service history, and account details in one place.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading dashboard</div>
                <div class="portal-loading-text">Please wait while we pull in your portal data.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <PortalNotice Type="danger" Title="Dashboard unavailable">
                @_errorMessage
            </PortalNotice>
        }

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_model.Vehicles.Count</div>
                <div class="portal-stat-label">Vehicles</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.OpenRequests.Count</div>
                <div class="portal-stat-label">Open Requests</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.History.Count</div>
                <div class="portal-stat-label">History Entries</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.WorkOrders.Count</div>
                <div class="portal-stat-label">Work Orders</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Quick Actions</h2>
            </div>

            <div class="portal-dashboard-grid">
                <a class="portal-card-link" href="/portal/vehicles">
                    <div class="portal-card-icon">🚗</div>
                    <h3>My Vehicles</h3>
                    <p>View, add, edit, or update your vehicle list.</p>
                </a>

                <a class="portal-card-link" href="/portal/appointments">
                    <div class="portal-card-icon">📅</div>
                    <h3>Request Service</h3>
                    <p>Submit a new appointment request or review recent requests.</p>
                </a>

                <a class="portal-card-link" href="/portal/work-orders">
                    <div class="portal-card-icon">📝</div>
                    <h3>Work Orders &amp; Invoices</h3>
                    <p>Review estimates, approvals, and invoices tied to your vehicles.</p>
                </a>

                <a class="portal-card-link" href="/portal/profile">
                    <div class="portal-card-icon">👤</div>
                    <h3>Customer Account</h3>
                    <p>Update your personal information and contact details.</p>
                </a>

                <a class="portal-card-link" href="/portal/change-password">
                    <div class="portal-card-icon">🔐</div>
                    <h3>Change Password</h3>
                    <p>Update the password for your signed-in account.</p>
                </a>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Recent Vehicles</h2>
                <a href="/portal/vehicles">View all</a>
            </div>

            @if (_model.Vehicles.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">🚗</div>
                    <div>
                        <div class="portal-empty-title">No vehicles yet</div>
                        <div class="portal-empty-text">Add your first vehicle to get started.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-dashboard-grid">
                    @foreach (var vehicle in _model.Vehicles.Take(3))
                    {
                        <article class="portal-card-link" @key="vehicle.Id">
                            <div class="portal-card-icon">🚙</div>

                            <h3>@GetVehicleTitle(vehicle)</h3>
                            <p>@GetVehicleDetails(vehicle)</p>

                            @if (vehicle.IsPrimary)
                            {
                                <div style="margin-top:0.75rem;">
                                    <span class="portal-chip">Primary vehicle</span>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Recent Requests</h2>
                <a href="/portal/appointments">Go to appointments</a>
            </div>

            @if (_model.Requests.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">📅</div>
                    <div>
                        <div class="portal-empty-title">No requests yet</div>
                        <div class="portal-empty-text">Submit a service request when you are ready.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-activity">
                    @foreach (var request in _model.Requests
                        .OrderByDescending(x => x.SubmittedAtUtc)
                        .Take(3))
                    {
                        <div class="portal-activity-item" @key="request.RequestId">
                            <div class="portal-activity-icon">📅</div>
                            <div>
                                <strong>@request.ServiceNeeded</strong><br />
                                @GetRequestVehicleSummary(request)<br />
                                <span class="portal-muted">
                                    @request.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Recent Service History</h2>
                <a href="/portal/history">View history</a>
            </div>

            @if (_model.History.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">🛠️</div>
                    <div>
                        <div class="portal-empty-title">No service history yet</div>
                        <div class="portal-empty-text">Completed work orders will appear here.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-activity">
                    @foreach (var entry in _model.History
                        .OrderByDescending(x => x.ServiceDate)
                        .Take(3))
                    {
                        <div class="portal-activity-item" @key="entry.Id">
                            <div class="portal-activity-icon">🛠️</div>
                            <div>
                                <strong>@entry.Service</strong><br />
                                @entry.VehicleName<br />
                                <span class="portal-muted">
                                    @entry.ServiceDate.ToString("MMM d, yyyy")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    private DashboardViewModel _model = new()
    {
        DisplayName = "Customer"
    };

    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await DashboardService.GetAsync() ?? new DashboardViewModel();
            if (string.IsNullOrWhiteSpace(_model.DisplayName))
            {
                _model.DisplayName = "Customer";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _model = new DashboardViewModel
            {
                DisplayName = "Customer"
            };
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetVehicleTitle(CustomerVehicle vehicle)
    {
        var year = vehicle.ModelYear?.ToString(CultureInfo.InvariantCulture);
        return string.Join(" ", new[] { year, vehicle.Make, vehicle.Model }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string GetVehicleDetails(CustomerVehicle vehicle)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(vehicle.Nickname))
        {
            parts.Add(vehicle.Nickname!);
        }

        if (!string.IsNullOrWhiteSpace(vehicle.LicensePlate))
        {
            parts.Add(vehicle.LicensePlate!);
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Vin))
        {
            parts.Add($"VIN {vehicle.Vin}");
        }

        if (vehicle.Mileage.HasValue)
        {
            parts.Add($"{vehicle.Mileage.Value:N0} mi");
        }

        return parts.Count == 0 ? "No additional details." : string.Join(" • ", parts);
    }

    private static string GetRequestVehicleSummary(AppointmentRequest request)
    {
        var parts = new[]
        {
            request.VehicleYear,
            request.VehicleMake,
            request.VehicleModel
        }.Where(x => !string.IsNullOrWhiteSpace(x));

        var summary = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(summary) ? "Vehicle not specified" : summary;
    }
}
