@page "/portal/dashboard"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using TPGLLC.Web.Services.Portal
@using TPGLLC.Web.ViewModels.Portal
@using TPGLLC.Web.Components.PortalShared.Dashboard

@inject IDashboardService DashboardService

<PageTitle>Customer Portal</PageTitle>

<section class="portal-dashboard">
    <DashboardHero DisplayName="@_model.DisplayName"
                   VehicleCount="@_model.Vehicles.Count" />

    <DashboardStats VehicleCount="@_model.Vehicles.Count"
                    AppointmentRequestCount="@_model.Requests.Count"
                    ServiceVisitCount="@_model.History.Count"
                    PrimaryVehicleCount="@_model.Vehicles.Count(v => v.IsPrimary)" />

    <DashboardQuickActions />

    <div class="portal-grid">
        <PrimaryVehicleCard Vehicle="@_model.PrimaryVehicle" />
        <AppointmentCard Request="@_model.NextRequest" />
    </div>

    <div class="portal-grid">
        <VehiclesList Vehicles="@_model.Vehicles" />
        <ActivityTimeline Items="@_model.Activity" />
    </div>

    <ServiceHistoryCard History="@_model.History" />
</section>

@code {
    private DashboardViewModel _model = new();

    protected override async Task OnParametersSetAsync()
    {
        _model = await DashboardService.GetAsync();
    }
}