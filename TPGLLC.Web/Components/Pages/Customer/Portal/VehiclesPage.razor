@page "/portal/vehicles"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using TPGLLC.Web.Services.Portal
@using TPGLLC.Web.ViewModels.Portal
@using TPGLLC.Web.Components.PortalShared.Vehicles

@inject IVehiclePortalService VehiclePortalService

<PageTitle>My Vehicles</PageTitle>

<section class="portal-dashboard" id="top">
    <VehiclePageHeader />

    @if (!string.IsNullOrWhiteSpace(_model.ErrorMessage))
    {
        <div class="auth-alert">@_model.ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
    {
        <div class="auth-success">@_model.SuccessMessage</div>
    }

    <VehicleStats VehicleCount="@_model.Vehicles.Count"
                  PrimaryVehicleCount="@_model.Vehicles.Count(x => x.IsPrimary)" />

    <VehiclesLists Vehicles="@_model.Vehicles"
                  OnEdit="EditVehicleAsync"
                  OnDelete="DeleteVehicleAsync"
                  OnMakePrimary="SetPrimaryVehicleAsync" />

    <VehicleForm Form="@_model.Form"
                 Years="@_model.Years"
                 Makes="@_model.Makes"
                 Models="@_model.Models"
                 IsEditing="@(_model.EditingVehicleId is not null)"
                 OnSave="SaveVehicleAsync"
                 OnCancel="ResetFormAsync"
                 OnYearChangedCallback="OnVehicleYearChangedAsync"
                 OnMakeChangedCallback="OnVehicleMakeChangedAsync" />
</section>

@code {
    private VehiclePageViewModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        _model = await VehiclePortalService.GetAsync();
    }

    private async Task SaveVehicleAsync()
    {
        _model = await VehiclePortalService.SaveAsync(_model);
    }

    private async Task ResetFormAsync()
    {
        _model = await VehiclePortalService.ResetAsync();
    }

    private async Task EditVehicleAsync(Guid id)
    {
        _model = await VehiclePortalService.StartEditAsync(id);
    }

    private async Task DeleteVehicleAsync(Guid id)
    {
        _model = await VehiclePortalService.DeleteAsync(id);
    }

    private async Task SetPrimaryVehicleAsync(Guid id)
    {
        _model = await VehiclePortalService.MakePrimaryAsync(id);
    }

    private async Task OnVehicleYearChangedAsync()
    {
        _model = await VehiclePortalService.YearChangedAsync(_model);
    }

    private async Task OnVehicleMakeChangedAsync()
    {
        _model = await VehiclePortalService.MakeChangedAsync(_model);
    }
}