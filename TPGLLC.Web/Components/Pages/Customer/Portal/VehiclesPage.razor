@page "/portal/vehicles"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = PortalPolicies.Customer)]

@using TPGLLC.Web.Authorization
@using System.Globalization
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Components.PortalShared.Vehicles
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Services.Portal

@inject IVehiclePortalService VehicleService

<PageTitle>Vehicles</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>Vehicle Management</h1>
        <p>Add, update, or set a primary vehicle for your account.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading vehicles</div>
                <div class="portal-loading-text">Please wait while we load your garage.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_model.ErrorMessage))
        {
            <PortalNotice Type="danger" Title="Could not load vehicles">
                @_model.ErrorMessage
            </PortalNotice>
        }

        @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
        {
            <PortalNotice Type="success" Title="Saved">
                @_model.SuccessMessage
            </PortalNotice>
        }

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_model.Vehicles.Count</div>
                <div class="portal-stat-label">Vehicles</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.Vehicles.Count(x => x.IsPrimary)</div>
                <div class="portal-stat-label">Primary</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@(_model.EditingVehicleId is null ? "Add" : "Edit")</div>
                <div class="portal-stat-label">Mode</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Your Vehicles</h2>

                <a href="/portal/appointments">Request Service</a>
            </div>

            @if (_model.Vehicles.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">🚗</div>
                    <div>
                        <div class="portal-empty-title">No vehicles yet</div>
                        <div class="portal-empty-text">Add your first vehicle using the form below.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-dashboard-grid">
                    @foreach (var vehicle in _model.Vehicles)
                    {
                        <article class="portal-card-link vehicle-card" @key="vehicle.Id">
                            <div class="portal-card-icon">🚙</div>

                            <h3>@GetVehicleTitle(vehicle)</h3>
                            <p>@GetVehicleDetails(vehicle)</p>

                            <div style="margin-top:0.75rem; display:flex; flex-wrap:wrap; gap:0.5rem;">
                                @if (vehicle.IsPrimary)
                                {
                                    <span class="portal-chip">Primary vehicle</span>
                                }

                                @if (!string.IsNullOrWhiteSpace(vehicle.LicensePlate))
                                {
                                    <span class="portal-chip">@vehicle.LicensePlate</span>
                                }
                            </div>

                            <div class="portal-actions" style="margin-top:1rem;">
                                <a class="portal-action-button" href="@($"/portal/vehicles/{vehicle.Id}#vehicle-photo")">
                                    Photo
                                </a>

                                <button type="button" class="portal-action-button" @onclick="() => EditAsync(vehicle.Id)">
                                    Edit
                                </button>

                                @if (!vehicle.IsPrimary)
                                {
                                    <button type="button" class="portal-action-button" @onclick="() => MakePrimaryAsync(vehicle.Id)">
                                        Make Primary
                                    </button>
                                }

                                <button type="button" class="portal-danger-button" @onclick="() => DeleteAsync(vehicle.Id)">
                                    Delete
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>@(_model.EditingVehicleId is null ? "Add Vehicle" : "Edit Vehicle")</h2>

                @if (_model.EditingVehicleId is not null)
                {
                    <button type="button" class="portal-action-button" @onclick="ResetAsync">
                        Cancel Editing
                    </button>
                }
            </div>

            <VehicleForm Form="@_model.Form"
                         Years="@_model.Years"
                         Makes="@_model.Makes"
                         Models="@_model.Models"
                         OnSave="@EventCallback.Factory.Create(this, SaveAsync)"
                         OnCancel="@EventCallback.Factory.Create(this, ResetAsync)"
                         OnYearChanged="@EventCallback.Factory.Create(this, YearChangedAsync)"
                         OnMakeChanged="@EventCallback.Factory.Create(this, MakeChangedAsync)" />
        </div>
    }
</section>

@code {
    private VehiclePageViewModel _model = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await VehicleService.GetAsync() ?? new VehiclePageViewModel();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EditAsync(Guid vehicleId)
    {
        _model = await VehicleService.StartEditAsync(vehicleId) ?? new VehiclePageViewModel();
    }

    private async Task ResetAsync()
    {
        _model = await VehicleService.ResetAsync() ?? new VehiclePageViewModel();
    }

    private async Task SaveAsync()
    {
        _model = await VehicleService.SaveAsync(_model) ?? new VehiclePageViewModel();
    }

    private async Task DeleteAsync(Guid vehicleId)
    {
        _model = await VehicleService.DeleteAsync(vehicleId) ?? new VehiclePageViewModel();
    }

    private async Task MakePrimaryAsync(Guid vehicleId)
    {
        _model = await VehicleService.MakePrimaryAsync(vehicleId) ?? new VehiclePageViewModel();
    }

    private async Task YearChangedAsync()
    {
        _model = await VehicleService.YearChangedAsync(_model) ?? new VehiclePageViewModel();
    }

    private async Task MakeChangedAsync()
    {
        _model = await VehicleService.MakeChangedAsync(_model) ?? new VehiclePageViewModel();
    }

    private static string GetVehicleTitle(CustomerVehicle vehicle)
    {
        var year = vehicle.ModelYear?.ToString(CultureInfo.InvariantCulture);
        return string.Join(" ", new[] { year, vehicle.Make, vehicle.Model }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string GetVehicleDetails(CustomerVehicle vehicle)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(vehicle.Nickname))
        {
            parts.Add(vehicle.Nickname!);
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Vin))
        {
            parts.Add($"VIN {vehicle.Vin}");
        }

        if (vehicle.Mileage.HasValue)
        {
            parts.Add($"{vehicle.Mileage.Value:N0} mi");
        }

        return parts.Count == 0 ? "No additional details." : string.Join(" • ", parts);
    }
}
