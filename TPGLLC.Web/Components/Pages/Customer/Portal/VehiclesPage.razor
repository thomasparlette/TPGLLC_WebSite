@page "/portal/vehicles"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Forms
@using TPGLLC.Web.Services.Portal
@using TPGLLC.Web.ViewModels.Portal
@using TPGLLC.Web.Components.PortalShared.Vehicles

@inject IVehiclePortalService VehiclePortalService
@inject IVehiclePhotoService VehiclePhotoService

<PageTitle>My Garage</PageTitle>

<section class="portal-dashboard" id="top">
    <div class="portal-hero">
        <div>
            <p class="section-kicker">Customer Portal</p>
            <h1>Vehicle Management</h1>
            <p>Manage all of your registered vehicles in one place.</p>
        </div>

        <div class="portal-hero-badge">
            <span>Live Portal</span>
            <strong>@_model.Vehicles.Count vehicles</strong>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_model.ErrorMessage))
    {
        <div class="auth-alert">@_model.ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
    {
        <div class="auth-success">@_model.SuccessMessage</div>
    }

    <VehicleStats VehicleCount="@_model.Vehicles.Count"
                  PrimaryVehicleCount="@_model.Vehicles.Count(x => x.IsPrimary)" />

    <div class="portal-section">
        <div class="portal-section-heading">
            <h2>Your Vehicles</h2>

            <button type="button"
                    class="portal-action-button"
                    @onclick="ToggleAddVehicle">
                + Add Vehicle
            </button>
        </div>

        <VehiclesList Vehicles="@_model.Vehicles"
                      OnEdit="EditVehicleAsync"
                      OnDelete="DeleteVehicleAsync"
                      OnMakePrimary="SetPrimaryVehicleAsync" />
    </div>

    @if (_showVehicleForm)
    {
        <VehicleForm Form="@_model.Form"
                     Years="@_model.Years"
                     Makes="@_model.Makes"
                     Models="@_model.Models"
                     IsEditing="@(_model.EditingVehicleId is not null)"
                     OnSave="@EventCallback.Factory.Create(this, SaveVehicleAsync)"
                     OnCancel="@EventCallback.Factory.Create(this, CancelVehicleAsync)"
                     OnYearChanged="@EventCallback.Factory.Create(this, OnVehicleYearChangedAsync)"
                     OnMakeChanged="@EventCallback.Factory.Create(this, OnVehicleMakeChangedAsync)" />
    }

    @if (_model.EditingVehicleId is not null)
    {
        var selectedVehicle = _model.Vehicles.FirstOrDefault(x => x.Id == _model.EditingVehicleId);

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Vehicle Photo</h2>
                <a href="#top">Top</a>
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedVehicle?.PhotoPath))
            {
                <div style="margin-bottom:1rem;">
                    <img src="@selectedVehicle.PhotoPath"
                         alt="Vehicle photo"
                         style="max-width:320px; width:100%; border-radius:16px; display:block;" />
                </div>

                <button type="button"
                        class="portal-action-button"
                        @onclick="RemovePhotoAsync">
                    Remove Photo
                </button>
            }

            <div style="margin-top:1rem;">
                <InputFile OnChange="UploadPhotoAsync" accept="image/*" />
            </div>

            <p style="margin-top:0.75rem; color:#6b7280;">
                Upload a JPG, PNG, or WEBP image. Maximum 5 MB.
            </p>
        </div>
    }
</section>

@code {
    private VehiclePageViewModel _model = new();
    private bool _showVehicleForm;

    protected override async Task OnInitializedAsync()
    {
        _model = await VehiclePortalService.GetAsync();
    }

    private void ToggleAddVehicle()
    {
        if (_model.EditingVehicleId is not null)
        {
            return;
        }

        _showVehicleForm = !_showVehicleForm;
    }

    private async Task SaveVehicleAsync()
    {
        _model = await VehiclePortalService.SaveAsync(_model);
        _showVehicleForm = false;
    }

    private async Task CancelVehicleAsync()
    {
        _model = await VehiclePortalService.ResetAsync();
        _showVehicleForm = false;
    }

    private async Task EditVehicleAsync(Guid id)
    {
        _model = await VehiclePortalService.StartEditAsync(id);
        _showVehicleForm = true;
    }

    private async Task DeleteVehicleAsync(Guid id)
    {
        _model = await VehiclePortalService.DeleteAsync(id);
        _showVehicleForm = false;
    }

    private async Task SetPrimaryVehicleAsync(Guid id)
    {
        _model = await VehiclePortalService.MakePrimaryAsync(id);
    }

    private async Task OnVehicleYearChangedAsync()
    {
        _model = await VehiclePortalService.YearChangedAsync(_model);
    }

    private async Task OnVehicleMakeChangedAsync()
    {
        _model = await VehiclePortalService.MakeChangedAsync(_model);
    }

    private async Task UploadPhotoAsync(InputFileChangeEventArgs e)
    {
        if (_model.EditingVehicleId is null)
        {
            return;
        }

        await VehiclePhotoService.UploadAsync(_model.EditingVehicleId.Value, e.File);
        _model = await VehiclePortalService.GetAsync();
        _model = await VehiclePortalService.StartEditAsync(_model.EditingVehicleId.Value);
        _showVehicleForm = true;
    }

    private async Task RemovePhotoAsync()
    {
        if (_model.EditingVehicleId is null)
        {
            return;
        }

        await VehiclePhotoService.RemoveAsync(_model.EditingVehicleId.Value);
        _model = await VehiclePortalService.GetAsync();
        _model = await VehiclePortalService.StartEditAsync(_model.EditingVehicleId.Value);
        _showVehicleForm = true;
    }
}