@page "/portal/account"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using TPGLLC.Shared.Identity
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Services.Customers
@using TPGLLC.Web.Services.Portal
@using TPGLLC.Web.ViewModels.Portal

@inject ICustomerAccountService AccountService
@inject ICurrentCustomerAccessor CurrentCustomerAccessor
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Account Detail</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Portal</p>
        <h1>Account Detail</h1>
        <p>Review your account information and update your sign-in security.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading account</div>
                <div class="portal-loading-text">Please wait while we load your account details.</div>
            </div>
        </div>
    }
    else if (!_isCustomerAccount)
    {
        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@GetDisplayName()</div>
                <div class="portal-stat-label">Name</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@(_identityUser?.Email ?? _currentCustomer.Email)</div>
                <div class="portal-stat-label">Email</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@(_identityUser?.PhoneNumber ?? "Not set")</div>
                <div class="portal-stat-label">Phone</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Account Security</h2>
                <a class="portal-action-button" href="/Identity/Account/Manage/ChangePassword">Change Password</a>
            </div>

            <div class="portal-card-link" style="padding:1rem;">
                <div class="portal-card-icon">🪪</div>
                <h3>@GetDisplayName()</h3>
                <p>@(_identityUser?.Email ?? _currentCustomer.Email)</p>

                <div style="display:flex; flex-wrap:wrap; gap:0.5rem; margin-top:0.75rem;">
                    @foreach (var role in _roles)
                    {
                        <span class="portal-chip">@role</span>
                    }
                </div>

                <div class="portal-muted" style="margin-top:0.75rem;">
                    Non-customer accounts use the standard sign-in security page for password changes.
                </div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_model.ErrorMessage))
        {
            <PortalNotice Type="danger" Title="Account unavailable">
                @_model.ErrorMessage
            </PortalNotice>
        }

        @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
        {
            <PortalNotice Type="success" Title="Saved">
                @_model.SuccessMessage
            </PortalNotice>
        }

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@GetDisplayName()</div>
                <div class="portal-stat-label">Name</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.Email</div>
                <div class="portal-stat-label">Email</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.Phone</div>
                <div class="portal-stat-label">Phone</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Account Details</h2>

                <button type="button" class="portal-action-button" @onclick="ReloadAsync">
                    Reset
                </button>

                <a class="portal-action-button" href="/Identity/Account/Manage/ChangePassword">
                    Change Password
                </a>
            </div>

            <EditForm Model="@_model" OnValidSubmit="@SaveAsync">
                <DataAnnotationsValidator />

                <div class="portal-form-grid">
                    <div class="form-field">
                        <label>First Name</label>
                        <InputText class="input" @bind-Value="_model.FirstName" />
                        <ValidationMessage For="@(() => _model.FirstName)" />
                    </div>

                    <div class="form-field">
                        <label>Last Name</label>
                        <InputText class="input" @bind-Value="_model.LastName" />
                        <ValidationMessage For="@(() => _model.LastName)" />
                    </div>

                    <div class="form-field full">
                        <label>Email</label>
                        <InputText class="input" type="email" @bind-Value="_model.Email" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="form-field">
                        <label>Phone</label>
                        <InputText class="input" @bind-Value="_model.Phone" />
                        <ValidationMessage For="@(() => _model.Phone)" />
                    </div>

                    <div class="form-field full">
                        <label>Address Line 1</label>
                        <InputText class="input" @bind-Value="_model.AddressLine1" />
                        <ValidationMessage For="@(() => _model.AddressLine1)" />
                    </div>

                    <div class="form-field full">
                        <label>Address Line 2</label>
                        <InputText class="input" @bind-Value="_model.AddressLine2" />
                        <ValidationMessage For="@(() => _model.AddressLine2)" />
                    </div>

                    <div class="form-field">
                        <label>City</label>
                        <InputText class="input" @bind-Value="_model.City" />
                        <ValidationMessage For="@(() => _model.City)" />
                    </div>

                    <div class="form-field">
                        <label>State</label>
                        <InputText class="input" @bind-Value="_model.State" />
                        <ValidationMessage For="@(() => _model.State)" />
                    </div>

                    <div class="form-field">
                        <label>Zip Code</label>
                        <InputText class="input" @bind-Value="_model.ZipCode" />
                        <ValidationMessage For="@(() => _model.ZipCode)" />
                    </div>
                </div>

                <div class="portal-actions" style="margin-top: 1.25rem;">
                    <button type="submit" class="portal-action-button">Save Changes</button>
                </div>
            </EditForm>
        </div>
    }
</section>

@code {
    private CustomerAccountViewModel _model = new();
    private CurrentCustomer _currentCustomer = new();
    private ApplicationUser? _identityUser;
    private IReadOnlyList<string> _roles = Array.Empty<string>();
    private bool _isCustomerAccount;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _currentCustomer = CurrentCustomerAccessor.GetCurrentCustomer();
            _isCustomerAccount = _currentCustomer.IsCustomer;

            _identityUser = await UserManager.FindByIdAsync(_currentCustomer.UserId);
            if (_identityUser is not null)
            {
                _roles = (IReadOnlyList<string>)await UserManager.GetRolesAsync(_identityUser);
            }

            if (_isCustomerAccount)
            {
                _model = await AccountService.GetAsync() ?? new CustomerAccountViewModel();

                if (string.IsNullOrWhiteSpace(_model.ErrorMessage) &&
                    string.IsNullOrWhiteSpace(_model.FirstName) &&
                    string.IsNullOrWhiteSpace(_model.LastName))
                {
                    _model.FirstName = string.Empty;
                    _model.LastName = string.Empty;
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _model = await AccountService.SaveAsync(_model) ?? new CustomerAccountViewModel();
        Navigation.NavigateTo("/portal", forceLoad: true);
    }

    private async Task ReloadAsync()
    {
        _model = await AccountService.GetAsync() ?? new CustomerAccountViewModel();
    }

    private string GetDisplayName()
    {
        if (_identityUser is not null)
        {
            var name = string.Join(" ", new[] { _identityUser.FirstName, _identityUser.LastName }
                .Where(x => !string.IsNullOrWhiteSpace(x)));

            if (!string.IsNullOrWhiteSpace(name))
            {
                return name;
            }
        }

        var fallback = string.Join(" ", new[] { _model.FirstName, _model.LastName }
            .Where(x => !string.IsNullOrWhiteSpace(x)));

        return string.IsNullOrWhiteSpace(fallback) ? "Customer" : fallback;
    }
}
