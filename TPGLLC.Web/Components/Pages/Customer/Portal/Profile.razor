@page "/portal/profile"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Services.Portal
@using TPGLLC.Web.ViewModels.Portal

@inject ICustomerAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>Customer Account</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>Customer Account Center</h1>
        <p>Update your personal information and contact details.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading account</div>
                <div class="portal-loading-text">Please wait while we load your account details.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_model.ErrorMessage))
        {
            <PortalNotice Type="danger" Title="Account unavailable">
                @_model.ErrorMessage
            </PortalNotice>
        }

        @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
        {
            <PortalNotice Type="success" Title="Saved">
                @_model.SuccessMessage
            </PortalNotice>
        }

        @if (!_model.EmailConfirmed)
        {
            <PortalNotice Type="warning" Title="Verify your email">
                Your email address is not confirmed yet. Saving a new email address will send a verification link to @_model.Email.
            </PortalNotice>
        }

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@GetDisplayName()</div>
                <div class="portal-stat-label">Name</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.Email</div>
                <div class="portal-stat-label">Email</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.Phone</div>
                <div class="portal-stat-label">Phone</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Account Details</h2>

                <button type="button" class="portal-action-button" @onclick="ReloadAsync">
                    Reset
                </button>
            </div>

            <EditForm Model="@_model" OnValidSubmit="@SaveAsync">
                <DataAnnotationsValidator />

                <div class="portal-form-grid">
                    <div class="form-field">
                        <label>First Name</label>
                        <InputText class="input" @bind-Value="_model.FirstName" />
                        <ValidationMessage For="@(() => _model.FirstName)" />
                    </div>

                    <div class="form-field">
                        <label>Last Name</label>
                        <InputText class="input" @bind-Value="_model.LastName" />
                        <ValidationMessage For="@(() => _model.LastName)" />
                    </div>

                    <div class="form-field full">
                        <label>Email</label>
                        <InputText class="input" type="email" @bind-Value="_model.Email" />
                        <ValidationMessage For="@(() => _model.Email)" />
                    </div>

                    <div class="form-field">
                        <label>Phone</label>
                        <InputText class="input" @bind-Value="_model.Phone" />
                        <ValidationMessage For="@(() => _model.Phone)" />
                    </div>

                    <div class="form-field full">
                        <label>Address Line 1</label>
                        <InputText class="input" @bind-Value="_model.AddressLine1" />
                        <ValidationMessage For="@(() => _model.AddressLine1)" />
                    </div>

                    <div class="form-field full">
                        <label>Address Line 2</label>
                        <InputText class="input" @bind-Value="_model.AddressLine2" />
                        <ValidationMessage For="@(() => _model.AddressLine2)" />
                    </div>

                    <div class="form-field">
                        <label>City</label>
                        <InputText class="input" @bind-Value="_model.City" />
                        <ValidationMessage For="@(() => _model.City)" />
                    </div>

                    <div class="form-field">
                        <label>State</label>
                        <InputText class="input" @bind-Value="_model.State" />
                        <ValidationMessage For="@(() => _model.State)" />
                    </div>

                    <div class="form-field">
                        <label>Zip Code</label>
                        <InputText class="input" @bind-Value="_model.ZipCode" />
                        <ValidationMessage For="@(() => _model.ZipCode)" />
                    </div>
                </div>

                <div class="portal-actions" style="margin-top: 1.25rem;">
                    <button type="submit" class="portal-action-button">Save Changes</button>
                </div>
            </EditForm>
        </div>
    }
</section>

@code {
    private CustomerAccountViewModel _model = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await AccountService.GetAsync() ?? new CustomerAccountViewModel();

            if (string.IsNullOrWhiteSpace(_model.ErrorMessage) &&
                string.IsNullOrWhiteSpace(_model.FirstName) &&
                string.IsNullOrWhiteSpace(_model.LastName))
            {
                _model.FirstName = string.Empty;
                _model.LastName = string.Empty;
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _model = await AccountService.SaveAsync(_model) ?? new CustomerAccountViewModel();
        Navigation.NavigateTo("/portal/dashboard");
    }

    private async Task ReloadAsync()
    {
        _model = await AccountService.GetAsync() ?? new CustomerAccountViewModel();
    }

    private string GetDisplayName()
    {
        var name = string.Join(" ", new[] { _model.FirstName, _model.LastName }
            .Where(x => !string.IsNullOrWhiteSpace(x)));

        return string.IsNullOrWhiteSpace(name) ? "Customer" : name;
    }
}
