@page "/portal/customers/history"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = PortalPolicies.Customer)]

@using System.Globalization
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Authorization
@using TPGLLC.Web.Services.Portal

@inject IPortalContextService PortalContextService

<PageTitle>Service History</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>Service History</h1>
        <p>Review completed work and past visits for your vehicles.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading history</div>
                <div class="portal-loading-text">Please wait while we load your service records.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <PortalNotice Type="danger" Title="History unavailable">
                @_errorMessage
            </PortalNotice>
        }

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@(_portal?.ServiceHistoryEntries.Count ?? 0)</div>
                <div class="portal-stat-label">Entries</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@(_portal?.Vehicles.Count ?? 0)</div>
                <div class="portal-stat-label">Vehicles</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@(_portal?.PrimaryVehicle is null ? "None" : "Yes")</div>
                <div class="portal-stat-label">Primary</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Recent Service</h2>
                <a href="/portal/appointments">Request Service</a>
            </div>

            @if (_portal is null)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">🛠️</div>
                    <div>
                        <div class="portal-empty-title">No history loaded</div>
                        <div class="portal-empty-text">Your service history will appear here once loaded.</div>
                    </div>
                </div>
            }
            else if (_portal.ServiceHistoryEntries.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">🛠️</div>
                    <div>
                        <div class="portal-empty-title">No service history yet</div>
                        <div class="portal-empty-text">Completed work orders will appear here.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-activity">
                    @foreach (var entry in _portal.ServiceHistoryEntries
                        .OrderByDescending(x => x.ServiceDate)
                        .ThenByDescending(x => x.CreatedUtc))
                    {
                        <div class="portal-activity-item" @key="entry.Id">
                            <div class="portal-activity-icon">🛠️</div>

                            <div style="min-width:0;">
                                <strong>@entry.Service</strong><br />
                                @entry.VehicleName<br />
                                <span class="portal-muted">
                                    @entry.ServiceDate.ToString("MMMM d, yyyy", CultureInfo.InvariantCulture)
                                </span>

                                <div style="margin-top:0.5rem; display:flex; flex-wrap:wrap; gap:0.5rem;">
                                    @if (entry.Mileage.HasValue)
                                    {
                                        <span class="portal-chip">@entry.Mileage.Value:N0 mi</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(entry.Technician))
                                    {
                                        <span class="portal-chip">@entry.Technician</span>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(entry.Status))
                                    {
                                        <span class="portal-chip">@entry.Status</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(entry.Notes))
                                {
                                    <div class="portal-muted" style="margin-top:0.75rem;">
                                        @entry.Notes
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Vehicles With History</h2>
                <a href="/portal/vehicles">Manage Vehicles</a>
            </div>

            @if (_portal is not null && _portal.Vehicles.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">🚗</div>
                    <div>
                        <div class="portal-empty-title">No vehicles on file</div>
                        <div class="portal-empty-text">Add a vehicle to start tracking history.</div>
                    </div>
                </div>
            }
            else if (_portal is not null)
            {
                <div class="portal-dashboard-grid">
                    @foreach (var vehicle in _portal.Vehicles)
                    {
                        <article class="portal-card-link" @key="vehicle.Id">
                            <div class="portal-card-icon">🚙</div>

                            <h3>@GetVehicleTitle(vehicle)</h3>
                            <p>@GetVehicleDetails(vehicle)</p>

                            @if (vehicle.IsPrimary)
                            {
                                <div style="margin-top:0.75rem;">
                                    <span class="portal-chip">Primary vehicle</span>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    private PortalContextViewModel? _portal;
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _portal = await PortalContextService.GetAsync();

            if (_portal is null)
            {
                _errorMessage = "No portal data was returned.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _portal = new PortalContextViewModel();
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetVehicleTitle(CustomerVehicle vehicle)
    {
        var year = vehicle.ModelYear?.ToString(CultureInfo.InvariantCulture);
        return string.Join(" ", new[] { year, vehicle.Make, vehicle.Model }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string GetVehicleDetails(CustomerVehicle vehicle)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(vehicle.Nickname))
        {
            parts.Add(vehicle.Nickname!);
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Vin))
        {
            parts.Add($"VIN {vehicle.Vin}");
        }

        if (vehicle.Mileage.HasValue)
        {
            parts.Add($"{vehicle.Mileage.Value:N0} mi");
        }

        return parts.Count == 0 ? "No additional details." : string.Join(" • ", parts);
    }
}
