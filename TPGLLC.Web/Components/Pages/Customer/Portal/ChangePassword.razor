@page "/portal/change-password"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using TPGLLC.Shared.Identity
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Services.Customers
@using TPGLLC.Web.ViewModels.Portal

@inject ICurrentCustomerAccessor CurrentCustomerAccessor
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Change Password</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Account Security</p>
        <h1>Change Password</h1>
        <p>Update the password for your signed-in account.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading password form</div>
                <div class="portal-loading-text">Please wait while we load your account.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_model.ErrorMessage))
        {
            <PortalNotice Type="danger" Title="Could not change password">
                @_model.ErrorMessage
            </PortalNotice>
        }

        @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
        {
            <PortalNotice Type="success" Title="Password updated">
                @_model.SuccessMessage
            </PortalNotice>
        }

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Password</h2>
                <a href="/portal/profile">Back to Account</a>
            </div>

            <EditForm Model="@_model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="portal-form-grid">
                    <div class="form-field full">
                        <label>Current Password</label>
                        <InputText class="input" type="password" @bind-Value="_model.CurrentPassword" />
                        <ValidationMessage For="@(() => _model.CurrentPassword)" />
                    </div>

                    <div class="form-field">
                        <label>New Password</label>
                        <InputText class="input" type="password" @bind-Value="_model.NewPassword" />
                        <ValidationMessage For="@(() => _model.NewPassword)" />
                    </div>

                    <div class="form-field">
                        <label>Confirm Password</label>
                        <InputText class="input" type="password" @bind-Value="_model.ConfirmPassword" />
                        <ValidationMessage For="@(() => _model.ConfirmPassword)" />
                    </div>
                </div>

                <div class="portal-actions" style="margin-top: 1.25rem;">
                    <button type="submit" class="portal-action-button">Update Password</button>
                    <a class="portal-action-button" href="/portal/dashboard">Cancel</a>
                </div>
            </EditForm>
        </div>
    }
</section>

@code {
    private ChangePasswordViewModel _model = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var current = CurrentCustomerAccessor.GetCurrentCustomer();
            if (!current.IsAuthenticated)
            {
                _model.ErrorMessage = "You must be signed in to change your password.";
                return;
            }

            var user = await UserManager.FindByIdAsync(current.UserId);
            if (user is null)
            {
                _model.ErrorMessage = "Your account could not be found.";
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _model.ErrorMessage = null;
        _model.SuccessMessage = null;

        var current = CurrentCustomerAccessor.GetCurrentCustomer();
        if (!current.IsAuthenticated)
        {
            _model.ErrorMessage = "You must be signed in to change your password.";
            return;
        }

        var user = await UserManager.FindByIdAsync(current.UserId);
        if (user is null)
        {
            _model.ErrorMessage = "Your account could not be found.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, _model.CurrentPassword, _model.NewPassword);
        if (!result.Succeeded)
        {
            _model.ErrorMessage = string.Join(" ", result.Errors.Select(x => x.Description));
            return;
        }

        _model = new ChangePasswordViewModel
        {
            SuccessMessage = "Your password has been updated."
        };
    }
}
