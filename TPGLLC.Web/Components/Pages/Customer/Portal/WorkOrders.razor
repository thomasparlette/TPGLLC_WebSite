@page "/portal/customers/work-orders"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = PortalPolicies.Customer)]

@using System.Globalization
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Components.PortalShared.History
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Authorization
@using TPGLLC.Web.Services.Portal
@using TPGLLC.Web.Services.WorkOrders

@inject IWorkOrderPortalService WorkOrderService

<PageTitle>Work Orders & Invoices</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>Work Orders & Invoices</h1>
        <p>Track the repairs we are recommending, what is approved, and the invoices tied to completed work.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading work orders</div>
                <div class="portal-loading-text">Please wait while we load your repair updates and invoices.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_errorMessage))
        {
            <PortalNotice Type="danger" Title="Work orders unavailable">
                @_errorMessage
            </PortalNotice>
        }

        @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
        {
            <PortalNotice Type="success" Title="Updated">
                @_model.SuccessMessage
            </PortalNotice>
        }

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_model.WorkOrders.Count</div>
                <div class="portal-stat-label">Work Orders</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.WorkOrders.Count(x => !IsClosedStatus(x.Status))</div>
                <div class="portal-stat-label">Open</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_model.WorkOrders.Count(x => x.InvoiceAmount.HasValue)</div>
                <div class="portal-stat-label">Invoices</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Current Status</h2>
                <a href="/portal/history">View service history</a>
            </div>

            @if (_model.WorkOrders.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">📝</div>
                    <div>
                        <div class="portal-empty-title">No work orders yet</div>
                        <div class="portal-empty-text">When the shop opens a repair order, it will appear here.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-dashboard-grid">
                    @foreach (var workOrder in _model.WorkOrders.OrderByDescending(x => x.ServiceDate).ThenByDescending(x => x.CreatedUtc))
                    {
                        <ServiceHistoryCard Entry="@workOrder"
                                            CanApprove="@CanCustomerApprove(workOrder)"
                                            OnApprovePart="@(partId => ApprovePartAsync(partId, workOrder.Id))"
                                            OnDeclinePart="@(partId => DeclinePartAsync(partId, workOrder.Id))"
                                            OnApproveJob="@(jobId => ApproveJobAsync(jobId, workOrder.Id))"
                                            OnDeclineJob="@(jobId => DeclineJobAsync(jobId, workOrder.Id))"
                                            OnApproveWorkOrder="ApproveWorkOrderAsync"
                                            OnDeclineWorkOrder="DeclineWorkOrderAsync"
                                            @key="workOrder.Id" />
                    }
                </div>
            }
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <h2>Invoice Summary</h2>
                <a href="/portal/vehicles">Vehicle list</a>
            </div>

            @if (_model.WorkOrders.All(x => !x.InvoiceAmount.HasValue))
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">🧾</div>
                    <div>
                        <div class="portal-empty-title">No invoices yet</div>
                        <div class="portal-empty-text">Invoices will appear here after work is completed and billed.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-activity">
                    @foreach (var invoice in _model.WorkOrders.Where(x => x.InvoiceAmount.HasValue).OrderByDescending(x => x.ServiceDate))
                    {
                        <div class="portal-activity-item" @key="invoice.Id">
                            <div class="portal-activity-icon">🧾</div>
                            <div>
                                <strong>@(invoice.InvoiceNumber ?? invoice.WorkOrderNumber ?? invoice.Service)</strong><br />
                                @invoice.VehicleName<br />
                                <span class="portal-muted">
                                    @invoice.ServiceDate.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
                                </span><br />
                                <span class="portal-chip" style="display:inline-flex; margin-top:0.5rem;">
                                    @invoice.InvoiceAmount!.Value.ToString("C")
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    private WorkOrderPageViewModel _model = new();
    private bool _loading = true;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await WorkOrderService.GetCustomerAsync();
            _errorMessage = _model.ErrorMessage;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
            _model = new WorkOrderPageViewModel();
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsClosedStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        return status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Declined", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static bool CanCustomerApprove(ServiceHistoryEntry workOrder)
    {
        var statusIsOpen = string.Equals(workOrder.Status, "Waiting on Customer Approval", StringComparison.OrdinalIgnoreCase)
            || string.Equals(workOrder.Status, "In Progress", StringComparison.OrdinalIgnoreCase);

        return statusIsOpen && (workOrder.Parts.Any(x => x.IsApplied && !x.IsApproved && !x.IsCustomerDeclined)
            || workOrder.Jobs.Any(x => !x.IsApproved && !x.IsCustomerDeclined && !x.IsDeferred)
            || string.Equals(workOrder.Status, "Waiting on Customer Approval", StringComparison.OrdinalIgnoreCase));
    }

    private async Task ApprovePartAsync(Guid partId, Guid workOrderId)
    {
        _model = await WorkOrderService.ApprovePartAsync(workOrderId, partId);
        _errorMessage = _model.ErrorMessage;
    }

    private async Task ApproveWorkOrderAsync(Guid workOrderId)
    {
        _model = await WorkOrderService.ApproveWorkOrderAsync(workOrderId);
        _errorMessage = _model.ErrorMessage;
    }

    private async Task DeclinePartAsync(Guid partId, Guid workOrderId)
    {
        _model = await WorkOrderService.DeclinePartAsync(workOrderId, partId);
        _errorMessage = _model.ErrorMessage;
    }

    private async Task ApproveJobAsync(Guid jobId, Guid workOrderId)
    {
        _model = await WorkOrderService.ApproveJobAsync(workOrderId, jobId);
        _errorMessage = _model.ErrorMessage;
    }

    private async Task DeclineJobAsync(Guid jobId, Guid workOrderId)
    {
        _model = await WorkOrderService.DeclineJobAsync(workOrderId, jobId);
        _errorMessage = _model.ErrorMessage;
    }

    private async Task DeclineWorkOrderAsync(Guid workOrderId)
    {
        _model = await WorkOrderService.DeclineWorkOrderAsync(workOrderId);
        _errorMessage = _model.ErrorMessage;
    }
}
