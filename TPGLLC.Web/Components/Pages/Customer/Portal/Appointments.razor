@page "/portal/appointments"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.Globalization
@using Microsoft.AspNetCore.Components
@using TPGLLC.Data.Entities
@using TPGLLC.Services.Vehicles
@using TPGLLC.Web.Components.PortalShared.Appointments
@using TPGLLC.Web.Services.Appointments
@using TPGLLC.Web.Services.Portal

@inject IPortalContextService PortalContextService
@inject IVehicleCatalogService VehicleCatalog
@inject IAppointmentService AppointmentService

<PageTitle>Appointments</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>Request Service</h1>
        <p>Choose one of your vehicles or enter a new one, then send your request.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="auth-alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="auth-success">@_successMessage</div>
    }

    <div class="portal-stats">
        <div class="portal-stat">
            <div class="portal-stat-value">@(_portal?.Vehicles.Count ?? 0)</div>
            <div class="portal-stat-label">Vehicles</div>
        </div>

        <div class="portal-stat">
            <div class="portal-stat-value">@(_portal?.AppointmentRequests.Count ?? 0)</div>
            <div class="portal-stat-label">Requests</div>
        </div>

        <div class="portal-stat">
            <div class="portal-stat-value">@(_selectedVehicle is null ? "None" : "Selected")</div>
            <div class="portal-stat-label">Vehicle Choice</div>
        </div>
    </div>

    <div class="portal-section">
        <h2>Your Vehicles</h2>

        @if (_portal is null)
        {
            <div class="portal-activity">
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">⏳</div>
                    <div>Loading your vehicles...</div>
                </div>
            </div>
        }
        else if (_portal.Vehicles.Count == 0)
        {
            <div class="portal-activity">
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">🚗</div>
                    <div>No vehicles are on file yet. Add one first, then come back here to request service.</div>
                </div>
            </div>

            <div class="portal-actions" style="margin-top:1rem;">
                <a class="portal-action-button" href="/portal/vehicles">Go to Vehicle Management</a>
            </div>
        }
        else
        {
            <div class="portal-dashboard-grid">
                @foreach (var vehicle in _portal.Vehicles)
                {
                    <article class="portal-card-link" @key="vehicle.Id">
                        <div class="portal-card-icon">🚙</div>

                        <h3>@GetVehicleTitle(vehicle)</h3>
                        <p>@GetVehicleDetails(vehicle)</p>

                        @if (vehicle.IsPrimary)
                        {
                            <div style="margin-top:0.5rem;font-weight:700;color:#0d2a63;">Primary vehicle</div>
                        }

                        <div class="portal-actions" style="margin-top:1rem;">
                            <button type="button"
                                    class="portal-action-button"
                                    @onclick="@(async () => await UseVehicleAsync(vehicle.Id))">
                                Use This Vehicle
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="portal-section">
        <h2>Recent Requests</h2>

        @if (_portal is null)
        {
            <div class="portal-activity">
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">⏳</div>
                    <div>Loading requests...</div>
                </div>
            </div>
        }
        else if (_portal.AppointmentRequests.Count == 0)
        {
            <div class="portal-activity">
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">📅</div>
                    <div>No appointment requests found yet.</div>
                </div>
            </div>
        }
        else
        {
            <div class="portal-activity">
                @foreach (var request in _portal.AppointmentRequests
                    .OrderByDescending(x => x.SubmittedAtUtc)
                    .Take(5))
                {
                    <div class="portal-activity-item">
                        <div class="portal-activity-icon">📅</div>
                        <div>
                            <strong>@request.ServiceNeeded</strong><br />
                            @GetRequestVehicleSummary(request)<br />
                            <span>@request.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="portal-section" id="appointment-form">
        <h2>Request Details</h2>

        <AppointmentRequestForm Form="@_form"
                                Years="@_years"
                                Makes="@_makes"
                                Models="@_models"
                                OnSave="@EventCallback.Factory.Create(this, SaveRequestAsync)"
                                OnCancel="@EventCallback.Factory.Create(this, ResetFormAsync)"
                                OnYearChanged="@EventCallback.Factory.Create(this, OnVehicleYearChangedAsync)"
                                OnMakeChanged="@EventCallback.Factory.Create(this, OnVehicleMakeChangedAsync)" />
    </div>
</section>

@code {
    private PortalContextViewModel? _portal;
    private IReadOnlyList<int> _years = Array.Empty<int>();
    private IReadOnlyList<string> _makes = Array.Empty<string>();
    private IReadOnlyList<string> _models = Array.Empty<string>();

    private AppointmentRequestFormModel _form = new();
    private string? _errorMessage;
    private string? _successMessage;
    private CustomerVehicle? _selectedVehicle;

    protected override async Task OnInitializedAsync()
    {
        _portal = await PortalContextService.GetAsync();

        _years = (await VehicleCatalog.GetYearsAsync())
            .Distinct()
            .OrderByDescending(x => x)
            .ToList();

        if (_years.Count == 0)
        {
            _years = Enumerable.Range(1995, DateTime.UtcNow.Year - 1995 + 1)
                .Reverse()
                .ToList();
        }

        ResetFormCore();
    }

    private async Task UseVehicleAsync(Guid vehicleId)
    {
        if (_portal is null)
        {
            return;
        }

        _selectedVehicle = _portal.Vehicles.FirstOrDefault(x => x.Id == vehicleId);
        if (_selectedVehicle is null)
        {
            return;
        }

        _form.VehicleYear = _selectedVehicle.ModelYear?.ToString(CultureInfo.InvariantCulture);
        _form.VehicleMake = _selectedVehicle.Make;
        _form.VehicleModel = _selectedVehicle.Model;
        _form.Vin = _selectedVehicle.Vin;
        _form.Mileage = _selectedVehicle.Mileage?.ToString(CultureInfo.InvariantCulture);

        _makes = Array.Empty<string>();
        _models = Array.Empty<string>();

        if (_selectedVehicle.ModelYear.HasValue)
        {
            _makes = (await VehicleCatalog.GetMakesAsync(_selectedVehicle.ModelYear.Value))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            EnsureSelectedValue(_makes, _selectedVehicle.Make);
        }

        if (_selectedVehicle.ModelYear.HasValue && !string.IsNullOrWhiteSpace(_selectedVehicle.Make))
        {
            _models = (await VehicleCatalog.GetModelsAsync(_selectedVehicle.ModelYear.Value, _selectedVehicle.Make))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            EnsureSelectedValue(_models, _selectedVehicle.Model);
        }

        _errorMessage = null;
        _successMessage = null;
        StateHasChanged();
    }

    private async Task OnVehicleYearChangedAsync()
    {
        _form.VehicleMake = null;
        _form.VehicleModel = null;

        _makes = Array.Empty<string>();
        _models = Array.Empty<string>();

        if (int.TryParse(_form.VehicleYear, out var year))
        {
            _makes = await VehicleCatalog.GetMakesAsync(year);
        }

        _selectedVehicle = null;
        StateHasChanged();
    }

    private async Task OnVehicleMakeChangedAsync()
    {
        _form.VehicleModel = null;
        _models = Array.Empty<string>();

        if (int.TryParse(_form.VehicleYear, out var year) &&
            !string.IsNullOrWhiteSpace(_form.VehicleMake))
        {
            _models = await VehicleCatalog.GetModelsAsync(year, _form.VehicleMake);
        }

        _selectedVehicle = null;
        StateHasChanged();
    }

    private async Task SaveRequestAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        if (string.IsNullOrWhiteSpace(_form.Name) ||
            string.IsNullOrWhiteSpace(_form.Phone) ||
            string.IsNullOrWhiteSpace(_form.Email) ||
            string.IsNullOrWhiteSpace(_form.PreferredDate) ||
            string.IsNullOrWhiteSpace(_form.PreferredTime) ||
            string.IsNullOrWhiteSpace(_form.ServiceNeeded) ||
            string.IsNullOrWhiteSpace(_form.Message))
        {
            _errorMessage = "Please complete all required fields.";
            return;
        }

        var request = new AppointmentRequest
        {
            Name = _form.Name.Trim(),
            Phone = _form.Phone.Trim(),
            Email = _form.Email.Trim(),
            VehicleYear = _form.VehicleYear?.Trim(),
            VehicleMake = _form.VehicleMake?.Trim(),
            VehicleModel = _form.VehicleModel?.Trim(),
            Vin = _form.Vin?.Trim(),
            Mileage = _form.Mileage?.Trim(),
            PreferredDate = _form.PreferredDate.Trim(),
            PreferredTime = _form.PreferredTime.Trim(),
            ServiceNeeded = _form.ServiceNeeded.Trim(),
            Message = _form.Message.Trim()
        };

        if (_selectedVehicle is not null)
        {
            request.VehicleYear ??= _selectedVehicle.ModelYear?.ToString(CultureInfo.InvariantCulture);
            request.VehicleMake ??= _selectedVehicle.Make;
            request.VehicleModel ??= _selectedVehicle.Model;
            request.Vin ??= _selectedVehicle.Vin;
            request.Mileage ??= _selectedVehicle.Mileage?.ToString(CultureInfo.InvariantCulture);
        }

        var result = await AppointmentService.SubmitAsync(request);

        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage ?? "Unable to submit the appointment request.";
            return;
        }

        _portal = await PortalContextService.GetAsync();
        ResetFormCore();
        _successMessage = $"Request submitted. Reference #{result.RequestId:D}";
        StateHasChanged();
    }

    private Task ResetFormAsync()
    {
        ResetFormCore();
        return Task.CompletedTask;
    }

    private void ResetFormCore()
    {
        _form = new AppointmentRequestFormModel();
        _makes = Array.Empty<string>();
        _models = Array.Empty<string>();
        _selectedVehicle = null;
        _errorMessage = null;
        _successMessage = null;
    }

    private static string GetVehicleTitle(CustomerVehicle vehicle)
    {
        var year = vehicle.ModelYear?.ToString(CultureInfo.InvariantCulture);
        return string.Join(" ", new[] { year, vehicle.Make, vehicle.Model }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }

    private static string GetVehicleDetails(CustomerVehicle vehicle)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(vehicle.Nickname))
        {
            parts.Add(vehicle.Nickname!);
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Vin))
        {
            parts.Add($"VIN {vehicle.Vin}");
        }

        if (vehicle.Mileage.HasValue)
        {
            parts.Add($"{vehicle.Mileage.Value:N0} mi");
        }

        return parts.Count == 0 ? "No additional details." : string.Join(" • ", parts);
    }

    private static string GetRequestVehicleSummary(AppointmentRequest request)
    {
        var parts = new[]
        {
            request.VehicleYear,
            request.VehicleMake,
            request.VehicleModel
        }.Where(x => !string.IsNullOrWhiteSpace(x));

        var summary = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(summary) ? "Vehicle not specified" : summary;
    }

    private static IReadOnlyList<string> EnsureSelectedValue(IReadOnlyList<string> values,string? selectedValue)
    {
        var list = values.ToList();

        if (!string.IsNullOrWhiteSpace(selectedValue) &&
            !list.Any(x => string.Equals(x, selectedValue, StringComparison.OrdinalIgnoreCase)))
        {
            list.Insert(0, selectedValue);
        }

        return list;
    }
}