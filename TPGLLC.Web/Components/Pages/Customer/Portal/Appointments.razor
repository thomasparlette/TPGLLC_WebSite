@page "/portal/appointments"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using TPGLLC.Web.Services.Portal
@using TPGLLC.Web.ViewModels.Portal
@using TPGLLC.Web.Components.PortalShared.Appointments

@inject IAppointmentPortalService AppointmentPortalService

<PageTitle>Appointments</PageTitle>

<section class="portal-dashboard">
    <AppointmentPageHeader />

    @if (!string.IsNullOrWhiteSpace(_model.ErrorMessage))
    {
        <div class="auth-alert">@_model.ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
    {
        <div class="auth-success">@_model.SuccessMessage</div>
    }

    <AppointmentStats TotalRequests="@_model.Requests.Count.ToString()"
                      OpenRequests="@_model.OpenRequests.Count.ToString()"
                      LatestRequestDate="@GetLatestRequestDate()"
                      LatestRequestStatus="@GetLatestRequestStatus()" />

    <div class="portal-section">
        <h2>Quick Actions</h2>

        <div class="portal-actions portal-actions-wrap">
            <a class="portal-action-button" href="/portal/vehicles">Choose Vehicle</a>
            <a class="portal-action-button" href="/portal/history">View History</a>
            <a class="portal-action-button" href="/portal/dashboard">Back to Dashboard</a>
        </div>
    </div>

    <AppointmentRequestsList Requests="@_model.Requests" />

    <AppointmentRequestForm Form="@_model.Form"
                            Years="@_model.Years"
                            Makes="@_model.Makes"
                            Models="@_model.Models"
                            OnSave="@EventCallback.Factory.Create(this, SaveRequestAsync)"
                            OnCancel="@EventCallback.Factory.Create(this, ResetFormAsync)"
                            OnYearChanged="@EventCallback.Factory.Create(this, OnVehicleYearChangedAsync)"
                            OnMakeChanged="@EventCallback.Factory.Create(this, OnVehicleMakeChangedAsync)" />
</section>

@code {
    private AppointmentPageViewModel _model = new();

    protected override async Task OnInitializedAsync()
    {
        _model = await AppointmentPortalService.GetAsync();
    }

    private async Task SaveRequestAsync()
    {
        _model = await AppointmentPortalService.SaveAsync(_model);
    }

    private async Task ResetFormAsync()
    {
        _model = await AppointmentPortalService.ResetAsync();
    }

    private async Task OnVehicleYearChangedAsync()
    {
        _model = await AppointmentPortalService.YearChangedAsync(_model);
    }

    private async Task OnVehicleMakeChangedAsync()
    {
        _model = await AppointmentPortalService.MakeChangedAsync(_model);
    }

    private string GetLatestRequestDate()
    {
        var latest = _model.Requests.FirstOrDefault();
        return latest is null
            ? "None"
            : latest.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy");
    }

    private string GetLatestRequestStatus()
    {
        var latest = _model.Requests.FirstOrDefault();
        return latest?.Status ?? "None";
    }
}