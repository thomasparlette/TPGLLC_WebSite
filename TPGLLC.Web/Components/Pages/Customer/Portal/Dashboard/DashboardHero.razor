<div class="portal-hero">
    <div>
        <p class="section-kicker">Customer Portal</p>
        <h1>Welcome back, @DisplayName</h1>
        <p>Manage your vehicles, appointments, service history, and invoices in one place.</p>
    </div>

    <div class="portal-hero-badge">
        <span>Live Portal</span>
        <strong>@VehicleCount vehicle@(VehicleCount == 1 ? "" : "s")</strong>
    </div>
</div>

@code {
    [Parameter] public string DisplayName { get; set; } = "Customer";
    [Parameter] public int VehicleCount { get; set; }
}