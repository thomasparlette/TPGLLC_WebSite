@page "/portal/profile"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using TPGLLC.Data.Entities
@using TPGLLC.Web.Services.Customers

@inject ICustomerProfileService CustomerProfileService
@inject ICurrentCustomerAccessor CurrentCustomerAccessor

<PageTitle>My Profile</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>My Profile</h1>
        <p>Update your contact details and communication preferences.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="auth-alert">@_errorMessage</div>
    }

    @if (_saved)
    {
        <div class="auth-success">Profile saved successfully.</div>
    }

    <div class="portal-section">
        <h2>Account Summary</h2>
        <div class="portal-activity">
            <div class="portal-activity-item">
                <div class="portal-activity-icon">👤</div>
                <div>
                    <div><strong>@_accountEmail</strong></div>
                    <div>@(_profile.UpdatedUtc?.ToString("MMM d, yyyy h:mm tt") ?? "No updates yet")</div>
                </div>
            </div>
        </div>
    </div>

    <EditForm Model="_profile" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="portal-section">
            <h2>Contact Information</h2>
            <div class="profile-grid">
                <div class="form-field">
                    <label>First Name</label>
                    <input @bind="_profile.FirstName" />
                </div>

                <div class="form-field">
                    <label>Last Name</label>
                    <input @bind="_profile.LastName" />
                </div>

                <div class="form-field">
                    <label>Phone</label>
                    <input @bind="_profile.Phone" />
                </div>

                <div class="form-field">
                    <label>Company</label>
                    <input @bind="_profile.Company" />
                </div>
            </div>
        </div>

        <div class="portal-section">
            <h2>Address</h2>
            <div class="profile-grid">
                <div class="form-field full">
                    <label>Address Line 1</label>
                    <input @bind="_profile.Address1" />
                </div>

                <div class="form-field full">
                    <label>Address Line 2</label>
                    <input @bind="_profile.Address2" />
                </div>

                <div class="form-field">
                    <label>City</label>
                    <input @bind="_profile.City" />
                </div>

                <div class="form-field">
                    <label>State</label>
                    <input @bind="_profile.State" />
                </div>

                <div class="form-field">
                    <label>Zip Code</label>
                    <input @bind="_profile.ZipCode" />
                </div>

                <div class="form-field">
                    <label>Country</label>
                    <input @bind="_profile.Country" />
                </div>
            </div>
        </div>

        <div class="portal-section">
            <h2>Communication Preferences</h2>
            <div class="profile-grid">
                <div class="form-field">
                    <label>Preferred Contact Method</label>
                    <select @bind="_profile.PreferredContactMethod">
                        <option value="">Select one</option>
                        <option value="Email">Email</option>
                        <option value="SMS">SMS</option>
                        <option value="Phone">Phone</option>
                    </select>
                </div>

                <div class="form-check">
                    <input type="checkbox" @bind="_profile.ReceiveEmail" />
                    <label>Receive email updates</label>
                </div>

                <div class="form-check">
                    <input type="checkbox" @bind="_profile.ReceiveSms" />
                    <label>Receive SMS updates</label>
                </div>
            </div>
        </div>

        <div class="portal-actions" style="margin-top: 1.5rem;">
            <button type="submit" class="portal-action-button">Save Profile</button>
            <a class="portal-action-button" href="/portal/dashboard">Back to Dashboard</a>
        </div>
    </EditForm>
</section>

@code {
    private CustomerProfile _profile = new();
    private string? _accountEmail;
    private string? _errorMessage;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        var current = CurrentCustomerAccessor.GetCurrentCustomer();
        _accountEmail = current.Email;

        if (!current.IsAuthenticated)
        {
            _errorMessage = "You must be signed in to view your profile.";
            return;
        }

        var profile = await CustomerProfileService.GetCurrentAsync();

        _profile = profile ?? new CustomerProfile
        {
            ApplicationUserId = current.UserId,
            ReceiveEmail = true
        };
    }

    private async Task SaveAsync()
    {
        _errorMessage = null;
        _saved = false;

        try
        {
            var current = CurrentCustomerAccessor.GetCurrentCustomer();

            if (!_profile.ApplicationUserId.Equals(current.UserId, StringComparison.Ordinal))
            {
                _profile.ApplicationUserId = current.UserId;
            }

            _profile = await CustomerProfileService.SaveAsync(_profile);
            _saved = true;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
    }
}