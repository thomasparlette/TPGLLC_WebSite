@page "/customer/invoices"
@rendermode InteractiveServer
@inject CustomerPortalStore PortalStore
@attribute [Authorize]

@layout CustomerLayout

<div class="quote-card" style="margin-bottom:1.5rem;">
    <p class="section-kicker">Invoices</p>
    <h1 style="margin-top:0;">Invoices</h1>
    <p style="margin-bottom:0;">Track paid and outstanding balances.</p>
</div>

@if (PortalStore.Invoices.Count == 0)
{
    <div class="quote-card">
        <h3>No invoices yet</h3>
        <p>Invoices from completed work will appear here.</p>
    </div>
}
else
{
    <div style="display:flex;flex-direction:column;gap:1rem;">
        @foreach (var invoice in PortalStore.Invoices)
        {
            <div class="quote-card">
                <div style="display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;">
                    <div>
                        <p class="section-kicker">@invoice.InvoiceNumber</p>
                        <h3 style="margin-top:0;">@invoice.VehicleName</h3>
                    </div>

                    <span class="btn @(invoice.Paid ? "btn-secondary" : "btn-primary")" style="pointer-events:none;">
                        @invoice.Status
                    </span>
                </div>

                <div style="display:grid;gap:.35rem;margin-top:1rem;">
                    <div><strong>Date:</strong> @invoice.Date.ToString("MMM d, yyyy")</div>
                    <div><strong>Total:</strong> @invoice.Total.ToString("C")</div>
                </div>
            </div>
        }
    </div>
}