@page "/portal/dashboard"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using Microsoft.EntityFrameworkCore
@using TPGLLC.Data
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Services.Customers

@inject TPGLLCDbContext Db
@inject ICurrentCustomerAccessor CurrentCustomerAccessor

<PageTitle>Customer Portal</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>Welcome back, @DisplayName</h1>
        <p>Manage your vehicles, appointments, service history, and invoices in one place.</p>
    </div>

    <div class="portal-stats">
        <div class="portal-stat">
            <div class="portal-stat-value">@_vehicles.Count</div>
            <div class="portal-stat-label">Vehicles</div>
        </div>

        <div class="portal-stat">
            <div class="portal-stat-value">@_requests.Count</div>
            <div class="portal-stat-label">Appointment Requests</div>
        </div>

        <div class="portal-stat">
            <div class="portal-stat-value">@_history.Count</div>
            <div class="portal-stat-label">Service Visits</div>
        </div>

        <div class="portal-stat">
            <div class="portal-stat-value">@_vehicles.Count(v => v.IsPrimary)</div>
            <div class="portal-stat-label">Primary Vehicle</div>
        </div>
    </div>

    <div class="portal-section">
        <h2>Quick Actions</h2>
        <div class="portal-actions">
            <a class="portal-action-button" href="/portal/vehicles">Add Vehicle</a>
            <a class="portal-action-button" href="/portal/appointments">Request Appointment</a>
            <a class="portal-action-button" href="/portal/history">View History</a>
            <a class="portal-action-button" href="/portal/invoices">Review Invoices</a>
        </div>
    </div>

    <div class="portal-section">
        <h2>My Vehicles</h2>
        @if (_vehicles.Count == 0)
        {
            <div class="portal-activity">
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">🚗</div>
                    <div>No vehicles are on file yet.</div>
                </div>
            </div>
        }
        else
        {
            <div class="portal-dashboard-grid">
                @foreach (var vehicle in _vehicles)
                {
                    <a class="portal-card-link" href="/portal/vehicles" @key="vehicle.Id">
                        <div class="portal-card-icon">🚗</div>
                        <h3>@GetVehicleTitle(vehicle)</h3>
                        <p>@GetVehicleDetails(vehicle)</p>
                    </a>
                }
            </div>
        }
    </div>

    <div class="portal-section">
        <h2>Recent Appointment Requests</h2>
        @if (_requests.Count == 0)
        {
            <div class="portal-activity">
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">📅</div>
                    <div>No appointment requests found for your account email.</div>
                </div>
            </div>
        }
        else
        {
            <div class="portal-activity">
                @foreach (var request in _requests)
                {
                    <div class="portal-activity-item">
                        <div class="portal-activity-icon">📅</div>
                        <div>
                            <div><strong>@request.ServiceNeeded</strong></div>
                            <div>@FormatAppointmentRequest(request)</div>
                            <div>Status: @request.Status</div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="portal-section">
        <h2>Service History</h2>
        @if (_history.Count == 0)
        {
            <div class="portal-activity">
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">🛠️</div>
                    <div>No service history found for this customer.</div>
                </div>
            </div>
        }
        else
        {
            <div class="portal-activity">
                @foreach (var item in _history)
                {
                    <div class="portal-activity-item">
                        <div class="portal-activity-icon">🛠️</div>
                        <div>
                            <div><strong>@item.VehicleName</strong></div>
                            <div>@item.Service</div>
                            <div>@item.ServiceDate.ToString("MMM d, yyyy") · @item.Status</div>
                            @if (item.Mileage.HasValue)
                            {
                                <div>@item.Mileage.Value.ToString("N0") mi</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Technician))
                            {
                                <div>Technician: @item.Technician</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private CustomerProfile? _profile;
    private Customer? _customer;
    private List<CustomerVehicle> _vehicles = [];
    private List<AppointmentRequest> _requests = [];
    private List<ServiceHistoryEntry> _history = [];

    private string DisplayName =>
        _profile is null
            ? "Customer"
            : $"{_profile.FirstName} {_profile.LastName}".Trim();

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        Db.ChangeTracker.Clear();

        _profile = null;
        _customer = null;
        _vehicles = [];
        _requests = [];
        _history = [];

        var current = CurrentCustomerAccessor.GetCurrentCustomer();
        if (!current.IsAuthenticated)
        {
            return;
        }

        _profile = await Db.CustomerProfiles
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.ApplicationUserId == current.UserId);

        _vehicles = await Db.CustomerVehicles
            .AsNoTracking()
            .Where(v => v.Customer.ApplicationUserId == current.UserId)
            .OrderByDescending(v => v.IsPrimary)
            .ThenByDescending(v => v.CreatedUtc)
            .ToListAsync();

        _history = await Db.ServiceHistoryEntries
            .AsNoTracking()
            .Where(h => h.Customer.ApplicationUserId == current.UserId)
            .OrderByDescending(h => h.ServiceDate)
            .Take(5)
            .ToListAsync();

        if (!string.IsNullOrWhiteSpace(current.Email))
        {
            _requests = await Db.AppointmentRequests
                .AsNoTracking()
                .Where(x => x.Email == current.Email)
                .OrderByDescending(x => x.SubmittedAtUtc)
                .Take(5)
                .ToListAsync();
        }
    }

    private static string GetVehicleTitle(CustomerVehicle vehicle)
    {
        var year = vehicle.ModelYear?.ToString() ?? "";
        var make = vehicle.Make ?? "";
        var model = vehicle.Model ?? "";

        var title = string.Join(" ", new[] { year, make, model }.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(title) ? "Unnamed Vehicle" : title;
    }

    private static string GetVehicleDetails(CustomerVehicle vehicle)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(vehicle.Nickname))
        {
            parts.Add(vehicle.Nickname);
        }

        if (vehicle.Mileage.HasValue)
        {
            parts.Add($"{vehicle.Mileage.Value:N0} mi");
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Vin))
        {
            parts.Add($"VIN {vehicle.Vin}");
        }

        return parts.Count == 0 ? "No additional details" : string.Join(" · ", parts);
    }

    private static string FormatAppointmentRequest(AppointmentRequest request)
    {
        var when = string.Join(" ", new[]
        {
            request.PreferredDate,
            request.PreferredTime
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

        return string.IsNullOrWhiteSpace(when)
            ? "No preferred date/time provided"
            : when;
    }
}