@page "/portal/vehicles"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Linq
@using Microsoft.EntityFrameworkCore
@using TPGLLC.Data
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Services.Customers

@inject TPGLLCDbContext Db
@inject ICurrentCustomerAccessor CurrentCustomerAccessor
@inject ICustomerProfileService CustomerProfileService

<PageTitle>My Vehicles</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Customer Portal</p>
        <h1>My Vehicles</h1>
        <p>Add, edit, delete, and mark your primary vehicle.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="auth-alert">@_errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage))
    {
        <div class="auth-success">@_successMessage</div>
    }

    <div class="portal-stats">
        <div class="portal-stat">
            <div class="portal-stat-value">@_vehicles.Count</div>
            <div class="portal-stat-label">Vehicles</div>
        </div>

        <div class="portal-stat">
            <div class="portal-stat-value">@_vehicles.Count(x => x.IsPrimary)</div>
            <div class="portal-stat-label">Primary Vehicles</div>
        </div>
    </div>

    <div class="portal-section">
        <h2>Your Vehicles</h2>

        @if (_vehicles.Count == 0)
        {
            <div class="portal-activity">
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">🚗</div>
                    <div>No vehicles are on file yet.</div>
                </div>
            </div>
        }
        else
        {
            <div class="portal-dashboard-grid">
                @foreach (var vehicle in _vehicles)
                {
                    <article class="portal-card-link" @key="vehicle.Id">
                        <div class="portal-card-icon">@GetVehicleIcon(vehicle.VehicleType)</div>

                        <h3>@GetVehicleTitle(vehicle)</h3>
                        <p>@GetVehicleDetails(vehicle)</p>

                        @if (vehicle.IsPrimary)
                        {
                            <div style="margin-top:0.5rem;font-weight:700;color:#0d2a63;">Primary vehicle</div>
                        }

                        <div class="portal-actions" style="margin-top:1rem;">
                            <button type="button"
                                    class="portal-action-button"
                                    @onclick="() => EditVehicle(vehicle.Id)">
                                Edit
                            </button>

                            <button type="button"
                                    class="portal-action-button"
                                    @onclick="() => SetPrimaryVehicleAsync(vehicle.Id)"
                                    disabled="@vehicle.IsPrimary">
                                Make Primary
                            </button>

                            <button type="button"
                                    class="portal-action-button"
                                    @onclick="() => DeleteVehicleAsync(vehicle.Id)">
                                Delete
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </div>

    <div class="portal-section">
        <h2>@(_editingVehicleId is null ? "Add Vehicle" : "Edit Vehicle")</h2>

        <div class="auth-card" style="margin-left:0; margin-right:0; width:100%;">
            <EditForm Model="_form" OnValidSubmit="SaveVehicleAsync">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="vehicle-grid">
                    <div class="form-field">
                        <label>Model Year</label>
                        <InputText class="input" @bind-Value="_form.ModelYear" placeholder="e.g. 2021" />
                    </div>

                    <div class="form-field">
                        <label>Make</label>
                        <InputText class="input" @bind-Value="_form.Make" placeholder="e.g. Ford" />
                    </div>

                    <div class="form-field">
                        <label>Model</label>
                        <InputText class="input" @bind-Value="_form.Model" placeholder="e.g. F-150" />
                    </div>

                    <div class="form-field">
                        <label>Vehicle Type</label>
                        <InputSelect class="input" @bind-Value="_form.VehicleType">
                            <option value="">Select type</option>
                            <option value="Automotive">Automotive</option>
                            <option value="Motorcycle">Motorcycle</option>
                            <option value="Other">Other</option>
                        </InputSelect>
                    </div>

                    <div class="form-field">
                        <label>Nickname</label>
                        <InputText class="input" @bind-Value="_form.Nickname" />
                    </div>

                    <div class="form-field">
                        <label>License Plate</label>
                        <InputText class="input" @bind-Value="_form.LicensePlate" />
                    </div>

                    <div class="form-field">
                        <label>VIN</label>
                        <InputText class="input" @bind-Value="_form.Vin" maxlength="17" />
                    </div>

                    <div class="form-field">
                        <label>Mileage</label>
                        <InputText class="input" @bind-Value="_form.Mileage" placeholder="e.g. 52,800" />
                    </div>

                    <div class="form-check full">
                        <InputCheckbox @bind-Value="_form.IsPrimary" />
                        <label>Make this my primary vehicle</label>
                    </div>
                </div>

                <div class="portal-actions" style="margin-top:1.25rem;">
                    <button type="submit" class="portal-action-button">
                        @(_editingVehicleId is null ? "Add Vehicle" : "Save Changes")
                    </button>

                    <button type="button" class="portal-action-button" @onclick="ResetForm">
                        Cancel
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</section>

@code {
    private Customer? _customer;
    private List<CustomerVehicle> _vehicles = [];
    private Guid? _editingVehicleId;
    private string? _errorMessage;
    private string? _successMessage;

    private VehicleFormModel _form = new()
    {
        VehicleType = "Automotive"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        var current = CurrentCustomerAccessor.GetCurrentCustomer();
        if (!current.IsAuthenticated)
        {
            _errorMessage = "You must be signed in to manage vehicles.";
            return;
        }

        _customer = await Db.Customers
            .Include(x => x.Vehicles)
            .FirstOrDefaultAsync(x => x.ApplicationUserId == current.UserId);

        if (_customer is null)
        {
            await EnsureCustomerAsync(current);
        }

        await ReloadVehiclesAsync();
        ResetForm();
    }

    private async Task EnsureCustomerAsync(CurrentCustomer current)
    {
        var profile = await CustomerProfileService.GetCurrentAsync();

        _customer = new Customer
        {
            ApplicationUserId = current.UserId,
            FirstName = string.IsNullOrWhiteSpace(profile?.FirstName) ? "Customer" : profile!.FirstName.Trim(),
            LastName = string.IsNullOrWhiteSpace(profile?.LastName) ? "Account" : profile!.LastName.Trim(),
            Email = string.IsNullOrWhiteSpace(current.Email) ? profile?.Phone : current.Email,
            Phone = profile?.Phone,
            AddressLine1 = profile?.Address1,
            AddressLine2 = profile?.Address2,
            City = profile?.City,
            State = profile?.State,
            PostalCode = profile?.ZipCode
        };

        Db.Customers.Add(_customer);
        await Db.SaveChangesAsync();
    }

    private async Task ReloadVehiclesAsync()
    {
        if (_customer is null)
        {
            _vehicles = [];
            return;
        }

        _vehicles = await Db.CustomerVehicles
            .Where(x => x.CustomerId == _customer.Id)
            .OrderByDescending(x => x.IsPrimary)
            .ThenByDescending(x => x.CreatedUtc)
            .ToListAsync();
    }

    private void ResetForm()
    {
        _editingVehicleId = null;
        _form = new VehicleFormModel
        {
            VehicleType = "Automotive"
        };
    }

    private void EditVehicle(Guid id)
    {
        var vehicle = _vehicles.FirstOrDefault(x => x.Id == id);
        if (vehicle is null)
        {
            return;
        }

        _editingVehicleId = id;
        _errorMessage = null;
        _successMessage = null;

        _form = new VehicleFormModel
        {
            VehicleType = vehicle.VehicleType,
            ModelYear = vehicle.ModelYear?.ToString(),
            Make = vehicle.Make,
            Model = vehicle.Model,
            Vin = vehicle.Vin,
            Nickname = vehicle.Nickname,
            LicensePlate = vehicle.LicensePlate,
            Mileage = vehicle.Mileage?.ToString(),
            IsPrimary = vehicle.IsPrimary
        };
    }

    private async Task SaveVehicleAsync()
    {
        _errorMessage = null;
        _successMessage = null;

        if (_customer is null)
        {
            _errorMessage = "Customer record not available.";
            return;
        }

        if (!TryParseYear(_form.ModelYear, out var modelYear))
        {
            _errorMessage = "Model year must be a valid year.";
            return;
        }

        if (!TryParseMileage(_form.Mileage, out var mileage))
        {
            _errorMessage = "Mileage must be a valid whole number.";
            return;
        }

        var isNew = _editingVehicleId is null;

        CustomerVehicle vehicle;
        if (isNew)
        {
            vehicle = new CustomerVehicle
            {
                CustomerId = _customer.Id,
                CreatedUtc = DateTimeOffset.UtcNow
            };

            Db.CustomerVehicles.Add(vehicle);
        }
        else
        {
            vehicle = await Db.CustomerVehicles
                .FirstOrDefaultAsync(x => x.Id == _editingVehicleId && x.CustomerId == _customer.Id)
                ?? throw new InvalidOperationException("Vehicle not found.");
        }

        vehicle.VehicleType = _form.VehicleType.Trim();
        vehicle.ModelYear = modelYear;
        vehicle.Make = string.IsNullOrWhiteSpace(_form.Make) ? null : _form.Make.Trim();
        vehicle.Model = string.IsNullOrWhiteSpace(_form.Model) ? null : _form.Model.Trim();
        vehicle.Vin = string.IsNullOrWhiteSpace(_form.Vin) ? null : _form.Vin.Trim();
        vehicle.Nickname = string.IsNullOrWhiteSpace(_form.Nickname) ? null : _form.Nickname.Trim();
        vehicle.LicensePlate = string.IsNullOrWhiteSpace(_form.LicensePlate) ? null : _form.LicensePlate.Trim();
        vehicle.Mileage = mileage;
        vehicle.IsPrimary = _form.IsPrimary;
        vehicle.UpdatedUtc = DateTimeOffset.UtcNow;

        if (vehicle.IsPrimary)
        {
            await ClearOtherPrimaryVehiclesAsync(vehicle.Id);
        }

        await Db.SaveChangesAsync();
        await ReloadVehiclesAsync();

        _successMessage = isNew ? "Vehicle added." : "Vehicle updated.";
        ResetForm();
    }

    private async Task DeleteVehicleAsync(Guid id)
    {
        if (_customer is null)
        {
            return;
        }

        var vehicle = await Db.CustomerVehicles
            .FirstOrDefaultAsync(x => x.Id == id && x.CustomerId == _customer.Id);

        if (vehicle is null)
        {
            return;
        }

        var wasPrimary = vehicle.IsPrimary;

        Db.CustomerVehicles.Remove(vehicle);
        await Db.SaveChangesAsync();

        if (wasPrimary)
        {
            var fallback = await Db.CustomerVehicles
                .Where(x => x.CustomerId == _customer.Id)
                .OrderByDescending(x => x.CreatedUtc)
                .FirstOrDefaultAsync();

            if (fallback is not null)
            {
                fallback.IsPrimary = true;
                fallback.UpdatedUtc = DateTimeOffset.UtcNow;
                await Db.SaveChangesAsync();
            }
        }

        _successMessage = "Vehicle deleted.";
        if (_editingVehicleId == id)
        {
            ResetForm();
        }

        await ReloadVehiclesAsync();
    }

    private async Task SetPrimaryVehicleAsync(Guid id)
    {
        if (_customer is null)
        {
            return;
        }

        var selected = await Db.CustomerVehicles
            .FirstOrDefaultAsync(x => x.Id == id && x.CustomerId == _customer.Id);

        if (selected is null)
        {
            return;
        }

        var currentPrimary = await Db.CustomerVehicles
            .Where(x => x.CustomerId == _customer.Id && x.Id != id && x.IsPrimary)
            .ToListAsync();

        foreach (var vehicle in currentPrimary)
        {
            vehicle.IsPrimary = false;
            vehicle.UpdatedUtc = DateTimeOffset.UtcNow;
        }

        selected.IsPrimary = true;
        selected.UpdatedUtc = DateTimeOffset.UtcNow;

        await Db.SaveChangesAsync();
        await ReloadVehiclesAsync();

        _successMessage = "Primary vehicle updated.";
    }

    private async Task ClearOtherPrimaryVehiclesAsync(Guid keepVehicleId)
    {
        if (_customer is null)
        {
            return;
        }

        var others = await Db.CustomerVehicles
            .Where(x => x.CustomerId == _customer.Id && x.Id != keepVehicleId && x.IsPrimary)
            .ToListAsync();

        foreach (var vehicle in others)
        {
            vehicle.IsPrimary = false;
            vehicle.UpdatedUtc = DateTimeOffset.UtcNow;
        }
    }

    private static bool TryParseYear(string? value, out int? year)
    {
        year = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (int.TryParse(value.Trim(), out var parsed) && parsed is >= 1900 and <= 3000)
        {
            year = parsed;
            return true;
        }

        return false;
    }

    private static bool TryParseMileage(string? value, out int? mileage)
    {
        mileage = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        var normalized = value.Replace(",", "", StringComparison.Ordinal).Trim();
        if (int.TryParse(normalized, out var parsed) && parsed >= 0)
        {
            mileage = parsed;
            return true;
        }

        return false;
    }

    private static string GetVehicleTitle(CustomerVehicle vehicle)
    {
        var titleParts = new[]
        {
            vehicle.ModelYear?.ToString(),
            vehicle.Make,
            vehicle.Model
        }
        .Where(x => !string.IsNullOrWhiteSpace(x));

        var title = string.Join(" ", titleParts);
        return string.IsNullOrWhiteSpace(title) ? "Unnamed Vehicle" : title;
    }

    private static string GetVehicleDetails(CustomerVehicle vehicle)
    {
        var details = new List<string>();

        if (!string.IsNullOrWhiteSpace(vehicle.VehicleType))
        {
            details.Add(vehicle.VehicleType);
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Nickname))
        {
            details.Add(vehicle.Nickname);
        }

        if (vehicle.Mileage.HasValue)
        {
            details.Add($"{vehicle.Mileage.Value:N0} mi");
        }

        if (!string.IsNullOrWhiteSpace(vehicle.LicensePlate))
        {
            details.Add($"Plate {vehicle.LicensePlate}");
        }

        return details.Count == 0 ? "No additional details" : string.Join(" · ", details);
    }

    private static string GetVehicleIcon(string? vehicleType)
    {
        return vehicleType?.ToLowerInvariant() switch
        {
            "motorcycle" => "🏍",
            "other" => "🚙",
            _ => "🚗"
        };
    }

    private sealed class VehicleFormModel
    {
        [Required]
        public string VehicleType { get; set; } = "Automotive";

        public string? ModelYear { get; set; }

        public string? Make { get; set; }

        public string? Model { get; set; }

        public string? Vin { get; set; }

        public string? Nickname { get; set; }

        public string? LicensePlate { get; set; }

        public string? Mileage { get; set; }

        public bool IsPrimary { get; set; }
    }
}