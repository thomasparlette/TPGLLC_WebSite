@page "/"
@rendermode InteractiveServer
@using TPGLLC.Web.Services;
@using TPGLLC.Services.Vehicles;
@using TPGLLC.Web.Services.Appointments
@using TPGLLC.Web.Components.PortalShared.Vehicles
@using TPGLLC.Web.Services.Vehicles
@inject IVehicleCatalogService VehicleCatalog
@inject IAppointmentService AppointmentService

<PageTitle>Tom Parlette Garage LLC</PageTitle>

<section class="hero-shell">
    <div class="hero-main">
        <img class="hero-logo" src="/images/logo.jpeg" alt="Tom Parlette Garage LLC logo" />

        <div class="hero-divider"></div>

        <p class="eyebrow">Automotive &amp; Motorcycle Repair</p>
        <h1>Built on Trust. Driven by Results.</h1>
        <p class="lead">
            Professional repair, honest estimates, and clear communication for every customer and every ride.
        </p>

        <div class="hero-highlights">
            <span>Diagnostics</span>
            <span>Maintenance</span>
            <span>Brake Repair</span>
            <span>Electrical</span>
            <span>Suspension</span>
            <span>Motorcycles</span>
        </div>

        <div class="hero-actions">
            <a class="btn btn-primary" href="#appointment">Request Appointment</a>
            <a class="btn btn-secondary" href="tel:+17653463354">Call Now</a>
        </div>
    </div>

    <aside class="hero-aside">
        <div class="hero-aside-card animate-card">
            <div class="aside-icon">🕒</div>
            <h3>Honest Service Every Time</h3>
            <p>Clear answers. No surprises.</p>
        </div>

        <div class="hero-aside-card animate-card">
            <div class="aside-icon">🛡</div>
            <h3>Quality Repairs Done Right</h3>
            <p>We diagnose the problem, not guess.</p>
        </div>

        <div class="hero-aside-card animate-card">
            <div class="aside-icon">👥</div>
            <h3>Local &amp; Reliable</h3>
            <p>Proudly serving Columbus and the surrounding area.</p>
        </div>
    </aside>
</section>

<section id="services" class="section services-band">
    <div class="section-heading center">
        <p class="section-kicker">Services We Provide</p>
        <h2>Clear repairs, careful diagnostics, and dependable service.</h2>
    </div>

    <div class="service-grid">
        <article class="service-card animate-card">
            <div class="service-icon">⚙</div>
            <h3>Diagnostics</h3>
            <p>Check engine lights, drivability issues, and electrical troubleshooting.</p>
        </article>

        <article class="service-card animate-card">
            <div class="service-icon">🛑</div>
            <h3>Brake Repair</h3>
            <p>Pads, rotors, calipers, and brake system inspections.</p>
        </article>

        <article class="service-card animate-card">
            <div class="service-icon">🛞</div>
            <h3>Suspension &amp; Steering</h3>
            <p>Shocks, struts, steering, and ride quality concerns.</p>
        </article>

        <article class="service-card animate-card">
            <div class="service-icon">🛢</div>
            <h3>Maintenance</h3>
            <p>Oil changes, fluids, filters, and preventative care.</p>
        </article>

        <article class="service-card animate-card">
            <div class="service-icon">🔋</div>
            <h3>Electrical Systems</h3>
            <p>Battery, charging, starter, wiring, and sensor issues.</p>
        </article>

        <article class="service-card animate-card">
            <div class="service-icon">🚗</div>
            <h3>Engine Repair</h3>
            <p>Cooling, timing, misfires, and major engine repairs.</p>
        </article>

        <article class="service-card animate-card">
            <div class="service-icon">🏍</div>
            <h3>Motorcycle Service</h3>
            <p>Maintenance, diagnosis, and repair for motorcycles and small-bore machines.</p>
        </article>
    </div>
</section>

<section id="about" class="section about-section">
    <div class="about-grid">
        <div class="about-copy">
            <p class="section-kicker">About</p>
            <h2>A shop built on trust and straightforward communication.</h2>
            <p>
                Tom Parlette Garage LLC provides automotive and motorcycle repair with a focus on honest diagnosis,
                quality workmanship, and practical solutions that keep customers informed.
            </p>
            <p>
                The goal is simple: explain the problem clearly, repair it correctly, and make sure you know what was
                done before the vehicle leaves the shop.
            </p>
        </div>

        <div class="feature-panel animate-card">
            <h3>What you can expect</h3>
            <ul class="check-list compact">
                <li>Clear estimates and direct communication</li>
                <li>Diagnostics before parts replacement</li>
                <li>Professional repairs done right</li>
                <li>Automotive and motorcycle service</li>
            </ul>
        </div>
    </div>
</section>

<section id="process" class="section">
    <div class="section-heading">
        <p class="section-kicker">Our Process</p>
        <h2>Simple, clear, and professional from start to finish.</h2>
    </div>

    <div class="process-grid">
        <div class="process-step animate-card">
            <div class="step-number">1</div>
            <h3>Inspect</h3>
            <p>We listen to your concerns and inspect the vehicle.</p>
        </div>

        <div class="process-step animate-card">
            <div class="step-number">2</div>
            <h3>Diagnose</h3>
            <p>We identify the issue with proper tools and testing.</p>
        </div>

        <div class="process-step animate-card">
            <div class="step-number">3</div>
            <h3>Discuss</h3>
            <p>We explain the findings and review the options.</p>
        </div>

        <div class="process-step animate-card">
            <div class="step-number">4</div>
            <h3>Repair</h3>
            <p>We complete the work with care and quality parts.</p>
        </div>

        <div class="process-step animate-card">
            <div class="step-number">5</div>
            <h3>Verify</h3>
            <p>We test everything before the vehicle is returned.</p>
        </div>
    </div>
</section>

<section class="section">
    <div class="section-heading">
        <p class="section-kicker">Why Customers Choose Us</p>
        <h2>Built around trust and direct communication.</h2>
    </div>

    <div class="why-grid">
        <div class="feature-panel animate-card">
            <ul class="check-list">
                <li>Honest estimates and clear communication</li>
                <li>Diagnostics before replacing parts</li>
                <li>Professional repairs done right</li>
                <li>Modern tools and practical experience</li>
                <li>Locally owned and operated</li>
                <li>Automotive and motorcycle service</li>
            </ul>
        </div>

        <div class="feature-panel animate-card">
            <h3>We service</h3>
            <div class="vehicle-grid">
                <span>Cars</span>
                <span>SUVs</span>
                <span>Trucks</span>
                <span>Vans</span>
                <span>Motorcycles</span>
                <span>Domestic</span>
                <span>Asian</span>
                <span>European</span>
                <span>Gasoline</span>
                <span>Light Diesel</span>
            </div>
        </div>
    </div>
</section>

<section id="faq" class="section faq-section">
    <div class="section-heading">
        <p class="section-kicker">FAQ</p>
        <h2>Common questions customers ask.</h2>
    </div>

    <div class="faq-grid">
        <details class="faq-item">
            <summary>Do I need an appointment?</summary>
            <p>Appointments are recommended so we can make time for a full inspection and give you clear next steps.</p>
        </details>

        <details class="faq-item">
            <summary>Do you work on motorcycles too?</summary>
            <p>Yes. Motorcycle service is part of the shop and can be requested through the same appointment form.</p>
        </details>

        <details class="faq-item">
            <summary>How do I request service?</summary>
            <p>Use the appointment request form below or call the shop directly.</p>
        </details>

        <details class="faq-item">
            <summary>Will I get a confirmation?</summary>
            <p>Yes. Your request is marked pending and you will receive a notification once it is submitted.</p>
        </details>
    </div>
</section>

<section id="appointment" class="section contact-section">
    <div>
        <p class="section-kicker">Contact</p>
        <h2>Request an appointment.</h2>
        <p>
            Tell us what your vehicle needs and we will review your request.
        </p>
    </div>

    <div class="quote-card contact-form-card animate-card">
        @if (_submitted)
        {
            <div class="success-card">
                <div class="success-icon">✓</div>
                <div>
                    <h3>Request received</h3>
                    <p>Your appointment request is pending review. We will contact you soon.</p>
                    <p class="request-id">Reference: @_requestId</p>
                    <p><strong>Vehicle:</strong> @GetVehicleSummary()</p>
                    <p><strong>VIN:</strong> @(string.IsNullOrWhiteSpace(_appointment.Vin) ? "Not provided" : _appointment.Vin)</p>
                </div>
            </div>

            <div class="hero-actions" style="margin-top:1rem;">
                <button type="button" class="btn btn-tertiary" @onclick="ResetForm">Submit Another Request</button>
            </div>
        }
        else
        {
            <EditForm Model="_appointment" OnValidSubmit="SubmitAppointment">
                <DataAnnotationsValidator />
                <ValidationSummary />

                @if (!string.IsNullOrWhiteSpace(_submitError))
                {
                    <div class="form-status warning">@_submitError</div>
                }

                <div class="form-grid">
                    <div class="form-field">
                        <label>Name</label>
                        <InputText class="input" @bind-Value="_appointment.Name" />
                    </div>

                    <div class="form-field">
                        <label>Phone</label>
                        <InputText class="input" @bind-Value="_appointment.Phone" />
                    </div>

                    <div class="form-field full">
                        <label>Email</label>
                        <InputText class="input" type="email" @bind-Value="_appointment.Email" />
                    </div>

                    <div class="form-grid vehicle-grid">
                        <div class="form-field">
                            <label>Vehicle Year</label>
                            <select class="input" @bind="_appointment.VehicleYear" @bind:after="OnVehicleYearChanged">
                                <option value="">Select year</option>
                                @foreach (var year in GetYearOptions())
                                {
                                    <option value="@year">@year</option>
                                }
                            </select>
                        </div>

                        <div class="form-field">
                            <label>Vehicle Make</label>
                            <select class="input" @bind="_appointment.VehicleMake" @bind:after="OnVehicleMakeChanged" disabled="@(_makes.Count == 0)">
                                <option value="">Select make</option>
                                @foreach (var make in GetOptions(_makes, _vpicResult?.MakeOptions))
                                {
                                    <option value="@make">@make</option>
                                }
                            </select>
                        </div>

                        <div class="form-field">
                            <label>Vehicle Model</label>
                            <select class="input" @bind="_appointment.VehicleModel" @bind:after="OnVehicleModelChanged" disabled="@(_models.Count == 0)">
                                <option value="">Select model</option>
                                @foreach (var model in GetOptions(_models, _vpicResult?.ModelOptions))
                                {
                                    <option value="@model">@model</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-grid vehicle-details-grid">
                        <div class="form-field">
                            <label>Submodel (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.VehicleSubmodel" list="public-vehicle-submodel-options" placeholder="Select or enter submodel" />
                        </div>

                        <div class="form-field">
                            <label>Body Style (optional)</label>
                            <InputSelect class="input" @bind-Value="_appointment.BodyStyle">
                                <option value="">Not specified</option>
                                @foreach (var option in GetOptions(_bodyStyleOptions, _vpicResult?.BodyStyleOptions))
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="form-field">
                            <label>Engine / Fuel (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.EngineFuel" list="public-vehicle-engine-options" placeholder="Select or enter engine" />
                        </div>

                        <div class="form-field">
                            <label>Transmission (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.Transmission" list="public-vehicle-transmission-options" placeholder="Select or enter transmission" />
                        </div>

                        <div class="form-field">
                            <label>Drive Type (optional)</label>
                            <InputSelect class="input" @bind-Value="_appointment.DriveType">
                                <option value="">Not specified</option>
                                @foreach (var option in GetOptions(_driveTypeOptions, _vpicResult?.DriveTypeOptions))
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="form-field">
                            <label>Brake (optional)</label>
                            <InputSelect class="input" @bind-Value="_appointment.Brake">
                                <option value="">Not specified</option>
                                @foreach (var option in GetOptions(_brakeOptions, _vpicResult?.BrakeOptions))
                                {
                                    <option value="@option">@option</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="form-field">
                            <label>GVW (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.Gvw" inputmode="numeric" placeholder="Gross vehicle weight" />
                        </div>

                        <div class="form-field">
                            <label>VIN (optional)</label>
                            <div class="vpic-vin-entry">
                                <InputText class="input" @bind-Value="_appointment.Vin" maxlength="17" placeholder="17-character VIN" />
                                <VpicVehicleDecodeButton Vin="@_appointment.Vin" OnDecoded="ApplyVpicDecodeAsync" />
                            </div>
                        </div>

                        <div class="form-field">
                            <label>Mileage</label>
                            <InputText class="input" @bind-Value="_appointment.Mileage" />
                        </div>

                        <div class="form-field">
                            <label>License Plate (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.LicensePlate" />
                        </div>

                        <div class="form-field">
                            <label>State / Province (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.StateProvince" />
                        </div>

                        <div class="form-field">
                            <label>Unit # (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.UnitNumber" />
                        </div>

                        <div class="form-field">
                            <label>Fleet # (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.FleetNumber" />
                        </div>

                        <div class="form-field">
                            <label>Color (optional)</label>
                            <InputText class="input" @bind-Value="_appointment.Color" />
                        </div>
                    </div>

                    <div class="form-field full">
                        <label>Vehicle Memo (optional)</label>
                        <InputTextArea class="input textarea" @bind-Value="_appointment.VehicleMemo" rows="3" />
                    </div>

                    <datalist id="public-vehicle-submodel-options">
                        @foreach (var option in GetOptions(_submodelOptions, _vpicResult?.SubmodelOptions))
                        {
                            <option value="@option"></option>
                        }
                    </datalist>

                    <datalist id="public-vehicle-engine-options">
                        @foreach (var option in GetOptions(_engineFuelOptions, _vpicResult?.EngineFuelOptions))
                        {
                            <option value="@option"></option>
                        }
                    </datalist>

                    <datalist id="public-vehicle-transmission-options">
                        @foreach (var option in GetOptions(_transmissionOptions, _vpicResult?.TransmissionOptions))
                        {
                            <option value="@option"></option>
                        }
                    </datalist>

                    <div class="form-field">
                        <label>Preferred Date</label>
                        <InputText class="input" type="date" @bind-Value="_appointment.PreferredDate" />
                    </div>

                    <div class="form-field full">
                        <label>Preferred Time</label>
                        <InputText class="input" type="time" @bind-Value="_appointment.PreferredTime" />
                    </div>

                    <div class="form-field full">
                        <label>Service Needed</label>
                        <InputSelect class="input" @bind-Value="_appointment.ServiceNeeded">
                            <option value="">Select a service</option>
                            <option>Diagnostics</option>
                            <option>Brake Repair</option>
                            <option>Suspension &amp; Steering</option>
                            <option>Maintenance</option>
                            <option>Electrical Systems</option>
                            <option>Engine Repair</option>
                            <option>Motorcycle Service</option>
                        </InputSelect>
                    </div>

                    <div class="form-field full">
                        <label>Message</label>
                        <InputTextArea class="input textarea" @bind-Value="_appointment.Message" rows="6" />
                    </div>
                </div>

                <button type="submit"
                        class="btn btn-primary full-width"
                        disabled="@_isSubmitting">
                    @(_isSubmitting ? "Sending Appointment" : "Request Appointment")
                </button>
            </EditForm>
        }
    </div>
</section>

@code {
    private readonly AppointmentRequest _appointment = new();
    private IReadOnlyList<int> _years = [];
    private IReadOnlyList<string> _makes = [];
    private IReadOnlyList<string> _models = [];

    private string? _submitError;
    private string? _requestId;
    private bool _submitted;
    private bool _isSubmitting;
    private VpicVehicleDecodeResult? _vpicResult;
    private IReadOnlyList<string> _submodelOptions = VehicleAttributeOptions.CommonSubmodels;
    private IReadOnlyList<string> _bodyStyleOptions = VehicleAttributeOptions.BodyStyles;
    private IReadOnlyList<string> _engineFuelOptions = VehicleAttributeOptions.CommonEngineFuelTypes;
    private IReadOnlyList<string> _transmissionOptions = VehicleAttributeOptions.CommonTransmissions;
    private IReadOnlyList<string> _driveTypeOptions = VehicleAttributeOptions.DriveTypes;
    private IReadOnlyList<string> _brakeOptions = VehicleAttributeOptions.BrakeTypes;

    protected override async Task OnInitializedAsync()
    {
        _years = await VehicleCatalog.GetYearsAsync();

        if (_years.Count == 0)
        {
            _years = Enumerable.Range(1996, DateTime.UtcNow.Year - 1996 + 1)
                .Reverse()
                .ToList();
        }

        await LoadVehicleOptionsAsync();
    }

    private async Task LoadVehicleOptionsAsync()
    {
        _submodelOptions = await LoadOptionsAsync(
            VehicleCatalogOptionCategories.Submodel,
            VehicleAttributeOptions.CommonSubmodels);
        _bodyStyleOptions = await LoadOptionsAsync(
            VehicleCatalogOptionCategories.BodyStyle,
            VehicleAttributeOptions.BodyStyles);
        _engineFuelOptions = await LoadOptionsAsync(
            VehicleCatalogOptionCategories.EngineFuel,
            VehicleAttributeOptions.CommonEngineFuelTypes);
        _transmissionOptions = await LoadOptionsAsync(
            VehicleCatalogOptionCategories.Transmission,
            VehicleAttributeOptions.CommonTransmissions);
        _driveTypeOptions = await LoadOptionsAsync(
            VehicleCatalogOptionCategories.DriveType,
            VehicleAttributeOptions.DriveTypes);
        _brakeOptions = await LoadOptionsAsync(
            VehicleCatalogOptionCategories.Brake,
            VehicleAttributeOptions.BrakeTypes);
    }

    private async Task OnVehicleYearChanged()
    {
        _vpicResult = null;
        _appointment.VehicleMake = null;
        _appointment.VehicleModel = null;

        _makes = [];
        _models = [];

        if (int.TryParse(_appointment.VehicleYear, out var year))
        {
            _makes = await VehicleCatalog.GetMakesAsync(year);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVehicleMakeChanged()
    {
        _vpicResult = null;
        _appointment.VehicleModel = null;
        _models = [];

        if (int.TryParse(_appointment.VehicleYear, out var year) &&
            !string.IsNullOrWhiteSpace(_appointment.VehicleMake))
        {
            _models = await VehicleCatalog.GetModelsAsync(year, _appointment.VehicleMake);
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task OnVehicleModelChanged()
    {
        return Task.CompletedTask;
    }

    private async Task ApplyVpicDecodeAsync(VpicVehicleDecodeResult result)
    {
        _vpicResult = result;
        _appointment.VehicleYear = result.GetOnly(result.ModelYearOptions) ?? _appointment.VehicleYear;
        _appointment.VehicleMake = result.GetOnly(result.MakeOptions) ?? _appointment.VehicleMake;
        _appointment.VehicleModel = result.GetOnly(result.ModelOptions) ?? _appointment.VehicleModel;
        _appointment.VehicleSubmodel = result.GetOnly(result.SubmodelOptions) ?? _appointment.VehicleSubmodel;
        _appointment.BodyStyle = result.GetOnly(result.BodyStyleOptions) ?? _appointment.BodyStyle;
        _appointment.EngineFuel = result.GetOnly(result.EngineFuelOptions) ?? _appointment.EngineFuel;
        _appointment.Transmission = result.GetOnly(result.TransmissionOptions) ?? _appointment.Transmission;
        _appointment.DriveType = result.GetOnly(result.DriveTypeOptions) ?? _appointment.DriveType;
        _appointment.Brake = result.GetOnly(result.BrakeOptions) ?? _appointment.Brake;
        _appointment.Gvw = result.GetOnly(result.GvwOptions) ?? _appointment.Gvw;

        if (int.TryParse(_appointment.VehicleYear, out var year))
        {
            _makes = GetOptions(
                await VehicleCatalog.GetMakesAsync(year),
                result.MakeOptions);
        }

        if (int.TryParse(_appointment.VehicleYear, out year) &&
            !string.IsNullOrWhiteSpace(_appointment.VehicleMake))
        {
            _models = GetOptions(
                await VehicleCatalog.GetModelsAsync(year, _appointment.VehicleMake),
                result.ModelOptions);
        }

        await InvokeAsync(StateHasChanged);
    }

    private IEnumerable<int> GetYearOptions()
    {
        var years = _years.ToList();

        foreach (var option in _vpicResult?.ModelYearOptions ?? [])
        {
            if (int.TryParse(option, out var year) && !years.Contains(year))
            {
                years.Add(year);
            }
        }

        return years.OrderByDescending(year => year);
    }

    private static IReadOnlyList<string> GetOptions(
        IEnumerable<string> existing,
        IEnumerable<string>? decoded)
    {
        return existing
            .Concat(decoded ?? [])
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task<IReadOnlyList<string>> LoadOptionsAsync(
        string category,
        IReadOnlyList<string> fallback)
    {
        var values = await VehicleCatalog.GetOptionsAsync(category);
        return values.Count > 0 ? values : fallback;
    }

    private async Task SubmitAppointment()
    {
        if (_isSubmitting)
        {
            return;
        }

        _submitError = null;

        if (string.IsNullOrWhiteSpace(_appointment.VehicleYear))
        {
            _submitError = "Please select a vehicle year.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_appointment.PreferredDate) ||
            string.IsNullOrWhiteSpace(_appointment.PreferredTime) ||
            string.IsNullOrWhiteSpace(_appointment.ServiceNeeded) ||
            string.IsNullOrWhiteSpace(_appointment.Message))
        {
            _submitError = "Please complete the required fields.";
            return;
        }

        _isSubmitting = true;

        try
        {
            var result = await AppointmentService.SubmitAsync(_appointment);

            if (!result.Success)
            {
                _submitError = result.ErrorMessage ?? "Unable to submit the appointment request.";
                return;
            }

            _requestId = result.RequestId.ToString("D");
            _submitted = true;
        }
        catch (Exception ex)
        {
            _submitError = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void ResetForm()
    {
        _appointment.Name = null;
        _appointment.Phone = null;
        _appointment.Email = null;
        _appointment.VehicleYear = null;
        _appointment.VehicleMake = null;
        _appointment.VehicleModel = null;
        _appointment.VehicleSubmodel = null;
        _appointment.BodyStyle = null;
        _appointment.EngineFuel = null;
        _appointment.Transmission = null;
        _appointment.DriveType = null;
        _appointment.Brake = null;
        _appointment.Gvw = null;
        _appointment.Vin = null;
        _appointment.Mileage = null;
        _appointment.LicensePlate = null;
        _appointment.StateProvince = null;
        _appointment.UnitNumber = null;
        _appointment.FleetNumber = null;
        _appointment.Color = null;
        _appointment.VehicleMemo = null;
        _appointment.PreferredDate = null;
        _appointment.PreferredTime = null;
        _appointment.ServiceNeeded = null;
        _appointment.Message = null;

        _makes = [];
        _models = [];
        _vpicResult = null;
        _submitError = null;
        _requestId = null;
        _submitted = false;
        _isSubmitting = false;
    }

    private string GetVehicleSummary()
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(_appointment.VehicleYear))
        {
            parts.Add(_appointment.VehicleYear!);
        }

        if (!string.IsNullOrWhiteSpace(_appointment.VehicleMake))
        {
            parts.Add(_appointment.VehicleMake!);
        }

        if (!string.IsNullOrWhiteSpace(_appointment.VehicleModel))
        {
            parts.Add(_appointment.VehicleModel!);
        }

        return parts.Count == 0 ? "Not provided" : string.Join(" ", parts);
    }
}
