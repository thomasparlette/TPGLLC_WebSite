@page "/portal/service-advisor/customers"
@layout CustomerLayout
@attribute [Authorize(Policy = PortalPolicies.ServiceAdvisor)]

@using Microsoft.EntityFrameworkCore
@using TPGLLC.Data

@inject IDbContextFactory<TPGLLCDbContext> DbFactory

<PageTitle>Customers</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Service Advisor Portal</p>
        <h1>Customers</h1>
        <p>Search customers and view their records before opening a work order.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading customers</div>
                <div class="portal-loading-text">Please wait while we load customer records.</div>
            </div>
        </div>
    }
    else
    {
        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_customerCount</div>
                <div class="portal-stat-label">Customers</div>
            </div>
            <div class="portal-stat">
                <div class="portal-stat-value">@_vehicleCount</div>
                <div class="portal-stat-label">Vehicles</div>
            </div>
            <div class="portal-stat">
                <div class="portal-stat-value">@_requestCount</div>
                <div class="portal-stat-label">Requests</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-empty-state">
                <div class="portal-empty-icon">👥</div>
                <div>
                    <div class="portal-empty-title">Customer directory coming next</div>
                    <div class="portal-empty-text">This page is in place for customer search, records, and history lookup.</div>
                </div>
            </div>
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private int _customerCount;
    private int _vehicleCount;
    private int _requestCount;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _customerCount = await db.Customers.AsNoTracking().CountAsync();
        _vehicleCount = await db.CustomerVehicles.AsNoTracking().CountAsync();
        _requestCount = await db.AppointmentRequests.AsNoTracking().CountAsync();
        _loading = false;
    }
}
