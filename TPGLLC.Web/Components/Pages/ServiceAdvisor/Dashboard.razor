
@page "/portal/service-advisor"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ServiceAdvisor,Administrator")]

@using Microsoft.EntityFrameworkCore
@using TPGLLC.Data
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Authorization
@using TPGLLC.Web.Services.Customers

@inject IDbContextFactory<TPGLLCDbContext> DbFactory
@inject ICurrentCustomerAccessor CurrentCustomerAccessor

<PageTitle>Service Advisor Dashboard</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Service Advisor Portal</p>
        <h1>Service Advisor Dashboard</h1>
        <p>Track customer requests, schedule appointments, and move work orders through the shop.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading dashboard</div>
                <div class="portal-loading-text">Please wait while we gather customer activity.</div>
            </div>
        </div>
    }
    else
    {
        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_openRequests</div>
                <div class="portal-stat-label">Open Requests</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_openWorkOrders</div>
                <div class="portal-stat-label">Active Work Orders</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_customers</div>
                <div class="portal-stat-label">Customers</div>
            </div>
        </div>

        <div class="portal-dashboard-grid">
            <a class="portal-card-link" href="/portal/service-advisor/current-requests">
                <div class="portal-card-icon">📥</div>
                <h3>Current Customer Requests</h3>
                <p>Review new appointment requests and customer check-ins.</p>
            </a>

            <a class="portal-card-link" href="/portal/service-advisor/appointment-calendar">
                <div class="portal-card-icon">📅</div>
                <h3>Appointment Calendar</h3>
                <p>View the shop schedule and upcoming appointments.</p>
            </a>

            <a class="portal-card-link" href="/portal/service-advisor/work-orders">
                <div class="portal-card-icon">🛠️</div>
                <h3>Work Orders</h3>
                <p>Assign technicians, update approvals, and manage invoices.</p>
            </a>

            <a class="portal-card-link" href="/portal/service-advisor/catalog">
                <div class="portal-card-icon">🧾</div>
                <h3>Parts &amp; Labor Catalog</h3>
                <p>Maintain reusable parts, labor operations, and estimate pricing.</p>
            </a>

            <a class="portal-card-link" href="/portal/service-advisor/customers">
                <div class="portal-card-icon">👥</div>
                <h3>Customers</h3>
                <p>Open a customer record and review history at a glance.</p>
            </a>

            <a class="portal-card-link" href="/portal/account">
                <div class="portal-card-icon">👤</div>
                <h3>Account Detail</h3>
                <p>Update your account details and password.</p>
            </a>
        </div>

        <div class="portal-section" style="margin-top: 1.5rem;">
            <div class="portal-section-heading">
                <h2>Recent Customer Requests</h2>
                <a class="portal-action-button" href="/portal/service-advisor/current-requests">View all</a>
            </div>

            @if (_recentRequests.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">📭</div>
                    <div>
                        <div class="portal-empty-title">No customer requests</div>
                        <div class="portal-empty-text">New requests will appear here after customers submit appointments.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-dashboard-grid">
                    @foreach (var request in _recentRequests)
                    {
                        <article class="portal-card-link" @key="request.RequestId">
                            <div class="portal-card-icon">📅</div>
                            <h3>@request.ServiceNeeded</h3>
                            <p>@request.Name</p>
                            <div class="portal-primary-meta" style="margin-top:0.75rem;">
                                <span>@request.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy")</span>
                                <span>@request.Status</span>
                            </div>
                            <div class="portal-muted" style="margin-top:0.5rem;">
                                @BuildVehicleSummary(request)
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private int _openRequests;
    private int _openWorkOrders;
    private int _customers;
    private List<AppointmentRequest> _recentRequests = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var requests = await db.AppointmentRequests.AsNoTracking().ToListAsync();
            var workOrders = await db.ServiceHistoryEntries.AsNoTracking().ToListAsync();

            _openRequests = requests.Count(x => !IsClosedStatus(x.Status));
            _openWorkOrders = workOrders.Count(x => !IsClosedStatus(x.Status));
            _customers = await db.Customers.AsNoTracking().CountAsync();
            _recentRequests = requests
                .OrderByDescending(x => x.SubmittedAtUtc)
                .Take(5)
                .ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private static string BuildVehicleSummary(AppointmentRequest request)
    {
        var parts = new[] { request.VehicleYear, request.VehicleMake, request.VehicleModel }
            .Where(x => !string.IsNullOrWhiteSpace(x));

        var summary = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(summary) ? "Vehicle not specified" : summary;
    }

    private static bool IsClosedStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        return status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Declined", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Closed", StringComparison.OrdinalIgnoreCase);
    }
}
