@page "/portal/service-advisor/work-orders"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "ServiceAdvisor,Technician,Finance,Administrator")]

@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Components.Shared
@using TPGLLC.Web.Services.WorkOrders
@using TPGLLC.Web.ViewModels.Portal

@inject IWorkOrderPortalService WorkOrderService

<PageTitle>Work Orders</PageTitle>
<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Staff Work Orders</p>
        <h1>Work Orders</h1>
        <p>Review active repair orders, update their details, and keep each order indexed by a unique work order number.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading work orders</div>
                <div class="portal-loading-text">Please wait while we load customer repair records.</div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(_model.ErrorMessage))
        {
            <PortalNotice Type="danger" Title="Work orders unavailable">
                @_model.ErrorMessage
            </PortalNotice>
        }

        @if (!string.IsNullOrWhiteSpace(_model.SuccessMessage))
        {
            <PortalNotice Type="success" Title="Saved">
                @_model.SuccessMessage
            </PortalNotice>
        }

        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_model.WorkOrders.Count</div>
                <div class="portal-stat-label">Total Orders</div>
            </div>
            <div class="portal-stat">
                <div class="portal-stat-value">@_model.WorkOrders.Count(x => !IsClosedStatus(x.Status))</div>
                <div class="portal-stat-label">Active</div>
            </div>
            <div class="portal-stat">
                <div class="portal-stat-value">@_model.WorkOrders.Count(x => x.InvoiceAmount.HasValue)</div>
                <div class="portal-stat-label">Billed</div>
            </div>
        </div>

        <div class="portal-section">
            <div class="portal-section-heading">
                <div>
                    <h2>Work Orders</h2>
                    <div class="portal-muted">Every order is assigned a work order number. Use Edit to update the record.</div>
                </div>
                <div class="workorder-status-filter">
                    <label class="portal-field-label" for="workorder-status-filter">Show status</label>
                    <select id="workorder-status-filter" class="portal-input" @bind="_statusFilter">
                        <option value="">All statuses</option>
                        @foreach (var status in _model.StatusOptions)
                        {
                            <option value="@status">@GetStatusLabel(status)</option>
                        }
                    </select>
                </div>
                @if (_model.EditingWorkOrderId is not null)
                {
                    <button type="button" class="portal-action-button" @onclick="ResetEditorAsync">Close Editor</button>
                }
            </div>

            @if (_model.WorkOrders.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">📝</div>
                    <div>
                        <div class="portal-empty-title">No work orders on file</div>
                        <div class="portal-empty-text">As soon as a repair order is created, it will appear here with its assigned work order number.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="workorder-board">
                    @foreach (var column in WorkOrderStatusCatalog.BoardColumns)
                    {
                        var columnOrders = GetBoardWorkOrders(column.Key);

                        <section class="workorder-board-column @column.CssClass" @key="column.Key">
                            <div class="workorder-board-column-header">
                                <div>
                                    <h3>@column.Label</h3>
                                    <span>@column.Description</span>
                                </div>
                                <strong>@columnOrders.Count</strong>
                            </div>

                            <div class="workorder-board-items">
                                @if (columnOrders.Count == 0)
                                {
                                    <div class="workorder-board-empty">No orders in this stage.</div>
                                }
                                @foreach (var workOrder in columnOrders)
                                {
                                    var status = WorkOrderStatusCatalog.GetDefinition(workOrder.Status);

                                    <article class="workorder-card workorder-board-card @status.CssClass" @key="workOrder.Id">
                                            <div class="workorder-card-header">
                                                <div>
                                                    <div class="workorder-number">@(string.IsNullOrWhiteSpace(workOrder.WorkOrderNumber) ? "Work Order Number Pending" : workOrder.WorkOrderNumber)</div>
                                                    <h3 class="workorder-title">@workOrder.VehicleName</h3>
                                                    <p class="workorder-subtitle">@workOrder.Service</p>
                                                </div>
                                                <div class="workorder-actions" style="margin-top:0;">
                                                    <button type="button"
                                                            class="portal-action-button"
                                                            @onclick="@(async () => await BeginEditAsync(workOrder.Id))">
                                                        Edit
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="workorder-meta">
                                                <span class="workorder-badge">Service @workOrder.ServiceDate.ToString("MMM d, yyyy")</span>
                                                <span class="workorder-badge workorder-status-badge @status.CssClass">@status.Label</span>
                                                @if (!string.IsNullOrWhiteSpace(workOrder.ApprovalStatus))
                                                {
                                                    <span class="workorder-badge">Appointment: @workOrder.ApprovalStatus</span>
                                                }
                                                @if (workOrder.EstimateAmount.HasValue)
                                                {
                                                    <span class="workorder-badge">Estimate @workOrder.EstimateAmount.Value.ToString("C")</span>
                                                }
                                                @if (workOrder.InvoiceAmount.HasValue)
                                                {
                                                    <span class="workorder-badge">Invoice @workOrder.InvoiceAmount.Value.ToString("C")</span>
                                                }
                                                @if (workOrder.Mileage.HasValue)
                                                {
                                                    <span class="workorder-badge">Mileage @workOrder.Mileage.Value.ToString("N0")</span>
                                                }
                                                @if (workOrder.Parts.Any(x => x.IsCustomerDeclined))
                                                {
                                                    <span class="workorder-badge workorder-badge-declined">
                                                        Customer declined @workOrder.Parts.Count(x => x.IsCustomerDeclined) part(s)
                                                    </span>
                                                }
                                            </div>

                                            @if (GetLatestVisibleUpdate(workOrder) is not null)
                                            {
                                                <div class="workorder-latest-update">
                                                    <strong>Latest update</strong>
                                                    <span>@GetLatestVisibleUpdate(workOrder)!.Message</span>
                                                    <small>@GetLatestVisibleUpdate(workOrder)!.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</small>
                                                </div>
                                            }
                                    </article>
                                }
                            </div>
                        </section>
                    }
                </div>
            }
        </div>

        @if (_model.EditingWorkOrderId is not null)
        {
            <div class="portal-section workorder-editor" id="workorder-editor" tabindex="-1" @ref="_editorElement">
                <div class="portal-section-heading">
                    <div>
                        <h2>Edit Work Order</h2>
                        <div class="portal-muted">The work order number is editable, but it must remain unique.</div>
                    </div>
                </div>

                <EditForm Model="@_model.Form" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="workorder-form-grid">
                        <div class="workorder-field">
                            <label class="portal-field-label">Work order number</label>
                            <InputText class="portal-input" @bind-Value="_model.Form.WorkOrderNumber" />
                            <div class="workorder-required-note">Assigned automatically when a work order has no number.</div>
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Invoice number</label>
                            <input class="portal-input" value="@_model.Form.WorkOrderNumber" readonly />
                            <div class="workorder-required-note">Invoice number follows the work order number.</div>
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Service date</label>
                            <InputDate class="portal-input" @bind-Value="_model.Form.ServiceDate" />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Status</label>
                            <InputSelect class="portal-input" @bind-Value="_model.Form.Status">
                                @foreach (var status in _model.StatusOptions)
                                {
                                    <option value="@status">@status</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Vehicle</label>
                            <InputText class="portal-input" @bind-Value="_model.Form.VehicleName" />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Primary concern</label>
                            <InputText class="portal-input" @bind-Value="_model.Form.Service" readonly />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Mileage in</label>
                            <InputText class="portal-input" @bind-Value="_model.Form.Mileage" />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Mileage out</label>
                            <InputText class="portal-input" @bind-Value="_model.Form.MileageOut" />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Technician</label>
                            <InputSelect class="portal-input" @bind-Value="_model.Form.Technician">
                                <option value="">Unassigned</option>
                                @foreach (var technician in _model.TechnicianOptions)
                                {
                                    <option value="@technician.AssignmentValue">@technician.Label</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Appointment status</label>
                            <InputText class="portal-input" @bind-Value="_model.Form.ApprovalStatus" readonly />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Estimate amount</label>
                            <input class="portal-input" value="@EstimatedAmountText" readonly />
                            <div class="workorder-required-note">Applied parts plus labor.</div>
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Labor amount</label>
                            <InputText class="portal-input" @bind-Value="_model.Form.LaborAmount" />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Invoice amount</label>
                            <input class="portal-input" value="@InvoiceAmountText" readonly />
                            <div class="workorder-required-note">Approved parts plus labor.</div>
                        </div>
                    </div>

                    <div class="workorder-notes-grid">
                        <div class="workorder-field">
                            <label class="portal-field-label">Customer complaint</label>
                            <InputTextArea class="portal-input" @bind-Value="_model.Form.Complaint" readonly />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Diagnosis</label>
                            <InputTextArea class="portal-input" @bind-Value="_model.Form.Diagnosis" readonly />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Customer notes</label>
                            <InputTextArea class="portal-input" @bind-Value="_model.Form.Notes" />
                        </div>

                        <div class="workorder-field">
                            <label class="portal-field-label">Internal notes</label>
                            <InputTextArea class="portal-input" @bind-Value="_model.Form.InternalNotes" />
                        </div>
                    </div>

                    <div class="workorder-structured-section">
                        <div class="portal-section-heading">
                            <div>
                                <h3>Repair jobs and estimate</h3>
                                <div class="portal-muted">Break the estimate into customer-approvable jobs with separate labor amounts.</div>
                            </div>
                            <button type="button" class="portal-action-button" @onclick="AddJob">Add repair job</button>
                        </div>

                        @if (_model.Form.Jobs.Count == 0)
                        {
                            <div class="workorder-structured-empty">No repair jobs have been added yet.</div>
                        }
                        else
                        {
                            @foreach (var job in _model.Form.Jobs)
                            {
                                <div class="workorder-job-row">
                                    <div class="workorder-field">
                                        <label class="portal-field-label">Job name</label>
                                        <InputText class="portal-input" placeholder="Brake service, diagnosis, etc." @bind-Value="job.Name" />
                                    </div>
                                    <div class="workorder-field">
                                        <label class="portal-field-label">Labor operation</label>
                                        <select class="portal-input" value="@job.LaborCatalogItemId" @onchange="args => SelectLaborCatalog(job, args)">
                                            <option value="">Custom labor</option>
                                            @foreach (var labor in _model.LaborCatalogOptions)
                                            {
                                                <option value="@labor.Id">@labor.Label</option>
                                            }
                                        </select>
                                        @if (!string.IsNullOrWhiteSpace(job.LaborHours) && !string.IsNullOrWhiteSpace(job.LaborRate))
                                        {
                                            <div class="workorder-required-note">@job.LaborHours hours × @job.LaborRate/hr</div>
                                        }
                                    </div>
                                    <div class="workorder-field">
                                        <label class="portal-field-label">Status</label>
                                        <InputSelect class="portal-input" @bind-Value="job.Status">
                                            @foreach (var status in JobStatuses)
                                            {
                                                <option value="@status">@status</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="workorder-field">
                                        <label class="portal-field-label">Labor</label>
                                        <InputText class="portal-input" placeholder="0.00" @bind-Value="job.LaborAmount" />
                                    </div>
                                    <label class="workorder-checkbox-field"><InputCheckbox @bind-Value="job.IsDeferred" /> Deferred</label>
                                    <label class="workorder-checkbox-field"><InputCheckbox @bind-Value="job.IsApproved" disabled="@(!IsQuoted)" /> Approved</label>
                                    <button type="button" class="portal-action-button" @onclick="() => RemoveJob(job)">Remove</button>
                                    <div class="workorder-field workorder-field-full">
                                        <label class="portal-field-label">Job description</label>
                                        <InputTextArea class="portal-input" placeholder="Describe the recommended repair and scope of work." @bind-Value="job.Description" />
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="workorder-structured-section">
                        <div class="portal-section-heading">
                            <div>
                                <h3>Digital inspection</h3>
                                <div class="portal-muted">Record inspection findings and recommendations customers can review in the portal.</div>
                            </div>
                            <button type="button" class="portal-action-button" @onclick="AddInspection">Add inspection finding</button>
                        </div>

                        @if (_model.Form.Inspections.Count == 0)
                        {
                            <div class="workorder-structured-empty">No inspection findings have been added yet.</div>
                        }
                        else
                        {
                            @foreach (var inspection in _model.Form.Inspections)
                            {
                                <div class="workorder-inspection-row">
                                    <div class="workorder-field">
                                        <label class="portal-field-label">Inspection area</label>
                                        <InputText class="portal-input" placeholder="Brakes, tires, fluids..." @bind-Value="inspection.Area" />
                                    </div>
                                    <div class="workorder-field">
                                        <label class="portal-field-label">Condition</label>
                                        <InputSelect class="portal-input" @bind-Value="inspection.Condition">
                                            @foreach (var condition in InspectionConditions)
                                            {
                                                <option value="@condition">@condition</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="workorder-field">
                                        <label class="portal-field-label">Finding</label>
                                        <InputTextArea class="portal-input" placeholder="What was found?" @bind-Value="inspection.Finding" />
                                    </div>
                                    <div class="workorder-field">
                                        <label class="portal-field-label">Recommendation</label>
                                        <InputTextArea class="portal-input" placeholder="Recommended next step" @bind-Value="inspection.Recommendation" />
                                    </div>
                                    <label class="workorder-checkbox-field"><InputCheckbox @bind-Value="inspection.IsCustomerVisible" /> Customer visible</label>
                                    <button type="button" class="portal-action-button" @onclick="() => RemoveInspection(inspection)">Remove</button>
                                </div>
                            }
                        }
                    </div>

                    <div class="workorder-parts-section">
                        <div class="portal-section-heading">
                            <div>
                                <h3>Parts applied</h3>
                                <div class="portal-muted">Review the full parts layout. Individual parts can be approved while the order is Quoted.</div>
                            </div>
                            <button type="button" class="portal-action-button" @onclick="AddPart">Add part</button>
                        </div>
                        <div class="workorder-part-header" aria-hidden="true">
                            <span>Part description</span>
                            <span>Quantity</span>
                            <span>Unit price</span>
                            <span>Applied to estimate</span>
                            <span>Approved for invoice</span>
                            <span></span>
                        </div>
                        @foreach (var part in _model.Form.Parts)
                        {
                            <div class="workorder-part-row">
                                <div class="workorder-part-description">
                                    <label class="workorder-part-job-label">Catalog part
                                        <select class="portal-input" value="@part.PartsCatalogItemId" @onchange="args => SelectPartsCatalog(part, args)">
                                            <option value="">Custom part</option>
                                            @foreach (var catalogPart in _model.PartsCatalogOptions)
                                            {
                                                <option value="@catalogPart.Id">@catalogPart.Label</option>
                                            }
                                        </select>
                                    </label>
                                    <InputText class="portal-input" placeholder="Part description" @bind-Value="part.Description" />
                                    <label class="workorder-part-job-label">Repair job
                                        <InputSelect TValue="Guid?" class="portal-input" @bind-Value="part.ServiceHistoryJobId">
                                            <option value="">Unassigned</option>
                                            @foreach (var job in _model.Form.Jobs.Where(x => !string.IsNullOrWhiteSpace(x.Name)))
                                            {
                                                <option value="@job.Id">@job.Name</option>
                                            }
                                        </InputSelect>
                                    </label>
                                    @if (part.IsCustomerDeclined)
                                    {
                                        <span class="workorder-part-status workorder-part-status-declined">Not approved by customer</span>
                                    }
                                </div>
                                <InputText class="portal-input" placeholder="Qty" @bind-Value="part.Quantity" />
                                <InputText class="portal-input" placeholder="Unit price" @bind-Value="part.UnitPrice" />
                                <label><InputCheckbox @bind-Value="part.IsApplied" /> Applied</label>
                                <label><InputCheckbox @bind-Value="part.IsApproved" disabled="@(!IsQuoted)" /> Approved</label>
                                <button type="button" class="portal-action-button" @onclick="() => RemovePart(part)">Remove</button>
                            </div>
                        }
                    </div>

                    <div class="workorder-editor-actions">
                        <button type="button" class="portal-action-button" @onclick="ResetEditorAsync">Cancel</button>
                        <button type="submit" class="portal-action-button">Save Work Order</button>
                    </div>
                </EditForm>
            </div>
        }
    }
</section>

@code {
    private WorkOrderPageViewModel _model = new();
    private bool _loading = true;
    private string _statusFilter = string.Empty;
    private bool _focusEditorAfterRender;
    private ElementReference _editorElement;

    [SupplyParameterFromQuery(Name = "appointmentRequestId")]
    public Guid? AppointmentRequestId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _model = await WorkOrderService.GetStaffWorkOrdersAsync();

            if (AppointmentRequestId is Guid appointmentRequestId)
            {
                var linkedWorkOrder = _model.WorkOrders
                    .FirstOrDefault(x => x.AppointmentRequestId == appointmentRequestId);

                if (linkedWorkOrder is null)
                {
                    _model.ErrorMessage = "No work order is linked to that appointment.";
                }
                else
                {
                    await BeginEditAsync(linkedWorkOrder.Id);
                }
            }
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task BeginEditAsync(Guid workOrderId)
    {
        _model = await WorkOrderService.StartEditAsync(workOrderId);
        _focusEditorAfterRender = _model.EditingWorkOrderId is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusEditorAfterRender || _model.EditingWorkOrderId is null)
        {
            return;
        }

        _focusEditorAfterRender = false;
        await _editorElement.FocusAsync();
    }

    private async Task SaveAsync()
    {
        _model = await WorkOrderService.SaveAsync(_model);
    }

    private async Task ResetEditorAsync()
    {
        _focusEditorAfterRender = false;
        _model = await WorkOrderService.ResetAsync();
    }

    private bool IsQuoted => string.Equals(_model.Form.Status, "Quoted", StringComparison.OrdinalIgnoreCase);

    private static readonly IReadOnlyList<string> JobStatuses =
        ["Proposed", "Approved", "In Progress", "Completed", "Deferred", "Declined"];

    private static readonly IReadOnlyList<string> InspectionConditions =
        ["Good", "Monitor", "Needs Attention", "Urgent"];

    private void AddJob() => _model.Form.Jobs.Add(new WorkOrderJobEditViewModel());

    private void RemoveJob(WorkOrderJobEditViewModel job) => _model.Form.Jobs.Remove(job);

    private void AddInspection() => _model.Form.Inspections.Add(new WorkOrderInspectionEditViewModel());

    private void RemoveInspection(WorkOrderInspectionEditViewModel inspection) => _model.Form.Inspections.Remove(inspection);

    private void SelectLaborCatalog(WorkOrderJobEditViewModel job, ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var catalogId))
        {
            job.LaborCatalogItemId = null;
            return;
        }

        var catalogItem = _model.LaborCatalogOptions.FirstOrDefault(x => x.Id == catalogId);
        if (catalogItem is null)
        {
            return;
        }

        job.LaborCatalogItemId = catalogItem.Id;
        job.Name = catalogItem.Name;
        job.LaborHours = catalogItem.DefaultHours.ToString("0.00", CultureInfo.InvariantCulture);
        job.LaborRate = catalogItem.HourlyRate.ToString("0.00", CultureInfo.InvariantCulture);
        job.LaborAmount = (catalogItem.DefaultHours * catalogItem.HourlyRate)
            .ToString("0.00", CultureInfo.InvariantCulture);
    }

    private void SelectPartsCatalog(WorkOrderPartEditViewModel part, ChangeEventArgs args)
    {
        if (!Guid.TryParse(args.Value?.ToString(), out var catalogId))
        {
            part.PartsCatalogItemId = null;
            return;
        }

        var catalogItem = _model.PartsCatalogOptions.FirstOrDefault(x => x.Id == catalogId);
        if (catalogItem is null)
        {
            return;
        }

        part.PartsCatalogItemId = catalogItem.Id;
        part.Description = catalogItem.Name;
        part.UnitPrice = catalogItem.UnitPrice.ToString("0.00", CultureInfo.InvariantCulture);
    }

    private void AddPart() => _model.Form.Parts.Add(new WorkOrderPartEditViewModel());

    private void RemovePart(WorkOrderPartEditViewModel part) => _model.Form.Parts.Remove(part);

    private string EstimatedAmountText => FormatCurrency(
        PartsTotal(onlyApplied: true)
        + JobLaborTotal(onlyApproved: false)
        + ParseAmount(_model.Form.LaborAmount));

    private string InvoiceAmountText => FormatCurrency(
        PartsTotal(onlyApplied: false)
        + JobLaborTotal(onlyApproved: true)
        + ParseAmount(_model.Form.LaborAmount));

    private decimal JobLaborTotal(bool onlyApproved)
    {
        return _model.Form.Jobs
            .Where(x => !x.IsDeferred && !x.IsCustomerDeclined && (!onlyApproved || x.IsApproved))
            .Sum(x => ParseAmount(x.LaborAmount));
    }

    private decimal PartsTotal(bool onlyApplied)
    {
        return _model.Form.Parts
            .Where(x => onlyApplied ? x.IsApplied : x.IsApproved)
            .Sum(x => ParseAmount(x.Quantity) * ParseAmount(x.UnitPrice));
    }

    private static decimal ParseAmount(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return 0m;
        var normalized = value.Replace("$", string.Empty, StringComparison.Ordinal)
            .Replace(",", string.Empty, StringComparison.Ordinal).Trim();
        return decimal.TryParse(normalized, NumberStyles.Number, CultureInfo.InvariantCulture, out var amount) && amount >= 0
            ? amount
            : 0m;
    }

    private static string FormatCurrency(decimal amount) => amount.ToString("C2", CultureInfo.CurrentCulture);

    private bool ShouldShowWorkOrder(ServiceHistoryEntry workOrder) =>
        string.IsNullOrWhiteSpace(_statusFilter)
        || string.Equals(workOrder.Status, _statusFilter, StringComparison.OrdinalIgnoreCase);

    private IReadOnlyList<ServiceHistoryEntry> GetBoardWorkOrders(string columnKey) =>
        _model.WorkOrders
            .Where(ShouldShowWorkOrder)
            .Where(x => string.Equals(WorkOrderStatusCatalog.GetBoardColumnKey(x.Status), columnKey, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(GetLastUpdated)
            .ThenByDescending(x => x.ServiceDate)
            .ToList();

    private static ServiceHistoryUpdate? GetLatestVisibleUpdate(ServiceHistoryEntry workOrder) =>
        workOrder.Updates
            .Where(x => x.IsCustomerVisible)
            .OrderByDescending(x => x.CreatedUtc)
            .FirstOrDefault();

    private static DateTimeOffset GetLastUpdated(ServiceHistoryEntry workOrder) =>
        workOrder.UpdatedUtc ?? workOrder.CreatedUtc;

    private static string GetStatusLabel(string status) =>
        WorkOrderStatusCatalog.GetDefinition(status).Label;

    private static bool IsClosedStatus(string? status)
        => WorkOrderStatusCatalog.IsClosed(status);
}
