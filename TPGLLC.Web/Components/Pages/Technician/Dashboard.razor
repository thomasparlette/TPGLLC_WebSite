@page "/portal/technician"
@layout CustomerLayout
@attribute [Authorize(Policy = PortalPolicies.Technician)]

<PageTitle>Technician Dashboard</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Technician Portal</p>
        <h1>Technician Dashboard</h1>
        <p>Monitor your assigned work and keep your account updated.</p>
    </div>

    <div class="portal-section">
        <div class="portal-empty-state">
            <div class="portal-empty-icon">🛠️</div>
            <div>
                <div class="portal-empty-title">Assigned work coming next</div>
                <div class="portal-empty-text">Add technician assignment filters and work order details here.</div>
            </div>
        </div>
    </div>
</section>
