@page "/portal/employee/technician"
@page "/portal/employee/technician/dashboard"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Technician")]

@using Microsoft.EntityFrameworkCore
@using TPGLLC.Data
@using TPGLLC.Data.Entities
@using TPGLLC.Web.Authorization
@using TPGLLC.Web.Services.Customers

@inject IDbContextFactory<TPGLLCDbContext> DbFactory
@inject ICurrentCustomerAccessor CurrentCustomerAccessor

<PageTitle>Technician Dashboard</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Employee Portal</p>
        <h1>Technician Dashboard</h1>
        <p>Review assigned work orders and keep your current tasks moving.</p>
    </div>

    @if (_loading)
    {
        <div class="portal-loading-card">
            <div class="portal-loading-icon">⏳</div>
            <div>
                <div class="portal-loading-title">Loading dashboard</div>
                <div class="portal-loading-text">Please wait while we gather your assigned work.</div>
            </div>
        </div>
    }
    else
    {
        <div class="portal-stats">
            <div class="portal-stat">
                <div class="portal-stat-value">@_assignedOpen</div>
                <div class="portal-stat-label">Open Assignments</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_assignedCompleted</div>
                <div class="portal-stat-label">Completed</div>
            </div>

            <div class="portal-stat">
                <div class="portal-stat-value">@_assignedWorkOrders.Count</div>
                <div class="portal-stat-label">Total Assigned</div>
            </div>
        </div>

        <div class="portal-dashboard-grid">
            <a class="portal-card-link" href="/portal/employee/technician/work-orders">
                <div class="portal-card-icon">🛠️</div>
                <h3>Current Work Orders Assigned</h3>
                <p>See the work orders currently assigned to you.</p>
            </a>

            <a class="portal-card-link" href="/portal/account">
                <div class="portal-card-icon">👤</div>
                <h3>Account Detail</h3>
                <p>Update your technician account details.</p>
            </a>
        </div>

        <div class="portal-section" style="margin-top: 1.5rem;">
            <div class="portal-section-heading">
                <h2>Assigned Work Orders</h2>
                <a class="portal-action-button" href="/portal/employee/technician/work-orders">View all</a>
            </div>

            @if (_assignedWorkOrders.Count == 0)
            {
                <div class="portal-empty-state">
                    <div class="portal-empty-icon">🔧</div>
                    <div>
                        <div class="portal-empty-title">No assigned work orders</div>
                        <div class="portal-empty-text">Once a service advisor assigns work to you, it will appear here.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="portal-dashboard-grid">
                    @foreach (var workOrder in _assignedWorkOrders.Take(5))
                    {
                        <article class="portal-card-link" @key="workOrder.Id">
                            <div class="portal-card-icon">🛠️</div>
                            <h3>@workOrder.VehicleName</h3>
                            <p>@workOrder.Service</p>
                            <div class="portal-primary-meta" style="margin-top:0.75rem;">
                                <span>@workOrder.ServiceDate.ToString("MMM d, yyyy")</span>
                                <span>@workOrder.Status</span>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    private bool _loading = true;
    private string _technicianName = string.Empty;
    private int _assignedOpen;
    private int _assignedCompleted;
    private List<ServiceHistoryEntry> _assignedWorkOrders = [];

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var current = CurrentCustomerAccessor.GetCurrentCustomer();
            _technicianName = current.DisplayName.Trim();

            await using var db = await DbFactory.CreateDbContextAsync();
            var workOrders = await db.ServiceHistoryEntries.AsNoTracking().ToListAsync();

            _assignedWorkOrders = workOrders
                .Where(x => !string.IsNullOrWhiteSpace(x.Technician) &&
                            string.Equals(x.Technician, _technicianName, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(x => x.ServiceDate)
                .ThenByDescending(x => x.CreatedUtc)
                .ToList();

            _assignedOpen = _assignedWorkOrders.Count(x => !IsClosedStatus(x.Status));
            _assignedCompleted = _assignedWorkOrders.Count(x => IsClosedStatus(x.Status));
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool IsClosedStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        return status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Declined", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Closed", StringComparison.OrdinalIgnoreCase);
    }
}
