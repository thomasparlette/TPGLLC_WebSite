@page "/portal/employee/technician/work-orders"
@layout CustomerLayout
@attribute [Authorize(Policy = PortalPolicies.Technician)]

<PageTitle>Technician Work Orders</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Technician Portal</p>
        <h1>Current Work Orders Assigned</h1>
        <p>Track work assigned to the logged-in technician.</p>
    </div>

    <div class="portal-section">
        <div class="portal-empty-state">
            <div class="portal-empty-icon">🛠️</div>
            <div>
                <div class="portal-empty-title">Work order assignment coming next</div>
                <div class="portal-empty-text">This page is ready for filtering assigned jobs by technician.</div>
            </div>
        </div>
    </div>
</section>
