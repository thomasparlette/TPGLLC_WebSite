@page "/portal/employee/service-advisor/calendar"
@layout CustomerLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Employee,ServiceAdvisor,Administrator")]

<PageTitle>Appointment Calendar</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Employee Portal</p>
        <h1>Appointment Calendar</h1>
        <p>View the shop schedule and upcoming appointments.</p>
    </div>

    <PortalPlaceholderPage Title="Appointment Calendar"
                           Description="View the shop schedule and upcoming appointments."
                           BackHref="/portal/employee/service-advisor"
                           BackText="Back to dashboard" />
</section>
