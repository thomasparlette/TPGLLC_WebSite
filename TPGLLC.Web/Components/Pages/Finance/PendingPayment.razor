@page "/portal/finance/pending-payment"
@layout CustomerLayout
@attribute [Authorize(Policy = PortalPolicies.Finance)]

@inject NavigationManager Navigation

<PageTitle>Work Orders Needing Payment</PageTitle>

<section class="portal-dashboard">
    <div class="portal-header">
        <p class="section-kicker">Finance Portal</p>
        <h1>Work Orders Needing Payment</h1>
        <p>Review invoices that still need payment attention.</p>
    </div>

    <div class="portal-loading-card">
        <div class="portal-loading-icon">↪</div>
        <div>
            <div class="portal-loading-title">Opening payment workflow</div>
            <div class="portal-loading-text">Redirecting to the active payment page.</div>
        </div>
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Navigation.NavigateTo("/portal/finance/work-orders-needing-payment", replace: true);
    }
}
