@using TPGLLC.Data.Entities

<article class="portal-card vehicle-card">
    @if (!string.IsNullOrWhiteSpace(Vehicle.PhotoPath))
    {
        <img class="vehicle-photo"
             src="@Vehicle.PhotoPath"
             alt="@GetVehicleTitle()" />
    }
    else
    {
        <div class="vehicle-photo-placeholder">
            🚗
        </div>
    }

    <div class="vehicle-card-body">
        <div class="vehicle-card-header">
            <div>
                <h3>@GetVehicleTitle()</h3>

                @if (Vehicle.IsPrimary)
                {
                    <span class="portal-chip">Primary Vehicle</span>
                }
            </div>

            <a class="portal-action-link" href="@($"/portal/vehicles/{Vehicle.Id}")">
                Details
            </a>
        </div>

        <div class="vehicle-details">
            @if (Vehicle.Mileage.HasValue)
            {
                <div>
                    <strong>Mileage</strong>
                    <span>@Vehicle.Mileage.Value.ToString("N0") mi</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Vehicle.LicensePlate))
            {
                <div>
                    <strong>Plate</strong>
                    <span>@Vehicle.LicensePlate</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Vehicle.Nickname))
            {
                <div>
                    <strong>Nickname</strong>
                    <span>@Vehicle.Nickname</span>
                </div>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Vehicle.Vin))
        {
            <div class="vehicle-vin">
                VIN: @Vehicle.Vin
            </div>
        }

        <div class="portal-actions">
            <button type="button"
                    class="portal-action-button"
                    @onclick="HandleEditAsync">
                Edit
            </button>

            @if (!Vehicle.IsPrimary)
            {
                <button type="button"
                        class="portal-action-button"
                        @onclick="HandleMakePrimaryAsync">
                    Make Primary
                </button>
            }

            <button type="button"
                    class="portal-danger-button"
                    @onclick="HandleDeleteAsync">
                Delete
            </button>
        </div>
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public CustomerVehicle Vehicle { get; set; } = default!;

    [Parameter]
    public EventCallback<Guid> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }

    [Parameter]
    public EventCallback<Guid> OnMakePrimary { get; set; }

    private string GetVehicleTitle()
    {
        var parts = new[]
        {
            Vehicle.ModelYear?.ToString(),
            Vehicle.Make,
            Vehicle.Model
        }
        .Where(x => !string.IsNullOrWhiteSpace(x));

        var title = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(title) ? "Unnamed Vehicle" : title;
    }

    private Task HandleEditAsync()
    {
        return OnEdit.HasDelegate
            ? OnEdit.InvokeAsync(Vehicle.Id)
            : Task.CompletedTask;
    }

    private Task HandleDeleteAsync()
    {
        return OnDelete.HasDelegate
            ? OnDelete.InvokeAsync(Vehicle.Id)
            : Task.CompletedTask;
    }

    private Task HandleMakePrimaryAsync()
    {
        return OnMakePrimary.HasDelegate
            ? OnMakePrimary.InvokeAsync(Vehicle.Id)
            : Task.CompletedTask;
    }
}