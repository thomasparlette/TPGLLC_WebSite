@using TPGLLC.Data.Entities
@using System.Linq

<article class="portal-card-link" @key="Item.Id">
    <div class="portal-card-icon">@GetVehicleIcon(Item)</div>

    <h3>@GetVehicleTitle(Item)</h3>
    <p>@GetVehicleDetails(Item)</p>

    @if (Item.IsPrimary)
    {
        <div class="portal-chip">Primary</div>
    }

    <div class="portal-actions" style="margin-top:1rem;">
        <button type="button" class="portal-action-button" @onclick="EditAsync">Edit</button>

        <button type="button"
                class="portal-action-button"
                @onclick="MakePrimaryAsync"
                disabled="@Item.IsPrimary">
            Make Primary
        </button>

        <button type="button" class="portal-action-button" @onclick="DeleteAsync">Delete</button>
    </div>
</article>

@code {
    [Parameter, EditorRequired] public CustomerVehicle Item { get; set; } = default!;
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnMakePrimary { get; set; }

    private Task EditAsync() => OnEdit.InvokeAsync(Item.Id);
    private Task DeleteAsync() => OnDelete.InvokeAsync(Item.Id);
    private Task MakePrimaryAsync() => OnMakePrimary.InvokeAsync(Item.Id);

    private static string GetVehicleTitle(CustomerVehicle vehicle)
    {
        var parts = new[]
        {
            vehicle.ModelYear?.ToString(),
            vehicle.Make,
            vehicle.Model
        }
        .Where(x => !string.IsNullOrWhiteSpace(x));

        var title = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(title) ? "Unnamed Vehicle" : title;
    }

    private static string GetVehicleDetails(CustomerVehicle vehicle)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(vehicle.Nickname))
        {
            parts.Add(vehicle.Nickname);
        }

        if (vehicle.Mileage.HasValue)
        {
            parts.Add($"{vehicle.Mileage.Value:N0} mi");
        }

        if (!string.IsNullOrWhiteSpace(vehicle.Vin))
        {
            parts.Add($"VIN {vehicle.Vin}");
        }

        return parts.Count == 0 ? "No additional details" : string.Join(" · ", parts);
    }

    private static string GetVehicleIcon(CustomerVehicle vehicle)
    {
        return vehicle.Make?.ToLowerInvariant() switch
        {
            "ford" => "🚙",
            "chevrolet" => "🚙",
            "gmc" => "🚙",
            "toyota" => "🚗",
            "honda" => "🚗",
            "acura" => "🚗",
            "harley-davidson" => "🏍️",
            _ => "🚘"
        };
    }
}