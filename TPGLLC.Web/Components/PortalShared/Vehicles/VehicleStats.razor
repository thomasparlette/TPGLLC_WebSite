<div class="portal-stats">
    <div class="portal-stat">
        <div class="portal-stat-value">@VehicleCount</div>
        <div class="portal-stat-label">Vehicles</div>
    </div>

    <div class="portal-stat">
        <div class="portal-stat-value">@PrimaryVehicleCount</div>
        <div class="portal-stat-label">Primary Vehicles</div>
    </div>
</div>

@code {
    [Parameter] public int VehicleCount { get; set; }
    [Parameter] public int PrimaryVehicleCount { get; set; }
}