@using TPGLLC.Data.Entities

<section class="portal-section">
    <div class="portal-section-heading">
        <h2>Timeline</h2>
        <a href="#top">Top</a>
    </div>

    @if (Entries is null || Entries.Count == 0)
    {
        <div class="portal-activity">
            <div class="portal-activity-item">
                <div class="portal-activity-icon">🛠️</div>
                <div>No service history found for this customer.</div>
            </div>
        </div>
    }
    else
    {
        <div class="portal-activity">
            @foreach (var entry in Entries)
            {
                <div class="portal-activity-item">
                    <div class="portal-activity-icon">🛠️</div>
                    <div>
                        <div><strong>@entry.ServiceDate.ToString("MMM d, yyyy")</strong></div>
                        <div>@entry.VehicleName</div>
                        <div>@entry.Service</div>
                        @if (entry.Mileage.HasValue)
                        {
                            <div>Mileage in: @entry.Mileage.Value.ToString("N0")</div>
                        }
                        @if (entry.MileageOut.HasValue)
                        {
                            <div>Mileage out: @entry.MileageOut.Value.ToString("N0")</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.Technician))
                        {
                            <div>Technician: @entry.Technician</div>
                        }
                        <div class="portal-muted">@entry.Status</div>
                        @if (!string.IsNullOrWhiteSpace(entry.ApprovalStatus))
                        {
                            <div class="portal-muted">Appointment: @entry.ApprovalStatus</div>
                        }
                        @if (entry.Parts.Count > 0 || entry.LaborAmount.HasValue)
                        {
                            <div style="margin-top:0.5rem;">
                                @foreach (var part in entry.Parts.Where(x => x.IsApplied || x.IsApproved))
                                {
                                    <div>@part.Description — @((part.Quantity * (part.UnitPrice ?? 0m)).ToString("C"))</div>
                                }
                                @if (entry.LaborAmount.HasValue)
                                {
                                    <div>Labor — @entry.LaborAmount.Value.ToString("C")</div>
                                }
                                @if (entry.InvoiceAmount.HasValue)
                                {
                                    <strong>Final invoice — @entry.InvoiceAmount.Value.ToString("C")</strong>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.Notes))
                        {
                            <div style="margin-top:0.35rem;">@entry.Notes</div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter] public IReadOnlyList<ServiceHistoryEntry> Entries { get; set; } = Array.Empty<ServiceHistoryEntry>();
}
