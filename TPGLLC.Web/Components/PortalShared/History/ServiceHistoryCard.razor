@using TPGLLC.Data.Entities

<article class="portal-card-link history-workorder-card @GetStatusCssClass(Entry.Status)" style="cursor:default;">
    <div class="portal-card-icon">🛠️</div>

    <h3>@Entry.VehicleName</h3>
    <p>@Entry.Service</p>

    <div class="portal-primary-meta" style="margin-top:0.75rem;">
        <span>@Entry.ServiceDate.ToString("MMM d, yyyy")</span>
        <span class="history-workorder-status-pill @GetStatusCssClass(Entry.Status)">@GetStatusLabel(Entry.Status)</span>
        @if (!string.IsNullOrWhiteSpace(Entry.ApprovalStatus))
        {
            <span>Appointment: @Entry.ApprovalStatus</span>
        }
        @if (Entry.Mileage.HasValue)
        {
            <span>Mileage in: @Entry.Mileage.Value.ToString("N0")</span>
        }
        @if (Entry.MileageOut.HasValue)
        {
            <span>Mileage out: @Entry.MileageOut.Value.ToString("N0")</span>
        }
    </div>

    <div style="margin-top:0.75rem; display:flex; flex-wrap:wrap; gap:0.5rem;">
        @if (!string.IsNullOrWhiteSpace(Entry.WorkOrderNumber))
        {
            <span class="portal-chip">@Entry.WorkOrderNumber</span>
        }

        @if (Entry.EstimateAmount.HasValue)
        {
            <span class="portal-chip">Estimate @Entry.EstimateAmount.Value.ToString("C")</span>
        }

        @if (Entry.InvoiceAmount.HasValue)
        {
            <span class="portal-chip">Invoice @Entry.InvoiceAmount.Value.ToString("C")</span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Entry.Complaint))
    {
        <div style="margin-top:0.75rem; color:#6b7280;">
            Customer concern: @Entry.Complaint
        </div>
    }

    @if (IsActiveWorkOrder(Entry) && HasCustomerVisibleUpdate(Entry))
    {
        <div class="history-live-update">
            <div class="history-live-update-heading">
                <span class="history-live-update-indicator"></span>
                <strong>Latest repair update</strong>
            </div>

            @if (Entry.UpdatedUtc.HasValue)
            {
                <div class="history-live-update-time">Updated @Entry.UpdatedUtc.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</div>
            }

            @if (!string.IsNullOrWhiteSpace(Entry.Diagnosis))
            {
                <div><strong>Findings:</strong> @Entry.Diagnosis</div>
            }

            @if (!string.IsNullOrWhiteSpace(Entry.Notes))
            {
                <div><strong>Technician note:</strong> @Entry.Notes</div>
            }

            @if (Entry.MileageOut.HasValue)
            {
                <div><strong>Mileage out:</strong> @Entry.MileageOut.Value.ToString("N0")</div>
            }

            @if (Entry.Parts.Any(x => x.IsApplied))
            {
                <div><strong>Parts applied:</strong> @Entry.Parts.Count(x => x.IsApplied)</div>
            }
        </div>
    }

    @if (Entry.Parts.Count > 0 || Entry.LaborAmount.HasValue)
    {
        <div class="service-record-details">
            <div class="service-record-details-title">Service details</div>
            <div class="service-record-line service-record-line-header">
                <span>Part / labor</span><span>Qty</span><span>Amount</span><span>Status</span>
            </div>
            @foreach (var part in Entry.Parts.Where(x => x.IsApplied || x.IsApproved || x.IsCustomerDeclined))
            {
                <div class="service-record-line">
                    <span>@part.Description</span>
                    <span>@part.Quantity.ToString("0.##")</span>
                    <span>@((part.Quantity * (part.UnitPrice ?? 0m)).ToString("C"))</span>
                    <span>@(part.IsCustomerDeclined ? "Not approved" : part.IsApproved ? "Approved" : "Proposed")</span>
                </div>
            }
            @if (Entry.LaborAmount.HasValue)
            {
                <div class="service-record-line">
                    <span>Labor</span><span>—</span><span>@Entry.LaborAmount.Value.ToString("C")</span><span>Service</span>
                </div>
            }
            @if (Entry.EstimateAmount.HasValue)
            {
                <div class="service-record-total"><span>Estimate</span><strong>@Entry.EstimateAmount.Value.ToString("C")</strong></div>
            }
            @if (Entry.InvoiceAmount.HasValue)
            {
                <div class="service-record-total"><span>Final invoice</span><strong>@Entry.InvoiceAmount.Value.ToString("C")</strong></div>
            }
        </div>
    }

    @if (CanApprove)
    {
        <div class="customer-approval-panel">
            <strong>Customer approval required</strong>
            <p>Approve or decline each proposed part, or choose an action for all work proposed.</p>
            @foreach (var part in Entry.Parts.Where(x => x.IsApplied && !x.IsApproved && !x.IsCustomerDeclined))
            {
                <div class="customer-approval-item">
                    <span>@part.Description</span>
                    <button type="button" class="portal-action-button portal-action-button-secondary"
                            @onclick="() => OnApprovePart.InvokeAsync(part.Id)">
                        Approve
                    </button>
                    <button type="button" class="portal-danger-button"
                            @onclick="() => OnDeclinePart.InvokeAsync(part.Id)">
                        Do not approve
                    </button>
                </div>
            }
            <div class="customer-approval-item customer-approval-item-complete">
                <span>All work proposed</span>
                <button type="button" class="portal-action-button" @onclick="() => OnApproveWorkOrder.InvokeAsync(Entry.Id)">
                    Approve all work proposed
                </button>
                <button type="button" class="portal-danger-button" @onclick="() => OnDeclineWorkOrder.InvokeAsync(Entry.Id)">
                    Do not approve all work proposed
                </button>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Entry.Technician))
    {
        <div style="margin-top:0.75rem; color:#6b7280;">
            Technician: @Entry.Technician
        </div>
    }

    @if (!IsActiveWorkOrder(Entry) && (!string.IsNullOrWhiteSpace(Entry.Diagnosis) || !string.IsNullOrWhiteSpace(Entry.Notes)))
    {
        <div class="history-completed-summary">
            @if (!string.IsNullOrWhiteSpace(Entry.Diagnosis))
            {
                <div><strong>Diagnosis:</strong> @Entry.Diagnosis</div>
            }
            @if (!string.IsNullOrWhiteSpace(Entry.Notes))
            {
                <div><strong>Notes:</strong> @Entry.Notes</div>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public ServiceHistoryEntry Entry { get; set; } = default!;
    [Parameter] public bool CanApprove { get; set; }
    [Parameter] public EventCallback<Guid> OnApprovePart { get; set; }
    [Parameter] public EventCallback<Guid> OnDeclinePart { get; set; }
    [Parameter] public EventCallback<Guid> OnApproveWorkOrder { get; set; }
    [Parameter] public EventCallback<Guid> OnDeclineWorkOrder { get; set; }

    private static bool HasCustomerVisibleUpdate(ServiceHistoryEntry entry) =>
        entry.UpdatedUtc.HasValue
        || !string.IsNullOrWhiteSpace(entry.Diagnosis)
        || !string.IsNullOrWhiteSpace(entry.Notes)
        || entry.MileageOut.HasValue
        || entry.Parts.Any(x => x.IsApplied);

    private static bool IsActiveWorkOrder(ServiceHistoryEntry entry) =>
        !string.Equals(entry.Status, "Completed", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Status, "Invoiced", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Status, "Closed", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Status, "Cancelled", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(entry.Status, "Declined", StringComparison.OrdinalIgnoreCase);

    private static string GetStatusLabel(string? status) =>
        string.IsNullOrWhiteSpace(status) ? "Requested" : status;

    private static string GetStatusCssClass(string? status)
    {
        if (string.Equals(status, "In Progress", StringComparison.OrdinalIgnoreCase))
        {
            return "history-status-in-progress";
        }

        if (string.Equals(status, "Waiting on Customer Approval", StringComparison.OrdinalIgnoreCase))
        {
            return "history-status-waiting";
        }

        if (string.Equals(status, "Completed", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Invoiced", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Closed", StringComparison.OrdinalIgnoreCase))
        {
            return "history-status-completed";
        }

        if (string.Equals(status, "Cancelled", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Declined", StringComparison.OrdinalIgnoreCase))
        {
            return "history-status-cancelled";
        }

        if (string.Equals(status, "Quoted", StringComparison.OrdinalIgnoreCase)
            || string.Equals(status, "Approved", StringComparison.OrdinalIgnoreCase))
        {
            return "history-status-approved";
        }

        return "history-status-requested";
    }
}
