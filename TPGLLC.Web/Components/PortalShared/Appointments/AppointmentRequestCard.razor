@using System.Linq
@using TPGLLC.Data.Entities

<article class="portal-card-link" style="cursor:default;">
    <div class="portal-card-icon">📅</div>

    <h3>@Request.ServiceNeeded</h3>
    <p>@GetVehicleSummary()</p>

    <div class="portal-primary-meta" style="margin-top:0.75rem;">
        <span>@FormatAppointmentRequest()</span>
        <span>@Request.Status</span>
    </div>

    @if (!string.IsNullOrWhiteSpace(Request.Message))
    {
        <p style="margin-top:0.9rem;">@Request.Message</p>
    }

    <div style="margin-top:0.9rem; color:#6b7280; font-size:0.9rem;">
        Submitted @Request.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public AppointmentRequest Request { get; set; } = default!;

    private string GetVehicleSummary()
    {
        var parts = new[]
        {
            Request.VehicleYear,
            Request.VehicleMake,
            Request.VehicleModel
        }
        .Where(x => !string.IsNullOrWhiteSpace(x));

        var summary = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(summary) ? "No vehicle selected" : summary;
    }

    private string FormatAppointmentRequest()
    {
        var when = string.Join(" ", new[]
        {
            Request.PreferredDate,
            Request.PreferredTime
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

        return string.IsNullOrWhiteSpace(when)
            ? "No preferred date/time provided"
            : when;
    }
}