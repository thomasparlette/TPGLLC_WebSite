@using System.Linq
@using TPGLLC.Data.Entities

<article class="portal-card-link" style="cursor:default;">
    <div class="portal-card-icon">📅</div>

    <h3>@Request.ServiceNeeded</h3>
    <p>@GetVehicleSummary()</p>

    @if (!string.IsNullOrWhiteSpace(GetVehicleDetailsSummary()))
    {
        <div class="portal-muted" style="margin-top:0.5rem;">@GetVehicleDetailsSummary()</div>
    }

    <div class="portal-primary-meta" style="margin-top:0.75rem;">
        <span>@FormatAppointmentRequest()</span>
        @if (!string.IsNullOrWhiteSpace(Request.Status))
        {
            <span>@FormatStatus(Request.Status)</span>
        }
    </div>

    @if (HasPendingReschedule)
    {
        <div style="margin-top:1rem; padding:1rem; border:1px solid #dbe3f0; border-radius:12px; background:#f7faff;">
            <div style="font-weight:700; color:#0b2a59;">A new appointment time has been proposed</div>
            <div style="margin-top:0.35rem;">@FormatProposedAppointment()</div>

            @if (!string.IsNullOrWhiteSpace(Request.AdvisorMessage))
            {
                <div class="portal-muted" style="margin-top:0.5rem;">@Request.AdvisorMessage</div>
            }

            <div class="portal-actions" style="margin-top:0.85rem;">
                @if (OnApproveReschedule.HasDelegate)
                {
                    <button type="button"
                            class="portal-action-button"
                            @onclick="HandleApproveRescheduleAsync">
                        Approve
                    </button>
                }

                @if (OnDeclineReschedule.HasDelegate)
                {
                    <button type="button"
                            class="portal-action-button"
                            @onclick="HandleDeclineRescheduleAsync">
                        Decline
                    </button>
                }
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Request.Message))
    {
        <p style="margin-top:0.9rem;">@Request.Message</p>
    }

    @if (CanShowActions)
    {
        <div class="portal-actions" style="margin-top:0.9rem;">
            @if (CanReschedule)
            {
                <button type="button"
                        class="portal-action-button"
                        @onclick="HandleRescheduleAsync">
                    Reschedule
                </button>
            }

            @if (CanCancel)
            {
                <button type="button"
                        class="portal-danger-button"
                        @onclick="HandleCancelAsync">
                    Cancel
                </button>
            }
            else if (!Request.CanCustomerCancel)
            {
                <span class="portal-muted">Appointment changes are unavailable after the work order is quoted.</span>
            }
        </div>
    }

    <div style="margin-top:0.9rem; color:#6b7280; font-size:0.9rem;">
        Submitted @Request.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy")
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public AppointmentRequest Request { get; set; } = default!;

    [Parameter]
    public bool ShowActions { get; set; }

    [Parameter]
    public EventCallback<AppointmentRequest> OnReschedule { get; set; }

    [Parameter]
    public EventCallback<AppointmentRequest> OnCancel { get; set; }

    [Parameter]
    public EventCallback<AppointmentRequest> OnApproveReschedule { get; set; }

    [Parameter]
    public EventCallback<AppointmentRequest> OnDeclineReschedule { get; set; }

    private bool HasPendingReschedule =>
        (Request.Status.Equals("RescheduleProposed", StringComparison.OrdinalIgnoreCase)
        || Request.Status.Equals("AwaitingCustomerApproval", StringComparison.OrdinalIgnoreCase))
        && !string.IsNullOrWhiteSpace(Request.ProposedDate)
        && !string.IsNullOrWhiteSpace(Request.ProposedTime);

    private bool CanShowActions => ShowActions && !IsClosedStatus(Request.Status);

    private bool CanReschedule => CanShowActions && Request.CanCustomerCancel;

    private bool CanCancel => CanShowActions && Request.CanCustomerCancel;

    private Task HandleRescheduleAsync()
    {
        if (!OnReschedule.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return OnReschedule.InvokeAsync(Request);
    }

    private Task HandleApproveRescheduleAsync()
    {
        if (!OnApproveReschedule.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return OnApproveReschedule.InvokeAsync(Request);
    }

    private Task HandleDeclineRescheduleAsync()
    {
        if (!OnDeclineReschedule.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return OnDeclineReschedule.InvokeAsync(Request);
    }

    private Task HandleCancelAsync()
    {
        if (!OnCancel.HasDelegate)
        {
            return Task.CompletedTask;
        }

        return OnCancel.InvokeAsync(Request);
    }

    private string GetVehicleSummary()
    {
        var parts = new[]
        {
            Request.VehicleYear,
            Request.VehicleMake,
            Request.VehicleModel
        }
        .Where(x => !string.IsNullOrWhiteSpace(x));

        var summary = string.Join(" ", parts);
        return string.IsNullOrWhiteSpace(summary) ? "No vehicle selected" : summary;
    }

    private string GetVehicleDetailsSummary()
    {
        var details = new[]
        {
            FormatVehicleDetail("Submodel", Request.VehicleSubmodel),
            FormatVehicleDetail("Body", Request.BodyStyle),
            FormatVehicleDetail("Engine", Request.EngineFuel),
            FormatVehicleDetail("Transmission", Request.Transmission),
            FormatVehicleDetail("Drive", Request.DriveType),
            FormatVehicleDetail("Brake", Request.Brake),
            FormatVehicleDetail("GVW", Request.Gvw),
            FormatVehicleDetail("VIN", Request.Vin),
            FormatVehicleDetail("Plate", Request.LicensePlate)
        };

        return string.Join(" · ", details.Where(x => x is not null));
    }

    private static string? FormatVehicleDetail(string label, string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : $"{label}: {value.Trim()}";

    private string FormatAppointmentRequest()
    {
        var when = string.Join(" ", new[]
        {
            Request.PreferredDate,
            Request.PreferredTime
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

        return string.IsNullOrWhiteSpace(when)
            ? "No preferred date/time provided"
            : when;
    }

    private string FormatProposedAppointment()
    {
        var when = string.Join(" ", new[]
        {
            Request.ProposedDate,
            Request.ProposedTime
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

        
        return string.IsNullOrWhiteSpace(when)
            ? "No proposed date/time provided"
            : when;
    }

    private static string FormatStatus(string status)
    {
        if (status.Equals("RescheduleProposed", StringComparison.OrdinalIgnoreCase)
            || status.Equals("AwaitingCustomerApproval", StringComparison.OrdinalIgnoreCase))
        {
            return "Awaiting Customer Approval";
        }

        return status;
    }

    private static bool IsClosedStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        return status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Declined", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Closed", StringComparison.OrdinalIgnoreCase);
    }
}
