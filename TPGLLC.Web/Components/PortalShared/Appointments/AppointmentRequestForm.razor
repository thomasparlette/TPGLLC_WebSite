@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq

<div class="auth-card" id="appointment-form" style="margin-left:0; margin-right:0; width:100%;">
    <EditForm Model="Form" OnValidSubmit="HandleSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="vehicle-grid">
            <div class="form-field">
                <label>Model Year</label>
                <InputSelect class="input"
                             @bind-Value="Form.VehicleYear"
                             @bind-Value:after="HandleYearChangedAsync">
                    <option value="">Select year</option>
                    @foreach (var year in Years)
                    {
                        <option value="@year">@year</option>
                    }
                </InputSelect>
            </div>

            <div class="form-field">
                <label>Make</label>
                <InputSelect class="input"
                             @bind-Value="Form.VehicleMake"
                             @bind-Value:after="HandleMakeChangedAsync"
                             disabled="@(!Makes.Any())">
                    <option value="">Select make</option>
                    @foreach (var make in Makes)
                    {
                        <option value="@make">@make</option>
                    }
                </InputSelect>
            </div>

            <div class="form-field">
                <label>Model</label>
                <InputSelect class="input"
                             @bind-Value="Form.VehicleModel"
                             @bind-Value:after="HandleModelChangedAsync"
                             disabled="@(!Models.Any())">
                    <option value="">Select model</option>
                    @foreach (var model in Models)
                    {
                        <option value="@model">@model</option>
                    }
                </InputSelect>
            </div>

            <div class="form-field">
                <label>Vehicle Type</label>
                <InputSelect class="input" @bind-Value="Form.VehicleType">
                    <option value="Automotive">Automotive</option>
                    <option value="Motorcycle">Motorcycle</option>
                    <option value="Other">Other</option>
                </InputSelect>
            </div>

            <div class="form-field">
                <label>VIN</label>
                <InputText class="input" @bind-Value="Form.Vin" maxlength="17" />
            </div>

            <div class="form-field">
                <label>Mileage</label>
                <InputText class="input" @bind-Value="Form.Mileage" placeholder="e.g. 52,800" />
            </div>

            <div class="form-field full">
                <label>Service Needed</label>
                <InputText class="input" @bind-Value="Form.ServiceNeeded" placeholder="Oil change, brakes, diagnostics, etc." />
            </div>

            <div class="form-field">
                <label>Preferred Date</label>
                <InputText class="input" type="date" @bind-Value="Form.PreferredDate" />
            </div>

            <div class="form-field">
                <label>Preferred Time</label>
                <InputText class="input" type="time" @bind-Value="Form.PreferredTime" />
            </div>

            <div class="form-field">
                <label>Name</label>
                <InputText class="input" @bind-Value="Form.Name" />
            </div>

            <div class="form-field">
                <label>Email</label>
                <InputText class="input" type="email" @bind-Value="Form.Email" />
            </div>

            <div class="form-field">
                <label>Phone</label>
                <InputText class="input" @bind-Value="Form.Phone" />
            </div>

            <div class="form-field full">
                <label>Message</label>
                <InputTextArea class="input textarea" @bind-Value="Form.Message" />
            </div>
        </div>

        <div class="portal-actions" style="margin-top:1.25rem;">
            <button type="submit" class="portal-action-button">Submit Request</button>
            <button type="button" class="portal-action-button" @onclick="HandleCancelAsync">Reset</button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired] public AppointmentRequestFormModel Form { get; set; } = default!;
    [Parameter] public IReadOnlyList<int> Years { get; set; } = Array.Empty<int>();
    [Parameter] public IReadOnlyList<string> Makes { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> Models { get; set; } = Array.Empty<string>();

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnYearChanged { get; set; }
    [Parameter] public EventCallback OnMakeChanged { get; set; }

    private async Task HandleSubmitAsync()
    {
        if (OnSave.HasDelegate)
        {
            await OnSave.InvokeAsync();
        }
    }

    private async Task HandleCancelAsync()
    {
        if (OnCancel.HasDelegate)
        {
            await OnCancel.InvokeAsync();
        }
    }

    private async Task HandleYearChangedAsync()
    {
        if (OnYearChanged.HasDelegate)
        {
            await OnYearChanged.InvokeAsync();
        }
    }

    private async Task HandleMakeChangedAsync()
    {
        if (OnMakeChanged.HasDelegate)
        {
            await OnMakeChanged.InvokeAsync();
        }
    }

    private Task HandleModelChangedAsync() => Task.CompletedTask;
}