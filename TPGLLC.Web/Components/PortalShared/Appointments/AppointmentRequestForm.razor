@attribute [Authorize]

@using Microsoft.EntityFrameworkCore
@using TPGLLC.Data
@using TPGLLC.Data.Entities
@using TPGLLC.Services.Vehicles
@using TPGLLC.Web.Services.Customers
@using TPGLLC.Web.Components.PortalShared.Appointments

@inject TPGLLCDbContext Db
@inject ICurrentCustomerAccessor CurrentCustomerAccessor
@inject ICustomerProfileService CustomerProfileService
@inject IVehicleCatalogService VehicleCatalog

<PageTitle>Appointments</PageTitle>

<section class="portal-dashboard">
    <AppointmentPageHeader />

    <AppointmentStats TotalRequests="@_requests.Count.ToString()"
                      OpenRequests="@_openRequests.Count.ToString()"
                      LatestRequestDate="@GetLatestRequestDate()"
                      LatestRequestStatus="@GetLatestRequestStatus()" />

    <div class="portal-section">
        <h2>Quick Actions</h2>

        <div class="portal-actions portal-actions-wrap">
            <a class="portal-action-button" href="/portal/vehicles">Choose Vehicle</a>
            <a class="portal-action-button" href="/portal/history">View History</a>
            <a class="portal-action-button" href="/portal/dashboard">Back to Dashboard</a>
        </div>
    </div>

    <AppointmentRequestsList Requests="@_requests" />

    <AppointmentRequestForm Form="@_form"
                            Years="@_years"
                            Makes="@_makes"
                            Models="@_models"
                            OnSave="SaveRequestAsync"
                            OnCancel="ResetForm"
                            OnYearChanged="OnVehicleYearChanged"
                            OnMakeChanged="OnVehicleMakeChanged" />
</section>

@code {
    private CustomerProfile? _profile;
    private List<AppointmentRequest> _requests = [];
    private List<AppointmentRequest> _openRequests = [];

    private List<int> _years = [];
    private List<string> _makes = [];
    private List<string> _models = [];

    private AppointmentRequestFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCatalogAsync();
        await LoadAsync();
    }

    private async Task LoadCatalogAsync()
    {
        _years = (await VehicleCatalog.GetYearsAsync())
            .Distinct()
            .OrderByDescending(x => x)
            .ToList();

        if (_years.Count == 0)
        {
            _years = Enumerable.Range(1995, DateTime.UtcNow.Year - 1995 + 1)
                .Reverse()
                .ToList();
        }
    }

    private async Task LoadAsync()
    {
        Db.ChangeTracker.Clear();

        _profile = null;
        _requests = [];
        _openRequests = [];
        _makes = [];
        _models = [];

        var current = CurrentCustomerAccessor.GetCurrentCustomer();
        if (!current.IsAuthenticated)
        {
            return;
        }

        _profile = await Db.CustomerProfiles
            .AsNoTracking()
            .FirstOrDefaultAsync(x => x.ApplicationUserId == current.UserId);

        if (!string.IsNullOrWhiteSpace(current.Email))
        {
            _requests = await Db.AppointmentRequests
                .AsNoTracking()
                .Where(x => x.Email == current.Email)
                .OrderByDescending(x => x.SubmittedAtUtc)
                .ToListAsync();
        }

        _openRequests = _requests
            .Where(x => !IsClosedStatus(x.Status))
            .ToList();

        ResetForm(current);
    }

    private void ResetForm(CurrentCustomer? current = null)
    {
        current ??= CurrentCustomerAccessor.GetCurrentCustomer();

        var displayName = string.Join(" ", new[]
        {
            _profile?.FirstName,
            _profile?.LastName
        }.Where(x => !string.IsNullOrWhiteSpace(x)));

        _form = new AppointmentRequestFormModel
        {
            Name = string.IsNullOrWhiteSpace(displayName) ? "Customer" : displayName.Trim(),
            Email = string.IsNullOrWhiteSpace(current.Email) ? string.Empty : current.Email.Trim(),
            Phone = string.IsNullOrWhiteSpace(_profile?.Phone) ? string.Empty : _profile!.Phone!.Trim(),
            VehicleType = "Automotive",
            PreferredDate = string.Empty,
            PreferredTime = string.Empty
        };
    }

    private async Task SaveRequestAsync()
    {
        var current = CurrentCustomerAccessor.GetCurrentCustomer();
        if (!current.IsAuthenticated)
        {
            return;
        }

        if (!TryParseYear(_form.VehicleYear, out var modelYear))
        {
            await LoadAsync();
            return;
        }

        if (!TryParseMileage(_form.Mileage, out var mileage))
        {
            return;
        }

        var request = new AppointmentRequest
        {
            Name = _form.Name.Trim(),
            Email = _form.Email.Trim(),
            Phone = _form.Phone.Trim(),
            Company = string.IsNullOrWhiteSpace(_profile?.Company) ? null : _profile!.Company!.Trim(),
            VehicleType = string.IsNullOrWhiteSpace(_form.VehicleType) ? "Automotive" : _form.VehicleType.Trim(),
            VehicleYear = string.IsNullOrWhiteSpace(_form.VehicleYear) ? null : _form.VehicleYear.Trim(),
            VehicleMake = string.IsNullOrWhiteSpace(_form.VehicleMake) ? null : _form.VehicleMake.Trim(),
            VehicleModel = string.IsNullOrWhiteSpace(_form.VehicleModel) ? null : _form.VehicleModel.Trim(),
            Vin = string.IsNullOrWhiteSpace(_form.Vin) ? null : _form.Vin.Trim(),
            Mileage = string.IsNullOrWhiteSpace(_form.Mileage) ? null : _form.Mileage.Trim(),
            PreferredDate = _form.PreferredDate.Trim(),
            PreferredTime = _form.PreferredTime.Trim(),
            ServiceNeeded = _form.ServiceNeeded.Trim(),
            Status = "Requested",
            Message = string.IsNullOrWhiteSpace(_form.Message) ? null : _form.Message.Trim(),
            SubmittedAtUtc = DateTimeOffset.UtcNow
        };

        Db.AppointmentRequests.Add(request);
        await Db.SaveChangesAsync();

        await LoadAsync();
    }

    private async Task OnVehicleYearChanged()
    {
        _form.VehicleMake = string.Empty;
        _form.VehicleModel = string.Empty;
        _makes = [];
        _models = [];

        await RefreshMakesAsync();
    }

    private async Task OnVehicleMakeChanged()
    {
        _form.VehicleModel = string.Empty;
        _models = [];

        await RefreshModelsAsync();
    }

    private async Task RefreshMakesAsync()
    {
        _makes = [];

        if (TryParseYear(_form.VehicleYear, out var year) && year.HasValue)
        {
            _makes = (await VehicleCatalog.GetMakesAsync(year.Value))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            EnsureSelectedValue(_makes, _form.VehicleMake);
        }
    }

    private async Task RefreshModelsAsync()
    {
        _models = [];

        if (TryParseYear(_form.VehicleYear, out var year) &&
            year.HasValue &&
            !string.IsNullOrWhiteSpace(_form.VehicleMake))
        {
            _models = (await VehicleCatalog.GetModelsAsync(year.Value, _form.VehicleMake.Trim()))
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(x => x)
                .ToList();

            EnsureSelectedValue(_models, _form.VehicleModel);
        }
    }

    private static void EnsureSelectedValue(List<string> values, string? selectedValue)
    {
        if (string.IsNullOrWhiteSpace(selectedValue))
        {
            return;
        }

        if (!values.Contains(selectedValue, StringComparer.OrdinalIgnoreCase))
        {
            values.Insert(0, selectedValue);
        }
    }

    private static bool TryParseYear(string? value, out int? year)
    {
        year = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        if (int.TryParse(value.Trim(), out var parsed) && parsed is >= 1900 and <= 3000)
        {
            year = parsed;
            return true;
        }

        return false;
    }

    private static bool TryParseMileage(string? value, out int? mileage)
    {
        mileage = null;

        if (string.IsNullOrWhiteSpace(value))
        {
            return true;
        }

        var normalized = value.Replace(",", "", StringComparison.Ordinal).Trim();
        if (int.TryParse(normalized, out var parsed) && parsed >= 0)
        {
            mileage = parsed;
            return true;
        }

        return false;
    }

    private static bool IsClosedStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
        {
            return false;
        }

        return status.Equals("Completed", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Cancelled", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Declined", StringComparison.OrdinalIgnoreCase)
            || status.Equals("Closed", StringComparison.OrdinalIgnoreCase);
    }

    private static bool IsOpenStatus(string? status) => !IsClosedStatus(status);

    private string GetLatestRequestDate()
    {
        var latest = _requests.FirstOrDefault();
        return latest is null
            ? "None"
            : latest.SubmittedAtUtc.ToLocalTime().ToString("MMM d, yyyy");
    }

    private string GetLatestRequestStatus()
    {
        var latest = _requests.FirstOrDefault();
        return latest?.Status ?? "None";
    }
}