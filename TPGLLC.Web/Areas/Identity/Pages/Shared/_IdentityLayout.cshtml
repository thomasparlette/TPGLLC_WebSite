@using Microsoft.AspNetCore.Identity
@using TPGLLC.Shared.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IHttpContextAccessor HttpContextAccessor
@{
    var title = ViewData["Title"]?.ToString() ?? "Tom Parlette Garage LLC";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>@title</title>

    <link rel="stylesheet" href="/css/variables.css" />
    <link rel="stylesheet" href="/css/layout.css" />
    <link rel="stylesheet" href="/css/components.css" />
    <link rel="stylesheet" href="/css/home.css" />
    <link rel="stylesheet" href="/css/animations.css" />
    <link rel="stylesheet" href="/css/mobile.css" />
</head>
<body>
    <div class="app-shell">
        <header class="site-header">
            <a class="brand" href="/">
                <img class="brand-logo" src="/images/logo.jpeg" alt="Tom Parlette Garage LLC logo" />
                <div class="brand-copy">
                    <span class="brand-name">Tom Parlette Garage LLC</span>
                    <span class="brand-tagline">Built on Trust. Driven by Results.</span>
                </div>
            </a>

            <a class="btn btn-primary header-cta" href="/">Back to Home</a>
        </header>

        <main class="page-content">
            @RenderBody()
        </main>

        <footer class="site-footer">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand">Tom Parlette Garage LLC</div>
                    <p>Complete automotive and motorcycle repair with honest communication and dependable work.</p>
                </div>

                <div>
                    <div class="footer-heading">Contact</div>
                    <p><a href="tel:+17653463354">(765) 346-3354</a></p>
                    <p><a href="mailto:tomparlette@tomparlettegarage.org">tomparlette@tomparlettegarage.org</a></p>
                </div>

                <div>
                    <div class="footer-heading">Quick Links</div>
                    <p><a href="/">Home</a></p>
                    <p><a href="/#appointment">Request Appointment</a></p>
                    <p><a href="/account">Customer Account</a></p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; 2026 Tom Parlette Garage LLC</span>
                <span>Honest service • Quality work • Trusted locally</span>
            </div>
        </footer>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>