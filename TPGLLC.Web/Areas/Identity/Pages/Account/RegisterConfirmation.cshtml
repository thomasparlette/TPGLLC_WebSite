@page
@model Microsoft.AspNetCore.Mvc.RazorPages.PageModel
@{
    ViewData["Title"] = "Registration confirmation";
}

<div class="auth-card">
    <h1>Check your email</h1>
    <p>We sent a confirmation link to the email address you used to register.</p>
    <p>After you confirm your email, you can sign in to the portal.</p>
    <a class="primary-button" href="/Identity/Account/Login">Go to sign in</a>
</div>
