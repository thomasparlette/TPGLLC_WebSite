@page
@model TPGLLC.Web.Areas.Identity.Pages.Account.Manage.ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
}

<div class="container" style="max-width: 700px; padding: 2rem 1rem;">
    <h1>Change password</h1>
    <p>Update the password for your signed-in account.</p>

    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
    {
        <div class="portal-notice success" style="margin: 1rem 0;">@Model.StatusMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="portal-notice danger" style="margin: 1rem 0;">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="portal-form-grid">
            <div class="form-field full">
                <label asp-for="Input.OldPassword"></label>
                <input asp-for="Input.OldPassword" class="input" autocomplete="current-password" />
                <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
            </div>

            <div class="form-field full">
                <label asp-for="Input.NewPassword"></label>
                <input asp-for="Input.NewPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>

            <div class="form-field full">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="input" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="portal-actions" style="margin-top: 1.25rem;">
            <button type="submit" class="portal-action-button">Update Password</button>
            <a class="portal-action-button" href="/portal/account">Back to Account</a>
        </div>
    </form>
</div>
