@page
@model TPGLLC.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}

<div class="auth-card">
    <h1>Sign in</h1>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="auth-alert">@Model.ErrorMessage</div>
    }

    <form method="post" class="auth-form">
        <input type="hidden" asp-for="Input.ReturnUrl" />

        <div class="form-field">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" />
            <span asp-validation-for="Input.Email"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" type="password" />
            <span asp-validation-for="Input.Password"></span>
        </div>

        <div class="form-check">
            <input asp-for="Input.RememberMe" />
            <label asp-for="Input.RememberMe"></label>
        </div>

        <button type="submit" class="primary-button">Sign in</button>
    </form>

    <div class="auth-links">
        <a href="/Identity/Account/ForgotPassword">Forgot your password?</a>
        <a href="/Identity/Account/Register">Create an account</a>
    </div>

    @if (Model.GoogleEnabled || Model.MicrosoftEnabled)
    {
        <div class="auth-divider">or continue with</div>
        <div class="external-login-grid">
            @if (Model.GoogleEnabled)
            {
                <form method="post" asp-page-handler="ExternalLogin" class="external-login-form">
                    <input type="hidden" name="provider" value="Google" />
                    <input type="hidden" name="returnUrl" value="@Model.Input.ReturnUrl" />
                    <button type="submit" class="secondary-button">Google</button>
                </form>
            }

            @if (Model.MicrosoftEnabled)
            {
                <form method="post" asp-page-handler="ExternalLogin" class="external-login-form">
                    <input type="hidden" name="provider" value="Microsoft" />
                    <input type="hidden" name="returnUrl" value="@Model.Input.ReturnUrl" />
                    <button type="submit" class="secondary-button">Microsoft</button>
                </form>
            }
        </div>
    }
</div>
