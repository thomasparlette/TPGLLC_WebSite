@page
@model TPGLLC.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
    <div class="auth-card">
        <h1>Log in</h1>
        <p>Use your email or continue with Microsoft or Google.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="form-status warning">@Model.ErrorMessage</div>
        }

        <div class="external-login-row">
            @if (Model.ExternalLogins.Count > 0)
            {
                @foreach (var provider in Model.ExternalLogins)
                {
                    <form method="post" asp-page-handler="ExternalLogin" class="external-login-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="provider" value="@provider.Name" />
                        <input type="hidden" name="returnUrl" value="@Model.Input.ReturnUrl" />
                        <button class="btn btn-outline-primary full-width" type="submit">
                            Continue with @(string.IsNullOrWhiteSpace(provider.DisplayName) ? provider.Name : provider.DisplayName)
                        </button>
                    </form>
                }
            }
            else
            {
                <div class="form-status">External sign-in providers are not configured yet.</div>
            }
        </div>

        <div class="auth-divider">
            <span>or</span>
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-errors"></div>

            <div class="form-field full">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="input" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="validation-message"></span>
            </div>

            <div class="form-field full">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="input" type="password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="validation-message"></span>
            </div>

            <div class="form-field full checkbox-row">
                <input asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe">Remember me</label>
            </div>

            <input asp-for="Input.ReturnUrl" type="hidden" />

            <button class="btn btn-primary full-width" type="submit">Log in</button>
        </form>

        <p style="margin-top:1rem;">
            Need an account? <a href="/Identity/Account/Register">Register</a>
        </p>
    </div>
</div>
