@page
@model TPGLLC.Web.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="auth-page">
    <div class="auth-card">
        <h1>Log out</h1>
        <p>Are you sure you want to sign out?</p>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="/" />
            <button class="btn btn-primary full-width" type="submit">Log out</button>
        </form>

        <p style="margin-top:1rem;">
            <a href="/portal">Back to portal</a>
        </p>
    </div>
</div>
