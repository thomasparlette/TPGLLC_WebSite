@page
@model TPGLLC.Web.Areas.Identity.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Sign out";
}

<div class="auth-page">
    <div class="auth-card">
        <h2>Signing out...</h2>
        <p>Please wait while we securely end your session.</p>

        <form method="post">
            @Html.AntiForgeryToken()
            <button class="btn btn-primary full-width" type="submit">Sign out</button>
        </form>
    </div>
</div>