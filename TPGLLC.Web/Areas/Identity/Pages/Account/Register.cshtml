@page
@model TPGLLC.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="auth-card">
    <h1>Create account</h1>

    <p class="auth-note">We will send a verification email after you register.</p>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="auth-alert">@Model.ErrorMessage</div>
    }

    <form method="post" class="auth-form">
        <input type="hidden" asp-for="Input.ReturnUrl" />

        <div class="form-field">
            <label asp-for="Input.DisplayName"></label>
            <input asp-for="Input.DisplayName" />
            <span asp-validation-for="Input.DisplayName"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" />
            <span asp-validation-for="Input.Email"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" type="password" />
            <span asp-validation-for="Input.Password"></span>
        </div>

        <div class="form-field">
            <label asp-for="Input.ConfirmPassword"></label>
            <input asp-for="Input.ConfirmPassword" type="password" />
            <span asp-validation-for="Input.ConfirmPassword"></span>
        </div>

        <button type="submit" class="portal-action-button">Register</button>
    </form>
</div>
