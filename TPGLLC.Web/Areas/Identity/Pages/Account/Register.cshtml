@page
@model TPGLLC.Web.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="auth-page">
    <div class="auth-card">
        <h1>Create account</h1>
        <p>Register to track vehicles and appointments.</p>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="form-status warning">@Model.ErrorMessage</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-errors"></div>

            <div class="form-field full">
                <label asp-for="Input.DisplayName"></label>
                <input asp-for="Input.DisplayName" class="input" autocomplete="name" />
                <span asp-validation-for="Input.DisplayName" class="validation-message"></span>
            </div>

            <div class="form-field full">
                <label asp-for="Input.Email"></label>
                <input asp-for="Input.Email" class="input" autocomplete="email" />
                <span asp-validation-for="Input.Email" class="validation-message"></span>
            </div>

            <div class="form-field full">
                <label asp-for="Input.Password"></label>
                <input asp-for="Input.Password" class="input" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="validation-message"></span>
            </div>

            <div class="form-field full">
                <label asp-for="Input.ConfirmPassword"></label>
                <input asp-for="Input.ConfirmPassword" class="input" type="password" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="validation-message"></span>
            </div>

            <input asp-for="Input.ReturnUrl" type="hidden" />

            <button class="btn btn-primary full-width" type="submit">Create account</button>
        </form>

        <p style="margin-top:1rem;">
            Already have an account? <a href="/Identity/Account/Login">Log in</a>
        </p>
    </div>
</div>
